@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.Globalization

<div class="d-flex justify-content-center align-items-center gap-2">
    <Icon IconClass="@FAIcon.Globe" TextClass="text-muted" SizeClass="fs-5"/>
    <select class="form-select" @bind="Culture">
        <option value="en-US">@Resource.English</option>
        <option value="el-GR">@Resource.Greek</option>
    </select>
</div>

@code
{
    private CultureInfo Culture
    {
        get => CultureInfo.CurrentCulture;
        set
        {
            if (CultureInfo.CurrentCulture.Name != value.Name)
            {
                // Persist the choice in the browser and reload so the whole app re-renders
                // under the new culture (see Program.cs, which reads "BlazorCulture").
                _ = SetCultureAsync(value.Name);
            }
        }
    }

    private async Task SetCultureAsync(string cultureName)
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "BlazorCulture", cultureName);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
