@inject NavigationManager NavigationManager

@if (Patients.Any())
{
    <ul class="list-group">
        <Virtualize Items="Patients" Context="patient">
            <li class="list-group-item my-2 border rounded-pill clickable" @onclick="() => OnPatientClick(patient)">
                <div class="d-flex justify-content-between px-3">
                    <img class="rounded-circle" src="images/generic.jpg" alt="@patient.FullName" width="35" height="35" />
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">@Resource.Name</span>
                        <h6>@patient.FullName</h6>
                    </div>
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">@Resource.Email</span>
                        <h6>@patient.Email</h6>
                    </div>
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">@Resource.PhoneNumber</span>
                        <h6>@(!string.IsNullOrEmpty(patient.PhoneNumber) ? patient.PhoneNumber : Resource.NotAvailable)</h6>
                    </div>
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">@Resource.Created</span>
                        <h6>@DateTimeExtensions.ToFullDateTimeString(patient.CreatedAt)</h6>
                    </div>
                </div>
            </li>
        </Virtualize>
    </ul>
}
else
{
    <p>@string.Format(Resource.ThereAreNo, Resource.Patients)</p>
}


@code {
    [Parameter]
    public List<PatientResponse> Patients { get; set; } = new();

    private void OnPatientClick(PatientResponse patient)
    {
        //NavigationManager.NavigateTo(RoutingEndpoints.PATIENTS_PAGE);
        NavigationManager.NavigateTo($"{RoutingEndpoints.PATIENTS_PAGE}/edit/{patient.Id}");
    }
}
