@inherits ModalBase

<BeHealthyModal BodyClass="">
    <Header>
        <h5 class="modal-title">@Resource.MedicalRecord</h5>
        <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
    </Header>
    <Body>
        <EditForm Model="Allergy" FormName="AllergyForm" OnValidSubmit="HandleSave">

            <BeHealthyFormGroup Label="@Resource.Allergy" InputId="allergyname">

                <InputText id="allergyname" @bind-Value="Allergy.AllergyName" class="form-control" />
                <ValidationMessage For="() => Allergy.AllergyName" class="text-danger" />
            </BeHealthyFormGroup>

            <BeHealthyFormGroup Label="@Resource.Allergen" InputId="allergen">
                <InputText id="allergen" @bind-Value="Allergy.Allergen" class="form-control" />
                <ValidationMessage For="() => Allergy.Allergen" class="text-danger" />
            </BeHealthyFormGroup>

            <div class="d-flex flex-row justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="Close">
                    @Resource.Cancel
                </button>
                <button type="submit" class="btn btn-success rounded-pill px-4">
                    @Resource.Save
                </button>
            </div>
        </EditForm>
    </Body>
</BeHealthyModal>

@code {
    [Parameter] public AllergyDto Allergy { get; set; } = new();
    [Parameter] public EventCallback<AllergyDto> OnSave { get; set; }

    private async Task HandleSave()
    {
        if (OnSave.HasDelegate)
        {
            await OnSave.InvokeAsync(Allergy);
        }
        Close();
    }
}
