<div class="card my-3 shadow border">
    <div class="card-body">
        <img class="rounded-circle" src="images/generic.jpg" height="100"/>
        @if (!string.IsNullOrEmpty(FullName))
        {
            <div class="form-group">
                <label class="text-muted" for="fullName">Full Name</label>
                <h6 id="fullName">@FullName</h6>
            </div>
        }
        @if (!string.IsNullOrEmpty(Email))
        {
            <div class="form-group">
                <label class="text-muted" for="email">Email</label>
                <h6 class="" id="email">@Email</h6>
            </div>
        }
        @if (!string.IsNullOrEmpty(Specialty))
        {
            <div class="form-group">
                <label for="specialty">Specialty</label>
                <h6 class="" id="specialty">@Specialty</h6>
            </div>
        }
    </div>
    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center m-2">
        <button class="btn btn-outline-dark btn-sm w-25" @onclick="() => Edit.InvokeAsync(Id)">Edit</button>
        <button class="btn btn-danger btn-sm w-25" @onclick="() => Delete.InvokeAsync(Id)">Delete</button>
    </div>
</div>

@code {

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? FullName { get; set; }

    [Parameter]
    public string? Email { get; set; }

    [Parameter]
    public string? Specialty { get; set; }

    [Parameter]
    public EventCallback<string> Edit { get; set; }

    [Parameter]
    public EventCallback<string> Delete { get; set; }
}
