@using BeHealthy.Shared.Models.Dtos.Doctor
@using BeHealthy.Shared.Models.Dtos.Patient
@using BeHealthy.Shared.Models.Entities

<div class="modal" tabindex="-1" style="@(_show ? "display:block" : "display:none")">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(_isEdit ? "Edit Appointment" : "Create Appointment")</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                @if (Doctors is null || Patients is null)
                {
                    <p><em>Loading</em></p>
                }
                else
                {
                    <EditForm FormName="AppointmentForm" OnValidSubmit="HandleSaveClick" Model="_appointmentForCreationDto">
                        <DataAnnotationsValidator />
                        <div class="d-flex flex-column gap-2">

                            <div class="form-group">
                                <label for="patientIdSelect">Patient</label>
                                <InputSelect id="patientIdSelect" class="form-select" @bind-Value="_appointmentForCreationDto.PatientId">
                                    @foreach (var patient in Patients)
                                    {
                                        <option value="@patient.Id">@patient.FullName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _appointmentForCreationDto.PatientId)" />
                            </div>

                            <div class="form-group">
                                <label for="doctorIdSelect">Doctor</label>
                                <InputSelect id="doctorIdSelect" class="form-select" @bind-Value="_appointmentForCreationDto.DoctorId">
                                    @foreach (var doctor in Doctors)
                                    {
                                        <option value="@doctor.Id">@doctor.FullName</option>
                                    }
                                </InputSelect>

                                <ValidationMessage For="@(() => _appointmentForCreationDto.DoctorId)" />
                            </div>

                            <div class="form-group">
                                <label for="appointmentDate">Appointment Date</label>
                                <InputDate id="appointmentDate" class="form-control" @bind-Value="_appointmentForCreationDto.AppointmentDate" />
                                <ValidationMessage For="@(() => _appointmentForCreationDto.AppointmentDate)" />
                            </div>

                            <div class="form-group">
                                <label for="notes">Notes</label>
                                <InputTextArea id="notes" class="form-control" @bind-Value="_appointmentForCreationDto.Notes" style="resize: none;" />
                            </div>

                            <div class="d-flex flex-row justify-content-end">
                                <button type="button" class="btn btn-outline-secondary px-4 me-2" @onclick="Close">Close</button>
                                <button type="submit" class="btn btn-primary px-4">Save</button>
                            </div>
                        </div>

                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>
@if (_show)
{
     <div class="modal-backdrop fade show"></div>    
}