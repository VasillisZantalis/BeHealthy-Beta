@page "/appointment/form"

@rendermode InteractiveServer

@using BeHealthy.Services.Interfaces
@using BeHealthy.Shared.Models.Dtos.Appointment

@inject IAppointmentService AppointmentService

<EditForm Model="@_appointmentForCreation" OnValidSubmit="@HandleValidSubmit" FormName="UpsertAppointment">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="appointmentDate" class="form-label">Appointment Date</label>
        <InputDate id="appointmentDate" class="form-control" @bind-Value="_appointmentForCreation.AppointmentDate" />
    </div>

    <div class="mb-3">
        <label for="notes" class="form-label">Notes</label>
        <InputTextArea id="notes" class="form-control" @bind-Value="_appointmentForCreation.Notes" />
    </div>

    <div class="mb-3">
        <label for="patientId" class="form-label">Patient ID</label>
        <InputNumber id="patientId" class="form-control" @bind-Value="_appointmentForCreation.PatientId" />
    </div>

    <div class="mb-3">
        <label for="doctorId" class="form-label">Doctor ID</label>
        <InputNumber id="doctorId" class="form-control" @bind-Value="_appointmentForCreation.DoctorId" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private AppointmentForCreationDto _appointmentForCreation{ get; set; } = new();

    private async Task HandleValidSubmit()
    {
        await AppointmentService.AddAppointmentAsync(_appointmentForCreation);
    }
}
