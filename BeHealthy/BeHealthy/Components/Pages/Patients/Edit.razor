@page "/patients/edit/{PatientId:int}"
@using BeHealthy.Components.Pages.Patients.Components.Allergies
@attribute [Authorize(Roles = $"{nameof(UserRole.Admin)},{nameof(UserRole.Doctor)}")]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IPatientService PatientService
@inject IDepartmentService DepartmentService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Edit</PageTitle>

<div class="container-fluid p-5 border rounded shadow">

    <Tabs TTabKey="PatientTabs" @bind-ActiveTab="activeTab">
        <Tab TTabKey="PatientTabs" Title="@Resource.GeneralData" Key="PatientTabs.GeneralData">
            <div class="mt-3">
                <EditForm Model="PatientUpdateDto" method="post" OnValidSubmit="UpdatePatient" FormName="UpdateForm" Enhance>
                    <button type="submit" class="btn btn-success px-5 d-flex flex-row mb-3 mt-0" disabled="@inProgress">
                        @if (inProgress)
                        {
                            <SmallLoader />
                        }
                        <span>@Resource.Save</span>
                    </button>
                    <FluentValidationValidator @ref="fluentValidationValidator" />
                    <div class="row">
                        <Alert @ref="alert" />
                        <ImagePreview ImageUrl="@PatientUpdateDto.Image" />
                        <div class="col-12 col-sm-6">
                            <div class="form-floating mb-3">
                                <InputText @bind-Value="PatientUpdateDto.FirstName" class="form-control" aria-required="true" id="firstName" placeholder="First Name" />
                                <label for="firstName">@Resource.FirstName</label>
                                <ValidationMessage For="() => PatientUpdateDto.FirstName" class="text-danger" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-floating mb-3">
                                <InputText @bind-Value="PatientUpdateDto.LastName" class="form-control" autocomplete="username" aria-required="true" id="lastName" placeholder="Last Name" />
                                <label for="lastName">@Resource.LastName</label>
                                <ValidationMessage For="() => PatientUpdateDto.LastName" class="text-danger" />
                            </div>
                        </div>
                    </div>
                    <ImageUpload OnImageChanged="image => PatientUpdateDto.Image = image" />
                    <div class="form-floating mb-3">
                        <InputText id="phoneNumber" @bind-Value="PatientUpdateDto.PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
                        <label for="phoneNumber">@Resource.PhoneNumber</label>
                        <ValidationMessage For="() => PatientUpdateDto.PhoneNumber" class="text-danger" />
                    </div>

                    @if (departments is not null && departments.Any())
                    {
                        <div class="form-floating mb-3">
                            <InputSelect id="Department" @bind-Value="PatientUpdateDto.DepartmentId" class="form-control">
                                @foreach (var department in departmentsSelect)
                                {
                                    <option value="@department.Value">@department.Text</option>
                                }
                            </InputSelect>
                            <label for="Department">@Resource.Department</label>
                        </div>
                    }
                </EditForm>
            </div>
        </Tab>
        <Tab TTabKey="PatientTabs" Title="@Resource.MedicalRecords" Key="PatientTabs.MedicalRecords">
            <MedicalRecords PatientId="PatientId" />
        </Tab>
        <Tab TTabKey="PatientTabs" Title="@Resource.Allergies" Key="PatientTabs.Allergies">
            <AllergiesGrid PatientId="PatientId" />
        </Tab>
        <Tab TTabKey="PatientTabs" Title="@Resource.Appointments" Key="PatientTabs.Appointments">
        </Tab>
    </Tabs>
</div>


@code {
    [Parameter]
    public int PatientId { get; set; }

    [SupplyParameterFromForm]
    private PatientUpdateDto PatientUpdateDto { get; set; } = new();

    private List<DepartmentDto>? departments { get; set; }

    private bool inProgress = false;
    private Alert alert = new();
    private FluentValidationValidator fluentValidationValidator = new();

    private List<SelectItem> departmentsSelect = new List<SelectItem>();

    private PatientTabs activeTab = PatientTabs.GeneralData;
    private bool canSeePrecriptions;
    private bool canSeeVisits;
    private bool canCreatePrecriptions;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userRole = authState.User.GetUserRoleEnum();

        departments = (await DepartmentService.GetAllDepartmentsAsync()).ToList();
        departmentsSelect = departments.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();

        canSeePrecriptions = true;
        canCreatePrecriptions = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        var patient = await PatientService.GetPatientByIdAsync(PatientId);
        PatientUpdateDto = patient?.MapToDtoForUpdate() ?? new();

        SetBreadcrumbs();
    }

    async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var format = e.File.ContentType;
        var resizeImage = await e.File.RequestImageFileAsync(format, 200, 200);
        var buffer = new byte[resizeImage.Size];
        await resizeImage.OpenReadStream().ReadAsync(buffer);
        PatientUpdateDto.Image = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        { 
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Patients, Link = RoutingEndpoints.PATIENTS_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Edit, Link = RoutingEndpoints.PATIENTS_PAGE, Active = true },
            new Breadcrumb(){ Text = PatientId.ToString(), Link = string.Empty, Active = true },
        });
    }

    private async Task UpdatePatient()
    {
        inProgress = true;

        if (!await fluentValidationValidator.ValidateAsync())
        {
            inProgress = false;
            return;
        }

        var result = await PatientService.UpdatePatientAsync(PatientUpdateDto);
        inProgress = false;

        if (!result.Success)
        {
            alert.ShowFailed(result.ErrorMessage);
        }
        else
        {
            ToastService.ShowToast(Resource.Success, "success");
            NavigationManager.Refresh(true);
        }
    }
}