@page "/patients/edit/{PatientId:int}"
@attribute [Authorize(Roles = $"{nameof(UserRole.Admin)},{nameof(UserRole.Doctor)}")]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IPatientService PatientService
@inject IDepartmentService DepartmentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Edit</PageTitle>

<div class="container-fluid p-5 border rounded shadow">

    <button type="submit" class="btn btn-success px-5 d-flex flex-row mb-3 mt-0" disabled="@_inProgress">
        @if (_inProgress)
        {
            <SmallLoader />
        }
        <span>@Resource.Save</span>
    </button>

    <ul class="nav nav-tabs">
        <li class="nav-item">
            <a class="nav-link text-reset @(activeTab == 0 ? "active fw-bold" : "")" @onclick="() => SelectTab(0)">@Resource.GeneralData</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-reset @(activeTab == 1 ? "active fw-bold" : "")" @onclick="() => SelectTab(1)">@Resource.Visits</a>
        </li>
        @if (canSeePrecriptions)
        {
            <li class="nav-item">
                <a class="nav-link text-reset @(activeTab == 2 ? "active fw-bold" : "")" @onclick="() => SelectTab(2)">@Resource.Prescriptions</a>
            </li>
        }
    </ul>

    @if (activeTab == 0)
    {
        <div class="mt-3">
            <EditForm Model="_PatientUpdateDto" method="post" OnValidSubmit="UpdatePatient" FormName="UpdateForm" Enhance>
                <FluentValidationValidator @ref="_fluentValidationValidator" />
                <div class="row">
                    <Alert @ref="_alert" />
                    <div class="text-center mb-3">
                        <img src="@(_PatientUpdateDto.Image ?? "images/generic.jpg")" class="image-fluid rounded-circle"/>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-floating mb-3">
                            <InputText @bind-Value="_PatientUpdateDto.FirstName" class="form-control" aria-required="true" id="firstName" placeholder="First Name" />
                            <label for="firstName">@Resource.FirstName</label>
                            <ValidationMessage For="() => _PatientUpdateDto.FirstName" class="text-danger" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="form-floating mb-3">
                            <InputText @bind-Value="_PatientUpdateDto.LastName" class="form-control" autocomplete="username" aria-required="true" id="lastName" placeholder="Last Name" />
                            <label for="lastName">@Resource.LastName</label>
                            <ValidationMessage For="() => _PatientUpdateDto.LastName" class="text-danger" />
                        </div>
                    </div>
                </div>
                <div class="form-control mb-3">
                    <InputFile class="form-control" OnChange="OnFileChange" />
                </div>
                <div class="form-floating mb-3">
                    <InputText id="phoneNumber" @bind-Value="_PatientUpdateDto.PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
                    <label for="phoneNumber">@Resource.PhoneNumber</label>
                    <ValidationMessage For="() => _PatientUpdateDto.PhoneNumber" class="text-danger" />
                </div>

                @if (_departments is not null && _departments.Any())
                {
                    <div class="form-floating mb-3">
                        <InputSelect id="Department" @bind-Value="_PatientUpdateDto.DepartmentId" class="form-control">
                            @foreach (var department in _departmentsSelect)
                            {
                                <option value="@department.Value">@department.Text</option>
                            }
                        </InputSelect>
                        <label for="Department">@Resource.Department</label>
                    </div>
                }
            </EditForm>
        </div>
    }
    else if (activeTab == 1)
    {
        <Visits PatientId="PatientId" />
    }
    else if (activeTab == 2 && canSeePrecriptions)
    {
        <Prescriptions PatientId="PatientId"
                       CanCreatePrescription="canCreatePrecriptions" />
    }
</div>


@code {
    [Parameter]
    public int PatientId { get; set; }

    [SupplyParameterFromForm]
    private PatientUpdateDto _PatientUpdateDto { get; set; } = new();

    private List<DepartmentDto>? _departments { get; set; }

    private bool _inProgress = false;
    private Alert _alert = new();
    private FluentValidationValidator _fluentValidationValidator = new();

    private List<SelectItem> _departmentsSelect = new List<SelectItem>();

    private int activeTab = 0;
    private void SelectTab(int tabName) => activeTab = tabName;
    private bool canSeePrecriptions;
    private bool canSeeVisits;
    private bool canCreatePrecriptions;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userRole = authState.User.GetUserRoleEnum();

        canSeePrecriptions = true;
        canCreatePrecriptions = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            SetBreadcrumbs();
    }

    protected override async Task OnParametersSetAsync()
    {

        _departments = (await DepartmentService.GetAllDepartmentsAsync()).ToList();
        var patient = await PatientService.GetPatientByIdAsync(PatientId);
        _departmentsSelect = _departments.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();
        _departmentsSelect.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });
        _PatientUpdateDto = patient?.MapToDtoForUpdate() ?? new();
    }

    async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var format = e.File.ContentType;
        var resizeImage = await e.File.RequestImageFileAsync(format, 200, 200);
        var buffer = new byte[resizeImage.Size];
        await resizeImage.OpenReadStream().ReadAsync(buffer);
        _PatientUpdateDto.Image = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        { 
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Patients, Link = RoutingEndpoints.PATIENTS_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Edit, Link = RoutingEndpoints.PATIENTS_PAGE, Active = true },
            new Breadcrumb(){ Text = PatientId.ToString(), Link = string.Empty, Active = true },
        });
    }

    private async Task UpdatePatient()
    {
        _inProgress = true;

        if (!await _fluentValidationValidator.ValidateAsync())
        {
            _inProgress = false;
            return;
        }

        var result = await PatientService.UpdatePatientAsync(_PatientUpdateDto);

        if (!result.Success)
        {
            _alert.ShowFailed(result.ErrorMessage);
        }
        else
        {
            await ToastrStateService.ShowSuccess(Resource.Success);
        }

        _inProgress = false;
    }
}