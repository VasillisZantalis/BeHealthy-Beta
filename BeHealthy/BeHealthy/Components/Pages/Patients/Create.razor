@page "/patients/create"
@using BeHealthy.Application.Validations.Patient
@attribute [Authorize(Roles = $"{nameof(UserRole.Admin)},{nameof(UserRole.Doctor)}")]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject IPatientService PatientService
@inject IDepartmentService DepartmentService
@inject NavigationManager NavigationManager

<PageTitle>@Resource.Create</PageTitle>

<div class="container-fluid p-5 border rounded shadow">
    <EditForm Model="_patientForCreation" method="post" OnValidSubmit="RegisterPatient" FormName="RegisterForm" Enhance>
        <FluentValidationValidator @ref="_fluentValidationValidator" />
        <div class="row">
            <Alert @ref="_alert" />
            <div class="text-center mb-3">
                <img src="@(_patientForCreation.Image ?? "images/generic.jpg")" class="image-fluid rounded-circle" />
            </div>
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="_patientForCreation.FirstName" class="form-control" aria-required="true" id="firstName" placeholder="First Name" />
                    <label for="firstName">@Resource.FirstName</label>
                    <ValidationMessage For="() => _patientForCreation.FirstName" class="text-danger" />
                </div>
            </div>
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="_patientForCreation.LastName" class="form-control" autocomplete="username" aria-required="true" id="lastName" placeholder="Last Name" />
                    <label for="lastName">@Resource.LastName</label>
                    <ValidationMessage For="() => _patientForCreation.LastName" class="text-danger" />
                </div>
            </div>
        </div>
        <div class="form-control mb-3">
            <InputFile class="form-control" OnChange="OnFileChange" />
        </div>
        <div class="form-floating mb-3">
            <InputText @bind-Value="_patientForCreation.Email" class="form-control" autocomplete="username" aria-required="true" id="email" placeholder="name@example.com" />
            <label for="email">@Resource.Email</label>
            <ValidationMessage For="() => _patientForCreation.Email" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText type="password" @bind-Value="_patientForCreation.Password" class="form-control" autocomplete="new-password" aria-required="true" id="password" placeholder="Password" />
            <label for="password">@Resource.Password</label>
            <ValidationMessage For="() => _patientForCreation.Password" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText type="password" @bind-Value="_patientForCreation.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" id="confirmPassword" placeholder="Confirm Password" />
            <label for="confirmPassword">@Resource.ConfirmPassword</label>
            <ValidationMessage For="() => _patientForCreation.ConfirmPassword" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText id="phoneNumber" @bind-Value="_patientForCreation.PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
            <label for="phoneNumber">@Resource.PhoneNumber</label>
            <ValidationMessage For="() => _patientForCreation.PhoneNumber" class="text-danger" />
        </div>

        @if (_departments is not null && _departments.Any())
        {
            <div class="form-floating mb-3">
                <InputSelect id="Department" @bind-Value="_patientForCreation.DepartmentId" class="form-control">
                    @foreach (var department in _departmentsSelect)
                    {
                        <option value="@department.Value">@department.Text</option>
                    }
                </InputSelect>
                <label for="Department">@Resource.Department</label>
            </div>
        }

        <button type="submit" class="btn btn-success px-5 d-flex flex-row" disabled="@_inProgress">
            @if (_inProgress)
            {
                <SmallLoader />
            }
            <span>@Resource.Save</span>
        </button>
    </EditForm>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private PatientForCreationDto _patientForCreation { get; set; } = new();
    private bool _inProgress = false;
    private List<DepartmentDto>? _departments { get; set; }
    private int? _departmentId;

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    private Alert _alert = new();
    private FluentValidationValidator _fluentValidationValidator = new();

    private List<SelectItem> _departmentsSelect = new List<SelectItem>();

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs();

        _departments = (await DepartmentService.GetAllDepartmentsAsync()).ToList();
        _departmentsSelect = _departments.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();
        _departmentsSelect.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        {
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Patients, Link = RoutingEndpoints.PATIENTS_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Create, Link = RoutingEndpoints.PATIENTS_PAGE, Active = true }
        });
    }

    public async Task RegisterPatient(EditContext editContext)
    {
        _inProgress = true;

        if (!await _fluentValidationValidator.ValidateAsync())
        {
            _inProgress = false;
            return;
        }

        var user = new ApplicationUser
        {
            FirstName = _patientForCreation.FirstName,
            LastName = _patientForCreation.LastName,
            PhoneNumber = _patientForCreation.PhoneNumber
        };

        await UserStore.SetUserNameAsync(user, _patientForCreation.Email, CancellationToken.None);
        await UserManager.SetEmailAsync(user, _patientForCreation.Email);

        var result = await UserManager.CreateAsync(user, _patientForCreation.Password);

        if (!result.Succeeded)
        {
            _inProgress = false;
            identityErrors = result.Errors;
            var errors = identityErrors is null ? "Failed" : string.Join(", ", identityErrors.Select(error => error.Description));
            _alert.ShowFailed(errors);
            return;
        }

        await UserManager.AddToRoleAsync(user, nameof(UserRole.Patient));

        _patientForCreation.UserId = user.Id;
        var patientCreationResult = await PatientService.AddPatientAsync(_patientForCreation);

        if (!patientCreationResult.Success)
        {
            await UserManager.DeleteAsync(user);
            _alert.ShowFailed(Resource.SomethingWentWrong);
        }
        else
        {
            _alert.ShowSuccess(Resource.Success);
        }

        _inProgress = false;
    }

    private void HandleModalClose(bool success)
    {
        _inProgress = false;

        if (!success)
            return;

        NavigationManager.NavigateTo(RoutingEndpoints.PATIENTS_PAGE);
    }

    async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var format = e.File.ContentType;
        var resizeImage = await e.File.RequestImageFileAsync(format, 200, 200);
        var buffer = new byte[resizeImage.Size];
        await resizeImage.OpenReadStream().ReadAsync(buffer);
        _patientForCreation.Image = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
    }
}
