@page "/patients"
@attribute [Authorize(Roles = $"{nameof(UserRole.Admin)},{nameof(UserRole.Doctor)},{nameof(UserRole.Nurse)}")]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

<PageTitle>@Resource.Patients</PageTitle>

<div class="d-flex flex-row gap-3">
    <div class="">
        <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="CreatePatient">
            <Icon IconClass="@FAIcon.Plus" /> @Resource.Create
        </button>
        <button class="btn btn-secondary rounded-pill px-3" @onclick="ShowImportWizard">
            <Icon IconClass="@FAIcon.Import" /> @Resource.MassImport
        </button>
    </div>
    <div class="">
        <InputSelect id="viewSelect" class="form-select" @bind-Value="_selectedView">
            <option value="Card">@Resource.Card</option>
            <option value="Grid">@Resource.Grid</option>
        </InputSelect>
    </div>
</div>

@if (showWizard)
{
    <MassImportWizard TEntity="PatientCreateDto"
                      OnSave="BulkCreatePatients"
                      Entity="@(ImportEntity.Patient)"
                      OnClose="HideImportWizard" />
}


@if (_selectedView == "Grid")
{
    <Filters TFilter="PatientSearchingParameters"
             FilterModel="_filters"
             OnSearch="HandleFilterApplied">
        <div class="col-12 col-sm-4">
            <input id="firstNameFilter" class="form-control" @bind="_filters.FirstName" placeholder="@Resource.FirstName" />
        </div>
        <div class="col-12 col-sm-4">
            <input id="lastNameFilter" class="form-control" @bind="_filters.LastName" placeholder="@Resource.LastName"/>
        </div>
    </Filters>
}

@if (_patients is null || !_patients.Any())
{
    <p>@string.Format(Resource.NoAvailable, Resource.Patients)</p>
}
else
{
    @if (_selectedView == "Card")
    {
        <div class="row">
            <Virtualize Items="@_patients.ToList()" Context="patient" ItemSize="100">
                <div class="col-12 col-md-6 col-lg-4 col-xl-4 col-xxl-3">
                    <div class="mb-3">
                        <UserCard Id="@patient.Id"
                                  Image="@patient.Image"
                                  FullName="@patient.FullName"
                                  Email="@patient.Email"
                                  Phone="@patient.PhoneNumber"
                                  CanEdit="hasEditRight"
                                  CanDelete="hasDeleteRight"
                                  Edit="() => EditPatient(patient.Id)"
                                  Delete="() => ConfirmDelete(patient.Id)" />
                    </div>
                </div>
            </Virtualize>
        </div>
    }
    else if (_selectedView == "Grid")
    {
        <div class="patientsTableDiv mt-3">
            <div class="card">
                <div class="card-header d-flex flex-row justify-content-end">
                    <div class="px-1">
                        <InputSelect class="form-select form-select-sm" @bind-Value="_paginationState.ItemsPerPage">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="table-responsive">
                    <div class="card-body pb-2 px-0 m-0">
                        <QuickGrid @ref="_quickGrid"
                                   Class="table table-responsive"
                                   Items="@_patients"
                                   ItemKey="@(x => x.Id)"
                                   Pagination="_paginationState">
                            <TemplateColumn>
                                <img class="rounded-circle" src="@(context.Image ?? "images/generic.jpg")" alt="@context.FullName" width="25" height="25" />
                            </TemplateColumn>
                            <PropertyColumn Title="@Resource.FirstName"
                                            Property="@(x => x.FirstName)"
                                            Sortable="true">
                                <ColumnOptions>
                                    <div>
                                        <input type="search" autofocus @bind="firstNameFilter" @bind:event="oninput" placeholder="@(Resource.Search)" />
                                    </div>
                                </ColumnOptions>
                            </PropertyColumn>
                            <PropertyColumn Title="@Resource.LastName"
                                            Property="@(x => x.LastName)"
                                            Sortable="true" />
                            <PropertyColumn Title="@Resource.Created"
                                            Property="@(x => x.CreatedAt)"
                                            Format="dd MMM yyyy HH:mm"
                                            Sortable="true"
                                            IsDefaultSortColumn="true"
                                            InitialSortDirection="SortDirection.Descending" />
                            <PropertyColumn Title="@Resource.Email"
                                            Property="@(x => x.Email)" />
                            <PropertyColumn Title="@Resource.PhoneNumber"
                                            Property="@(x => x.PhoneNumber)" />
                            @if (hasActionRights)
                            {
                                <TemplateColumn Title="@Resource.Actions" Align="Align.End">
                                    <div class="d-flex justify-content-end">
                                        @if (hasEditRight)
                                        {
                                            <button class="btn" title="@(Resource.Edit)" @onclick="@(() => EditPatient(context.Id))">
                                                <Icon IconClass="@FAIcon.EditSquare" TextClass="text-warning" />
                                            </button>
                                        }
                                        @if (hasDeleteRight)
                                        {
                                            <button class="btn" title="@(Resource.Delete)" @onclick="() => ConfirmDelete(context.Id)">
                                                <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />
                                            </button>
                                        }
                                    </div>
                                </TemplateColumn>
                            }
                        </QuickGrid>
                    </div>
                </div>
                <div id="paginatorDiv" class="px-3">
                    <Paginator State="_paginationState" />
                </div>
            </div>
        </div>
    }
}