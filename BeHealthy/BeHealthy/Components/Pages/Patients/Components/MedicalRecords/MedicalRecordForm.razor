@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

<EditForm Model="_medicalRecordDto" FormName="MedicalRecordForm" OnValidSubmit="SaveMedicalRecord">
    <ValidationComponent @ref="_validationComponent" />
    <div class="form-floating mb-3">
        <InputText id="notes" @bind-Value="_medicalRecordDto.Notes" class="form-control" />
        <label for="email" class="form-label">@Resource.Notes</label>
        <ValidationMessage For="() => _medicalRecordDto.Notes" class="text-danger" />
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private MedicalRecordDto _medicalRecordDto { get; set; } = new();

    private ValidationComponent? _validationComponent;

    private async Task SaveMedicalRecord(EditContext args)
    {
        _validationComponent?.ClearErrors();
    }
}
