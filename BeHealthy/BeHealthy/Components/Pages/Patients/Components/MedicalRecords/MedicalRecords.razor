@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IMedicalRecordService MedicalRecordService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="py-3">
    <CreateButton OnClick="CreateMedicalRecord" />

    @if (medicalRecords.Any())
    {
        <QuickGrid Items="medicalRecords.AsQueryable()"
                   ItemKey="@(x => x.Id)"
                   Class="table table-responsive">
            <PropertyColumn Title="@Resource.Date"
                            Property="@(x => x.RecordDate.ToShortHumanizedDateString())"
                            IsDefaultSortColumn="true"
                            InitialSortDirection="SortDirection.Descending" />
            <PropertyColumn Title="@Resource.Created"
                            Property="@(x => x.CreatedBy)" />
            <PropertyColumn Title="@Resource.Notes"
                            Property="@(x => x.Notes)" />
            <TemplateColumn Title="@Resource.Actions" Align="Align.End">
                <div class="d-flex justify-content-end">
                    <button class="btn" title="@(Resource.Edit)" @onclick="@(() => EditRecord(context.Id))">
                        <Icon IconClass="@FAIcon.EditSquare" TextClass="text-warning" />
                    </button>
                    <button class="btn" title="@(Resource.Delete)" @onclick="() => ConfirmDelete(context.Id)">
                        <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />
                    </button>
                </div>
            </TemplateColumn>
        </QuickGrid>

        // TODO fix passing MedicalRecordId to VisitModal OR remove this functionality
        @* <VisitModal @ref="visitModal" PatientId="PatientId"/> *@
    }
    else
    {
        <p>@string.Format(Resource.NoAvailable, Resource.MedicalRecords)</p>
    }
</div>

<GenericModal @ref="genericModal"
              Title="@Resource.MedicalRecord"
              OnSave="SaveMedicalRecord">

    <EditForm Model="medicalRecordDto" FormName="MedicalRecordForm">
        <div class="form-floating">
            <InputText id="notes" @bind-Value="medicalRecordDto.Notes" class="form-control" />
            <label for="notes">@Resource.Notes</label>
        </div>
    </EditForm>

</GenericModal>


@code {
    [Parameter, EditorRequired]
    public int PatientId { get; set; }

    private GenericModal genericModal { get; set; } = new();

    private List<MedicalRecordDto> medicalRecords { get; set; } = new();

    [SupplyParameterFromForm]
    private MedicalRecordDto medicalRecordDto { get; set; } = new();

    private AuthenticationState? authState;

    protected override async Task OnInitializedAsync()
    {
        LoaderService.SetLoader(true);
        await LoadMedicalRecords();
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        LoaderService.SetLoader(false);
    }

    private async Task LoadMedicalRecords()
    {
        LoaderService.SetLoader(true);
        medicalRecords = (await MedicalRecordService.GetMedicalRecordsByPatientIdAsync(PatientId)).ToList();
        await InvokeAsync(StateHasChanged);
        LoaderService.SetLoader(false);
    }

    private async Task SaveMedicalRecord()
    {
        medicalRecordDto.PatientId = PatientId;
        medicalRecordDto.CreatedBy = authState?.User.GetUserName();

        if (medicalRecordDto.Id > 0)
        {
            var medicalRecordUpdateDto = medicalRecordDto.MapToMedicalRecordUpdateDto();
            await MedicalRecordService.UpdateMedicalRecordAsync(medicalRecordUpdateDto);
        }
        else
        {
            medicalRecordDto.RecordDate = DateTime.UtcNow;
            var medicalRecordCreateDto = medicalRecordDto.MapToMedicalRecordCreateDto();
            await MedicalRecordService.AddMedicalRecordAsync(medicalRecordCreateDto);
        }

        await ToastService.EnqueueToastAsync(Resource.Success, "success");
        NavigationManager.Refresh(true);
    }

    private void EditRecord(int medicalRecordId)
    {
        NavigationManager.NavigateTo($"{RoutingEndpoints.PATIENTS_PAGE}/{PatientId}{RoutingEndpoints.MEDICALRECORDS_PAGE}/{medicalRecordId}");
    }

    private async Task EditMedicalRecord(int medicalRecordId)
    {
        medicalRecordDto = await MedicalRecordService.GetMedicalRecordByIdAsync(medicalRecordId) ?? new();
        genericModal.OpenModal();
    }

    private void CreateMedicalRecord()
    {
        medicalRecordDto = new();
        genericModal.OpenModal();
    }


    private void ConfirmDelete(int medicalRecordId)
    {
        ModalService.Show<ConfirmDeleteModal>(
           new Dictionary<string, object?>
           {
               { nameof(ConfirmDeleteModal.OnConfirm), () => OnConfirmDeleteAsync(medicalRecordId) }
           });
    }

    private async Task OnConfirmDeleteAsync(int medicalRecordId)
    {
        await MedicalRecordService.DeleteMedicalRecordAsync(medicalRecordId);
        await LoadMedicalRecords();
    }
}
