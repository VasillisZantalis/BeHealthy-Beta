@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IMedicalRecordService MedicalRecordService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="py-3">
    <button class="btn btn-outline-secondary rounded-pill px-3 mb-3" @onclick="CreateMedicalRecord">
        <Icon IconClass="@FAIcon.Plus" /> @Resource.Create
    </button>
    @if (_medicalRecords.Any())
    {
        <QuickGrid Items="_medicalRecords.AsQueryable()"
                   ItemKey="@(x => x.Id)"
                   Class="table table-responsive">
            <PropertyColumn Title="@Resource.Date"
                            Property="@(x => x.RecordDate.ToShortHumanizedDateString())"
                            IsDefaultSortColumn="true"
                            InitialSortDirection="SortDirection.Descending" />
            <PropertyColumn Title="@Resource.Created"
                            Property="@(x => x.CreatedBy)" />
            <PropertyColumn Title="@Resource.Notes"
                            Property="@(x => x.Notes)" />
            <TemplateColumn Title="@Resource.Actions" Align="Align.End">
                <div class="d-flex justify-content-end">
                    <button class="btn" title="@(Resource.Edit)" @onclick="@(() => EditMedicalRecord(context.Id))">
                        <Icon IconClass="@FAIcon.EditSquare" TextClass="text-warning" />
                    </button>
                    <button class="btn" title="@(string.Join(" ", Resource.Create, Resource.Visit))" @onclick="() => {}">
                        <Icon IconClass="@FAIcon.Plus" TextClass="text-info" />
                    </button>
                    <button class="btn" title="@(Resource.Delete)" @onclick="() => ConfirmDelete(context.Id)">
                        <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />
                    </button>
                </div>
            </TemplateColumn>
        </QuickGrid>
    }
    else
    {
        <p>@string.Format(Resource.NoAvailable, Resource.MedicalRecords)</p>
    }
</div>

<GenericModal @ref="_genericModal"
              Title="@Resource.MedicalRecord"
              OnSave="SaveMedicalRecord">

    <EditForm Model="_medicalRecordDto" FormName="MedicalRecordForm">
        <div class="form-floating">
            <InputText id="notes" @bind-Value="_medicalRecordDto.Notes" class="form-control" />
            <label for="email" class="form-label">@Resource.Notes</label>
        </div>
    </EditForm>

</GenericModal>

@code {
    [Parameter, EditorRequired]
    public int PatientId { get; set; }

    private GenericModal _genericModal { get; set; } = new();

    private List<MedicalRecordDto> _medicalRecords { get; set; } = new();

    [SupplyParameterFromForm]
    private MedicalRecordDto _medicalRecordDto { get; set; } = new();

    private AuthenticationState? _authState;

    protected override async Task OnInitializedAsync()
    {
        LoaderService.SetLoader(true);

        _medicalRecords = (await MedicalRecordService.GetMedicalRecordsByPatientIdAsync(PatientId)).ToList();
        _authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        LoaderService.SetLoader(false);
    }

    private async Task SaveMedicalRecord()
    {
        _medicalRecordDto.PatientId = PatientId;
        _medicalRecordDto.CreatedBy = _authState?.User.GetUserName();

        if (_medicalRecordDto.Id > 0)
        {
            var medicalRecordUpdateDto = _medicalRecordDto.MapToMedicalRecordUpdateDto();
            await MedicalRecordService.UpdateMedicalRecordAsync(medicalRecordUpdateDto);
        }
        else
        {
            _medicalRecordDto.RecordDate = DateTime.UtcNow;
            var medicalRecordCreateDto = _medicalRecordDto.MapToMedicalRecordCreateDto();
            await MedicalRecordService.AddMedicalRecordAsync(medicalRecordCreateDto);
        }

        NavigationManager.Refresh(true);
    }

    private async Task EditMedicalRecord(int medicalRecordId)
    {
        _medicalRecordDto = await MedicalRecordService.GetMedicalRecordByIdAsync(medicalRecordId) ?? new();
        _genericModal.OpenModal();
    }

    private void CreateMedicalRecord()
    {
        _medicalRecordDto = new();
        _genericModal.OpenModal();
    }


    private void ConfirmDelete(int medicalRecordId)
    {
        ConfirmDeleteService.RequestDelete(async () =>
        {
            await MedicalRecordService.DeleteMedicalRecordAsync(medicalRecordId);
            NavigationManager.Refresh(true);
        });
    }

}
