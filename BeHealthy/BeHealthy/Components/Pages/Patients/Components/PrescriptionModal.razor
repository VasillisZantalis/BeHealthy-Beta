
@inject IPrescriptionService PrescriptionService
@inject NavigationManager NavigationManager

@if (_showModal)
{
    <div class="modal fade show" tabindex="-1" style="display: block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title">@ModalTitle</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_prescriptionDto" FormName="PrescriptionForm" OnValidSubmit="SavePrescription">
                        <DataAnnotationsValidator />

                        <div class="d-flex flex-column gap-3">
                            <div class="form">
                                <label class="fw-bold" for="medication">@Resource.Medication</label>
                                <InputText id="medication" class="form-control" @bind-Value="_prescriptionDto.Medication" />
                                <ValidationMessage For="@(() => _prescriptionDto.Medication)" />
                            </div>
                            <div class="form">
                                <label class="fw-bold" for="dosage">@Resource.Dosage</label>
                                <InputText id="dosage" class="form-control" @bind-Value="_prescriptionDto.Dosage" />
                                <ValidationMessage For="@(() => _prescriptionDto.Dosage)" />
                            </div>
                            <div class="form">
                                <label class="fw-bold" for="datePrescribed">@Resource.DatePrescribed</label>
                                <InputDate id="datePrescribed" class="form-control" @bind-Value="_prescriptionDto.DatePrescribed" disabled="@_lockNonModifiable" />
                                <ValidationMessage For="@(() => _prescriptionDto.DatePrescribed)" />
                            </div>
                            <div class="">
                                <label class="fw-bold" for="doctorIdSelect">@Resource.Doctor</label>
                                <InputSelect id="doctorIdSelect" class="form-select" @bind-Value="_prescriptionDto.DoctorId" disabled="@_lockNonModifiable">
                                    @foreach (var doctor in _doctorsSelect)
                                    {
                                        <option value="@doctor.Value">@doctor.Text</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _prescriptionDto.DoctorId)" />
                            </div>
                        </div>
                        <div class="d-flex flex-row justify-content-end m-3 gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CloseModal">@Resource.Cancel</button>
                            <button type="submit" class="btn btn-success">@Resource.Save</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}



@code {
    [Parameter, EditorRequired]
    public EventCallback<bool> Successful { get; set; }

    private bool _lockNonModifiable = default;

    [SupplyParameterFromForm]
    private PrescriptionDto _prescriptionDto { get; set; } = new();

    [Parameter, EditorRequired]
    public int? PrescriptionId { get; set; }

    private bool _showModal { get; set; }
    private bool _isEditMode => PrescriptionId.HasValue;

    private List<DoctorDto> _doctors { get; set; } = default!;
    private string ModalTitle => _isEditMode ? Resource.Edit : Resource.Create;
    private List<SelectItem> _doctorsSelect = new();

    [Inject]
    private IDoctorService _doctorService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _doctors = (await _doctorService.GetAllDoctorsAsync()).ToList();

        _doctorsSelect = _doctors.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.FullName
        }).ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        _prescriptionDto = new();
        _lockNonModifiable = false;

        _prescriptionDto.DatePrescribed = !_isEditMode ? DateTime.Now : DateTime.Now;

        if (PrescriptionId.HasValue)
        {
            var prescription = await PrescriptionService.GetPrescriptionByIdAsync(PrescriptionId.Value);
            _lockNonModifiable = true;

            _prescriptionDto.Medication = prescription.Medication;
            _prescriptionDto.Dosage = prescription.Dosage;
            _prescriptionDto.DatePrescribed = prescription.DatePrescribed;
            _prescriptionDto.DoctorId = prescription.DoctorId;
        }
    }

    public void OpenModal()
    {
        _showModal = true;
    }

    public void CloseModal()
    {
        _showModal = false;
    }

    private async Task SavePrescription()
    {
        var patientId = NavigationManager.Uri.Split("/").LastOrDefault();

        _prescriptionDto.PatientId = Convert.ToInt32(patientId);

        if (_isEditMode && PrescriptionId.HasValue)
        {
            var prescriptionForUpdate = new PrescriptionForUpdateDto
            {
                Id = PrescriptionId.Value,
                Medication = _prescriptionDto.Medication,
                Dosage = _prescriptionDto.Dosage
            };
            await PrescriptionService.UpdatePrescriptionAsync(prescriptionForUpdate);
            await Successful.InvokeAsync(true);
        }
        else
        {
             var prescriptionForCreation = new PrescriptionForCreationDto
            {
                Medication = _prescriptionDto.Medication,
                Dosage = _prescriptionDto.Dosage,
                DatePrescribed = _prescriptionDto.DatePrescribed,
                DoctorId = _prescriptionDto.DoctorId,
                PatientId = _prescriptionDto.PatientId
            };

            var response = await PrescriptionService.AddPrescriptionAsync(prescriptionForCreation);
            await Successful.InvokeAsync(response.Success);
        }
        CloseModal();
    }
}
