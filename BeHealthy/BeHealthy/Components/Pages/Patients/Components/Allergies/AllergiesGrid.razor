@using BeHealthy.Application.Validations.Allergy
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IAllergyService AllergyService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="py-3">
    <CreateButton OnClick="CreateAllergy" />
    @if (_allergies.Any())
    {
        <QuickGrid Items="_allergies.AsQueryable()"
                   ItemKey="@(x => x.Id)"
                   Class="table table-responsive">
            <PropertyColumn Title="@Resource.Allergy"
                            Property="@(x => x.AllergyName)"
                            IsDefaultSortColumn="true"
                            InitialSortDirection="SortDirection.Ascending" />
            <PropertyColumn Title="@Resource.Allergen"
                            Property="@(x => x.Allergen)" />
            <TemplateColumn Title="@Resource.Actions" Align="Align.End">
                <div class="d-flex justify-content-end">
                    <button class="btn" title="@(Resource.Edit)" @onclick="@(() => EditAllergy(context.Id))">
                        <Icon IconClass="@FAIcon.EditSquare" TextClass="text-warning" />
                    </button>
                    <button class="btn" title="@(Resource.Delete)" @onclick="() => ConfirmDelete(context.Id)">
                        <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />
                    </button>
                </div>
            </TemplateColumn>
        </QuickGrid>
    }
    else
    {
        <p>@string.Format(Resource.NoAvailable, Resource.Allergies)</p>
    }
</div>

<GenericModal @ref="_genericModal"
              Title="@Resource.Allergy"
              OnSave="SaveAllergy">
    <EditForm Model="_allergyDto" FormName="AllergyForm">
        <div class="form-group">
            <label for="notes" class="form-label fw-bold required">@Resource.Allergy</label>
            <InputText id="notes" @bind-Value="_allergyDto.AllergyName" class="form-control" />
        </div>
        <div class="form-group">
            <label for="notes" class="form-label fw-bold">@Resource.Allergen</label>
            <InputText id="notes" @bind-Value="_allergyDto.Allergen" class="form-control" />
        </div>
    </EditForm>
</GenericModal>

@code {
    private List<AllergyDto> _allergies = new();

    [SupplyParameterFromForm]
    private AllergyDto _allergyDto { get; set; } = new();

    [Parameter, EditorRequired]
    public int PatientId { get; set; }

    private GenericModal _genericModal { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllergies();
    }

    private void CreateAllergy()
    {
        _allergyDto = new();
        _genericModal.OpenModal();
    }

    private async Task EditAllergy(int id)
    {
        _allergyDto = await AllergyService.GetAllergyByIdAsync(id) ?? new();
        _genericModal.OpenModal();
    }

    private async Task SaveAllergy()
    {
        _allergyDto.PatientId = PatientId;

        ServiceResponse serviceResponse;

        if (_allergyDto.Id == 0)
        {
            var allergyCreateDto = _allergyDto.MapToCreateDto();

            var validator = new AllergyCreateDtoValidator();
            var validationResult = await validator.ValidateAsync(allergyCreateDto);

            if (!validationResult.IsValid)
            {
                ToastService.ShowToast(Resource.InvalidData, "danger");
                return;
            }
            serviceResponse = await AllergyService.AddAllergyAsync(allergyCreateDto);
        }
        else
        {
            var allergyUpdateDto = _allergyDto.MapToUpdateDto();

            var validator = new AllergyUpdateDtoValidator();
            var validationResult = await validator.ValidateAsync(allergyUpdateDto);

            if (!validationResult.IsValid)
            {
                ToastService.ShowToast(Resource.InvalidData, "danger");
                return;
            }
            serviceResponse = await AllergyService.UpdateAllergyAsync(allergyUpdateDto);
        }

        if (HandleServiceResponse(serviceResponse))
        {
            ToastService.ShowToast(Resource.Success, "success");
            await LoadAllergies();
            _genericModal.CloseModal();
            StateHasChanged();
        }
    }

    private async Task LoadAllergies()
    {
        LoaderService.SetLoader(true);
        _allergies = (await AllergyService.GetAllergiesByPatientIdAsync(PatientId)).ToList();
        LoaderService.SetLoader(false);
    }

    private void ConfirmDelete(int allergyId)
        => ConfirmDeleteService.RequestDelete(() => ExecuteDeleteAllergyAsync(allergyId));

    private async Task ExecuteDeleteAllergyAsync(int allergyId)
    {
        var response = await AllergyService.DeleteAllergyAsync(allergyId);
        if (HandleServiceResponse(response))
        {
            ToastService.ShowToast(Resource.Success, "success");
            await LoadAllergies();
            StateHasChanged();
        }
    }
}
