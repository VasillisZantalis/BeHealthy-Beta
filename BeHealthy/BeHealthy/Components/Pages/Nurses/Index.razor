@page "/nurses"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

<PageTitle>@Resource.Nurses</PageTitle>

<div class="d-flex flex-row gap-3">
    <div class="">
        <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="CreateNurse">
            <Icon IconClass="@FAIcon.Plus" /> @Resource.Create
        </button>
    </div>
    <div class="">
        <InputSelect id="viewSelect" class="form-select" @bind-Value="_selectedView">
            <option value="Card">@Resource.Card</option>
            <option value="Grid">@Resource.Grid</option>
        </InputSelect>
    </div>
</div>

@if (_nurses is null)
{
    <p>@string.Format(Resource.NoAvailable, Resource.Nurses)</p>
}
else
{
    @if (_selectedView == "Card")
    {
        <div class="row">
            <Virtualize Items="@_nurses" Context="nurse" ItemSize="100">
                <div class="col-12 col-md-6 col-lg-4 col-xl-4 col-xxl-3">
                    <div class="mb-3">
                        <UserCard Id="@nurse.Id"
                                  Image="@nurse.Image"
                                  FullName="@nurse.FullName"
                                  Email="@nurse.Email"
                                  Phone="@nurse.PhoneNumber"
                                  CanEdit="hasEditRight"
                                  CanDelete="hasDeleteRight"
                                  Edit="() => EditNurse(nurse.Id)"
                                  Delete="() => ConfirmDelete(nurse.Id)" />
                    </div>
                </div>
            </Virtualize>
        </div>
    }
    else if (_selectedView == "Grid")
    {
        <div class="patientsTableDiv mt-3">
            <div class="card">
                <div class="card-header d-flex flex-row justify-content-end">
                    <div class="px-1">
                        <InputSelect class="form-select form-select-sm" @bind-Value="_paginationState.ItemsPerPage">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="table-responsive">
                    <div class="card-body pb-2 px-0 m-0">
                    <QuickGrid Class="table table-responsive"
                               Items="@_nurses.AsQueryable()"
                               ItemKey="@(x => x.Id)"
                               Pagination="_paginationState">
                        <TemplateColumn>
                            <img class="rounded-circle" src="@(context.Image ?? "images/generic.jpg")" alt="@context.FullName" width="25" height="25" />
                        </TemplateColumn>
                        <PropertyColumn Title="@Resource.FirstName"
                                        Property="@(x => x.FirstName)"
                                        Sortable="true" />
                        <PropertyColumn Title="@Resource.LastName"
                                        Property="@(x => x.LastName)"
                                        Sortable="true" />
                        <PropertyColumn Title="@Resource.Created"
                                        Property="@(x => x.CreatedAt)"
                                        Format="dd MMM yyyy HH:mm"
                                        Sortable="true"
                                        IsDefaultSortColumn="true"
                                        InitialSortDirection="SortDirection.Descending" />
                        <PropertyColumn Title="@Resource.Email"
                                        Property="@(x => x.Email)" />
                        <PropertyColumn Title="@Resource.PhoneNumber"
                                        Property="@(x => x.PhoneNumber)" />
                        @if (hasActionRights)
                        {
                            <TemplateColumn>
                                <ActionsDropdown>
                                    @if (hasEditRight)
                                    {
                                        <button class="btn w-100 text-start" @onclick="() => EditNurse(context.Id)">
                                            <Icon IconClass="@FAIcon.Pencil" TextClass="text-warning" />&nbsp; @Resource.Edit
                                        </button>
                                    }
                                    @if (hasDeleteRight)
                                    {
                                        <button class="btn w-100 text-start" @onclick="() => ConfirmDelete(context.Id)">
                                            <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />&nbsp; @Resource.Delete
                                        </button>
                                    }
                                </ActionsDropdown>
                            </TemplateColumn>
                        }
                    </QuickGrid>
                </div>
                </div>
                <div id="paginatorDiv" class="px-3">
                    <Paginator State="_paginationState" />
                </div>
            </div>
        </div>
    }
}