@page "/nurses/edit/{NurseId:int}"
@attribute [Authorize(Roles = "Admin")]
@attribute [StreamRendering]
@rendermode InteractiveServer

@inject INurseService NurseService
@inject IDepartmentService DepartmentService
@inject UserManager<ApplicationUser> UserManager

<PageTitle>@Resource.Edit</PageTitle>

<SectionContent SectionName="page-title">
    <BackButton BackPath="@(RoutingEndpoints.NURSES_PAGE)" />
    <span>@Resource.Nurses/@Resource.Edit/@NurseId</span>
</SectionContent>

<div class="container-fluid p-5 border rounded shadow">
    <EditForm Model="_nurseForUpdateDto" method="post" OnValidSubmit="UpdateNurse" FormName="UpdateForm" Enhance>
        <DataAnnotationsValidator />
        <div class="row">
            <Alert @ref="_alert" />
            <div class="text-center mb-3">
                <img src="@(_nurseForUpdateDto.Image ?? "images/generic.jpg")" class="image-fluid rounded-circle" />
            </div>
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="_nurseForUpdateDto.FirstName" class="form-control" aria-required="true" id="firstName" placeholder="First Name" />
                    <label for="firstName">@Resource.FirstName</label>
                    <ValidationMessage For="() => _nurseForUpdateDto.FirstName" class="text-danger" />
                </div>
            </div>
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="_nurseForUpdateDto.LastName" class="form-control" autocomplete="username" aria-required="true" id="lastName" placeholder="Last Name" />
                    <label for="lastName">@Resource.LastName</label>
                    <ValidationMessage For="() => _nurseForUpdateDto.LastName" class="text-danger" />
                </div>
            </div>
        </div>
        <div class="form-control mb-3">
            <InputFile class="form-control" OnChange="OnFileChange" />
        </div>
        <div class="form-floating mb-3">
            <InputText id="phoneNumber" @bind-Value="_nurseForUpdateDto.PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
            <label for="phoneNumber">@Resource.PhoneNumber</label>
            <ValidationMessage For="() => _nurseForUpdateDto.PhoneNumber" class="text-danger" />
        </div>

        @if (_departments is not null && _departments.Any())
        {
            <div class="form-floating mb-3">
                <InputSelect id="Department" @bind-Value="_nurseForUpdateDto.DepartmentId" class="form-control">
                    @foreach (var department in _departmentsSelect)
                    {
                        <option value="@department.Value">@department.Text</option>
                    }
                </InputSelect>
                <label for="Department">@Resource.Department</label>
            </div>
        }

        <button type="submit" class="btn btn-success px-5" disabled="@_inProgress">
            @if (_inProgress)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            @Resource.Save
        </button>
    </EditForm>
</div>


@code {
    [Parameter]
    public int NurseId { get; set; }

    [SupplyParameterFromForm]
    private NurseForUpdateDto _nurseForUpdateDto { get; set; } = new();

    private List<DepartmentDto>? _departments { get; set; }

    private bool _inProgress = false;
    private Alert _alert = new();

    private List<SelectItem> _departmentsSelect = new List<SelectItem>();

    protected override async Task OnParametersSetAsync()
    {
        _departments = (await DepartmentService.GetAllDepartmentsAsync()).ToList();
        var nurse = await NurseService.GetNurseByIdAsync(NurseId);
        _departmentsSelect = _departments.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();
        _departmentsSelect.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });
        _nurseForUpdateDto = nurse.MapToUpdateDto();
    }

    async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var format = e.File.ContentType;
        var resizeImage = await e.File.RequestImageFileAsync(format, 200, 200);
        var buffer = new byte[resizeImage.Size];
        await resizeImage.OpenReadStream().ReadAsync(buffer);
        _nurseForUpdateDto.Image = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
    }

    private async Task UpdateNurse()
    {
        var user = await UserManager.FindByIdAsync(_nurseForUpdateDto.UserId);

        if (user != null)
        {
            user.FirstName = _nurseForUpdateDto.FirstName;
            user.LastName = _nurseForUpdateDto.LastName;
            user.PhoneNumber = _nurseForUpdateDto.PhoneNumber;

            var result = await UserManager.UpdateAsync(user);

            if (!result.Succeeded)
            {
                _inProgress = false;
                _alert.ShowSuccess(Resource.SomethingWentWrong);
            }
            else
            {
                await NurseService.UpdateNurseAsync(_nurseForUpdateDto.Id, _nurseForUpdateDto);
                _alert.ShowSuccess(Resource.Success);
            }
        }

        _inProgress = false;
    }
}