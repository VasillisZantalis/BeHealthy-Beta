@page "/nurses"
@attribute [Authorize(Roles = $"{nameof(UserRole.Admin)},{nameof(UserRole.Doctor)},{nameof(UserRole.Nurse)}")]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

<PageTitle>@Resource.Nurses</PageTitle>

<BeHealthyCard HeaderClass="d-flex justify-content-between align-items-center flex-wrap">
    <Header>
        <div class="d-flex gap-3">
            @if (userRole == UserRole.Admin)
            {
                <div class="">
                    <CreateButton OnClick="CreateNurse" />
                    <MassImportButton OnClick="ShowImportWizard" />
                    @if (selectedNurseIds.Any())
                    {
                        <button class="btn btn-danger rounded-pill mx-1" @onclick="ConfirmBulkDelete">
                            <Icon IconClass="@FAIcon.TrashCan" />
                            @string.Format(Resource.BulkDeleteNumber, selectedNurseIds.Count)
                        </button>
                    }
                </div>
            }
            <div>
                <ViewSelect @bind-Value="selectedView" />
            </div>
        </div>
        <div>
            <BeHealthySearch OnSearch="HandleSearch"
                            OnClear="HandleClearFilters" />
        </div>
    </Header>

    <Body>
        @if (selectedView == "Card")
        {
            @if (nurses is null || !nurses.Any())
            {
                <p>@string.Format(Resource.NoAvailable, Resource.Nurses)</p>
            }
            else
            {
                <div class="row">
                    <Virtualize Items="@nurses" Context="nurse" ItemSize="100">
                        <div class="col-12 col-md-6 col-lg-4 col-xl-4 col-xxl-3">
                            <div class="mb-3">
                                <UserCard Id="@nurse.Id"
                                          Image="@nurse.Image"
                                          FullName="@nurse.FullName"
                                          Email="@nurse.Email"
                                          Phone="@nurse.PhoneNumber"
                                          CanEdit="hasActionRights"
                                          CanDelete="hasActionRights"
                                          Edit="() => EditNurse(nurse.Id)"
                                          Delete="() => ConfirmDelete(nurse.Id)" />
                            </div>
                        </div>
                    </Virtualize>
                </div>
            }
        }
        else if (selectedView == "Grid")
        {
            <BeHealthyTable TItem="NurseDto"
                            Items="@nurses"
                            TableClass="table table-responsive"
                            WrapperClass="table-wrapper"
                            EmptyMessage="@string.Format(Resource.NoAvailable, Resource.Nurses)"
                            CurrentSortProperty="@QueryParameters.OrderBy"
                            IsSortDescending="@QueryParameters.OrderDescending"
                            OnSortChanged="HandleSortChanged" >

                <BeHealthyColumn TItem="NurseDto">
                    <Template>
                        @if (hasActionRights)
                        {
                            <input type="checkbox"
                                   class="form-check-input"
                                   checked="@selectedNurseIds.Contains(context.Id)"
                                   @onchange="@(() => ToggleNurseSelection(context.Id))"
                                   @onclick:stopPropagation="true" />
                        }
                    </Template>
                </BeHealthyColumn>
                                
                <BeHealthyColumn TItem="NurseDto">
                    <Template>
                        <img class="rounded-circle"
                             src="@(context.Image ?? "images/generic.jpg")"
                             alt="@context.FullName"
                             width="25"
                             height="25" />
                    </Template>
                </BeHealthyColumn>

                <BeHealthyColumn TItem="NurseDto"
                                 Title="@Resource.FirstName"
                                 Property="@(x => x.FirstName)"
                                 Sortable="true"
                                 SortProperty="FirstName" />

                <BeHealthyColumn TItem="NurseDto"
                                 Title="@Resource.LastName"
                                 Property="@(x => x.LastName)"
                                 Sortable="true"
                                 SortProperty="LastName" />

                <BeHealthyColumn TItem="NurseDto"
                                 Title="@Resource.Created"
                                 Property="@(x => x.CreatedAt.ToFullDateTimeString())"
                                 Sortable="true"
                                 SortProperty="CreatedAt" />

                <BeHealthyColumn TItem="NurseDto"
                                 Title="@Resource.Email"
                                 Property="@(x => x.Email)"/>

                <BeHealthyColumn TItem="NurseDto"
                                 Title="@Resource.PhoneNumber"
                                 Property="@(x => x.PhoneNumber)"/>
            
                @if (hasActionRights)
                {
                    <BeHealthyActionsColumn TItem="NurseDto"
                                            Title="@Resource.Actions"
                                            CellClass="text-end">
                        <Template>
                            <div class="d-flex justify-content-end">
                                <button class="btn"
                                        title="@(Resource.Edit)"
                                    @onclick="@(() => EditNurse(context.Id))"
                                        @onclick:stopPropagation="true">
                                    <Icon IconClass="@FAIcon.EditSquare" TextClass="text-warning" />
                                </button>
                                <button class="btn"
                                        title="@(Resource.Delete)"
                                        @onclick="() => ConfirmDelete(context.Id)"
                                        @onclick:stopPropagation="true">
                                    <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />
                                </button>
                            </div>
                        </Template>
                    </BeHealthyActionsColumn>
                }
            </BeHealthyTable>
        }
    </Body>
    <Footer>
        <BeHealthyPaginator CurrentPage="@QueryParameters.PageNumber"
                            PageSize="@QueryParameters.PageSize"
                            TotalItems="@totalCount"
                            CurrentPageChanged="@HandlePageChanged"
                            PageSizeChanged="@HandlePageSizeChanged" />
    </Footer>
</BeHealthyCard>
    