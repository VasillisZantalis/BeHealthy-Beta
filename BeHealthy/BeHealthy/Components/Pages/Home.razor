@page "/"

@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>@Resource.Dashboard</PageTitle>

<SectionContent SectionName="page-title">@Resource.Dashboard</SectionContent>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-6 col-md-6 col-lg-4 col-xl-2">
            <TotalDoctors />
        </div>
        <div class="col-6 col-md-6 col-lg-4 col-xl-2">
            <TotalNurses />
        </div>
        <div class="col-6 col-md-6 col-lg-4 col-xl-2">
            <TotalPatients />
        </div>
    </div>
    <div class="row">
        <div class="col-12 col-md-12 col-lg-8 my-sm-2 my-md-2 my-lg-0">
            <UpcomingAppointments />
        </div>
        <div class="col-12 col-md-12 col-lg-4 my-sm-2 my-md-2 my-lg-0">
            <RecentlyAddedPatients />
        </div>
    </div>
</div>
