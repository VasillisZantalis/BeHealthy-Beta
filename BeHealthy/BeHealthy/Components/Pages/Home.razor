@page "/"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

<PageTitle>@Resource.Dashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12 col-xl-6">
            <div class="d-flex flex-column flex-md-row justify-content-between">
                <TotalDoctors />
                <TotalNurses />
                <TotalPatients />
            </div>
            @if (_isAdminUser)
            {
                <UserDistributionChart />
            }
            <UpcomingAppointments />
            <RecentlyAddedPatients />
        </div>
        <div class="col-12 col-xl-6">
            <Calendar />
            @if (_isAdminUser)
            {
                <ReasonOfAppointmentsChart />
            }
        </div>
    </div>
    <div class="row">
    </div>
</div>
