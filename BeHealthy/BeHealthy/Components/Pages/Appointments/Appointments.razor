@page "/appointments"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

<div class="mb-3">
    <CreateButton OnClick="() => _appointmentModal.Open()" />
    <MassImportButton OnClick="ShowImportWizard" />
</div>

@if (showWizard)
{
    <MassImportWizard TEntity="AppointmentCreateDto"
                      OnSave="BulkCreateAppointments"
                      Entity="@(ImportEntity.Appointment)"
                      OnClose="HideImportWizard" />
}

@if (_appointments is null || !_appointments.Any())
{
    <p>@string.Format(Resource.NoAvailable, Resource.Appointments)</p>
}
else
{
    <div class="appointmentsTableDiv mt-3">
        <div class="card">
            <div class="card-header d-flex flex-row justify-content-end">
                <div class="px-1">
                    <InputSelect class="form-select form-select-sm" @bind-Value="_paginationState.ItemsPerPage">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </InputSelect>
                </div>
            </div>
            <div class="table-responsive">
                <div class="card-body pb-2 px-0 m-0">
                    <QuickGrid Class="table rounded"
                               Items="@_appointments.AsQueryable()"
                               ItemKey="@(x => x.Id)"
                               Pagination="_paginationState">
                        <PropertyColumn Title="@Resource.Date"
                                        Property="@(x => x.AppointmentDate)"
                                        Format="dd MMM yyyy"
                                        Sortable="true"
                                        IsDefaultSortColumn="true"
                                        InitialSortDirection="SortDirection.Descending" />
                        <PropertyColumn Title="@Resource.Notes"
                                        Property="@(x => string.IsNullOrEmpty(x.Notes) ? "-" : x.Notes)" />
                        <PropertyColumn Title="@Resource.Patient"
                                        Property="@(x => x.Patient != null ? x.Patient.FullName : string.Empty)"
                                        Sortable="true" />
                        <PropertyColumn Title="@Resource.Doctor"
                                        Property="@(x => x.Doctor != null ? x.Doctor.FullName : string.Empty)"
                                        Sortable="true" />
                        <PropertyColumn Title="@Resource.Room"
                                        Property="@(x => x.Room != null ? x.Room.Name : string.Empty)"
                                        Sortable="true" />
                        <PropertyColumn Title="@Resource.StartTime"
                                        Property="@(x => x.AppointmentStartTime)" />
                        <PropertyColumn Title="@Resource.EndTime"
                                        Property="@(x => x.AppointmentEndTime)"/>
                        <PropertyColumn Title="@Resource.Reason"
                                        Property="@(x => x.Reason.ToLocalizedString())" />
                        <TemplateColumn Title="@Resource.Status"
                                        TGridItem="AppointmentDto">
                            <span class="badge @context.Status.GetBadgeClass()">
                                @context.Status.ToLocalizedString()
                            </span>
                        </TemplateColumn>

                        @if (hasActionRights)
                        {
                            <TemplateColumn Title="@Resource.Actions" Align="Align.End">
                                <div class="d-flex justify-content-end">
                                    @if (hasEditRight)
                                    {
                                        <button class="btn" title="@(Resource.Edit)" @onclick="@(() => EditAppointment(context.Id))">
                                            <Icon IconClass="@FAIcon.EditSquare" TextClass="text-warning"/>
                                        </button>
                                    }
                                    @if (hasDeleteRight)
                                    {
                                        <button class="btn" title="@(Resource.Delete)" @onclick="() => ConfirmDelete(context.Id)">
                                            <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger"/>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>
                        }
                    </QuickGrid>

                </div>

            </div>
            <div id="paginatorDiv" class="px-3">
                <Paginator State="_paginationState" />
            </div>
        </div>
    </div>
}

@if (_doctors != null && _patients != null)
{
    <AppointmentModal @ref="_appointmentModal"
                      OnFormSubmit="HandleAppointmentFormSubmission"
                      Doctors="_doctors"
                      Patients="_patients"
                      Role="userRole"
                      CurrentUserId="@_currentUserId" 
                      AppointmentId="_appointmentId"/>
}
