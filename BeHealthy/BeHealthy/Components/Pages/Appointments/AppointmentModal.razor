<div class="modal" tabindex="-1" style="@(_show ? "display:block" : "display:none")">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(_isEdit ? "Edit Appointment" : "Create Appointment")</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                @if (Doctors is null || Patients is null)
                {
                    <Loader />
                }
                else
                {
                    <EditForm FormName="AppointmentForm" OnValidSubmit="HandleSaveClick" Model="_appointmentDto">
                        <DataAnnotationsValidator />
                        <div class="d-flex flex-column gap-3">

                            <div class="row">

                                <div class="form-group col-12 col-sm-6">
                                    <label class="fw-bold" for="patientIdSelect">Patient</label>
                                    <InputSelect id="patientIdSelect" class="form-select" @bind-Value="_appointmentDto.PatientId">
                                        @foreach (var patient in Patients)
                                        {
                                            <option value="@patient.Id">@patient.FullName</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _appointmentDto.PatientId)" />
                                </div>

                                <div class="form-group col-12 col-sm-6">
                                    <label class="fw-bold" for="doctorIdSelect">Doctor</label>
                                    <InputSelect id="doctorIdSelect" class="form-select" @bind-Value="_appointmentDto.DoctorId" disabled="@LockDoctorsDropdown">
                                        @foreach (var doctor in Doctors)
                                        {
                                            <option value="@doctor.Id">@doctor.FullName</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _appointmentDto.DoctorId)" />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="fw-bold" for="appointmentDate">Appointment Date</label>
                                <InputDate id="appointmentDate" class="form-control" @bind-Value="_appointmentDto.AppointmentDate" />
                                <ValidationMessage For="@(() => _appointmentDto.AppointmentDate)" />
                            </div>

                            <div class="form-group">
                                <div class="row mb-3">
                                    <div class="col">
                                        <label class="fw-bold" for="appointmentHour">Hour</label>
                                        <InputNumber id="appointmentHour"
                                                     @bind-Value="AppointmentHour"
                                                     TValue="int"
                                                     min="0"
                                                     max="23"
                                                     class="form-control"
                                                     placeholder="HH" />
                                    </div>
                                    <div class="col">
                                        <label class="fw-bold" for="appointmentMinute">Minutes</label>
                                        <InputNumber id="appointmentMinute"
                                                     @bind-Value="AppointmentMinute"
                                                     TValue="int"
                                                     min="0"
                                                     max="59"
                                                     class="form-control"
                                                     placeholder="MM" />
                                    </div>
                                </div>
                            </div>

                            @if (_isEdit)
                            {
                                <div class="form-group">
                                    <label class="fw-bold" for="status">Status</label>
                                    <InputSelect id="status" @bind-Value="_appointmentDto.Status" class="form-select">
                                        @foreach (var status in Enum.GetValues(typeof(AppointmentStatus)).Cast<AppointmentStatus>())
                                        {
                                            if (status != AppointmentStatus.Scheduled)
                                            {
                                                <option value="@status">@status.GetDisplayName()</option>
                                            }
                                        }
                                    </InputSelect>
                                </div>
                            }
                            <div class="form-group">
                                <label class="fw-bold" for="duration">Duration(min)</label>
                                <InputNumber id="duration"
                                             @bind-Value="_appointmentDto.Duration"
                                             TValue="int"
                                             min="0"
                                             class="form-control"/>
                            </div>

                            <div class="form-group">
                                <label class="fw-bold" for="reason">Reason</label>
                                <InputSelect id="reason" @bind-Value="_appointmentDto.Reason" class="form-select">
                                    @foreach (var reason in Enum.GetValues(typeof(AppointmentReason)).Cast<AppointmentReason>())
                                    {
                                        <option value="@reason">@reason.GetDisplayName()</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => _appointmentDto.Reason" class="text-danger" />
                            </div>

                            <div class="form-group">
                                <label class="fw-bold" for="notes">Notes</label>
                                <InputTextArea id="notes" class="form-control" @bind-Value="_appointmentDto.Notes" style="resize: none;" />
                            </div>

                            <div class="d-flex flex-row justify-content-end">
                                <button type="button" class="btn btn-outline-secondary px-4 me-2" @onclick="Close">Close</button>
                                <button type="submit" class="btn btn-success px-4">Save</button>
                            </div>
                        </div>

                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>
@if (_show)
{
    <div class="modal-backdrop fade show"></div>
}