@page "/profile"
@using BeHealthy.Application.Dtos.User
@using BeHealthy.Application.Validations.User
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject UserManager<ApplicationUser> UserManager
@inject IDoctorService DoctorService
@inject INurseService NurseService
@inject IPatientService PatientService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@Resource.Profile</PageTitle>

<BeHealthyCard BodyClass="p-3">
    <Body>
        <EditForm id="profileForm" Model="profileDto" OnValidSubmit="UpdateProfile">

            <button type="submit" class="btn btn-success px-5 d-flex flex-row" disabled="@inProgress">
                @if (inProgress)
                {
                    <SmallLoader />
                }
                <span>@Resource.Save</span>
            </button>

            <ValidationComponent @ref="validationComponent" />

            <div class="mt-3 d-flex flex-column gap-3">

                @if (userRole != UserRole.Admin)
                {
                    <ImageUploadContainer OnOpenImageUploadModal="OpenImageUploadModal" HasImage="@(profileDto.Image != null)" OnDeleteImage="@(() => profileDto.Image = null)">
                        <ImagePreview ImageUrl="@profileDto.Image" />
                    </ImageUploadContainer>
                }

                <BeHealthyFormGroup Label="@Resource.FirstName" IsRequired="true" InputId="firstName">
                    <InputText id="firstName"
                                @bind-Value="profileDto.FirstName"
                                class="form-control"
                                aria-required="true" />

                    <ValidationMessage For="() => profileDto.FirstName" class="text-danger" />
                </BeHealthyFormGroup>

                <BeHealthyFormGroup Label="@Resource.LastName" IsRequired="true" InputId="lastName">
                    <InputText id="lastName"
                                @bind-Value="profileDto.LastName"
                                class="form-control"
                                aria-required="true" />

                    <ValidationMessage For="() => profileDto.LastName" class="text-danger" />
                </BeHealthyFormGroup>

                <BeHealthyFormGroup Label="@Resource.Email" InputId="email">
                    <InputText id="email"
                                @bind-Value="profileDto.Email"
                                class="form-control"
                                aria-required="true"
                                disabled/>
                </BeHealthyFormGroup>
            </div>
        </EditForm>
    </Body>
</BeHealthyCard>

@code {
    private ProfileDto profileDto { get; set; } = new();
    private ApplicationUser? user { get; set; }
    private ValidationComponent? validationComponent;
    private UserRole? userRole;
    private string? userId;
    private bool inProgress = false;

    protected override void OnInitialized()
    {
        SetBreadcrumbs();
    }

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.GetUserId() ?? string.Empty;

        user = await UserService.GetUserByIdAsync(userId);

        if (user is null)
            NavigationManager.NavigateTo(RoutingEndpoints.HOME_PAGE);

        userRole = authState.User.GetUserRoleEnum();

        switch (userRole)
        {
            case UserRole.Doctor when userId is not null:
                profileDto = await GetDoctorProfileByUserId(userId);
                break;
            case UserRole.Nurse when userId is not null:
                profileDto = await GetNurseProfileByUserId(userId);
                break;
            case UserRole.Patient when userId is not null:
                profileDto = await GetPatientProfileByUserId(userId);
                break;
            default:
                profileDto.UserId = user!.Id;
                profileDto.FirstName = user!.FirstName;
                profileDto.LastName = user!.LastName;
                profileDto.PhoneNumber = user!.PhoneNumber;
                profileDto.Email = user!.Email;
                break;
        }

        IsLoading = false;
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        {
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Profile, Link = string.Empty, Active = true },
        });
    }

    private void OpenImageUploadModal()
    {
        ModalService.Show<FileUploadModal>(new Dictionary<string, object?>
        {
            { nameof(FileUploadModal.IsImage), true },
            { nameof(FileUploadModal.MaxFileSizeInKB), 1024 },
            { nameof(FileUploadModal.ResizeWidth), 200 },
            { nameof(FileUploadModal.ResizeHeight), 200 },
            { nameof(FileUploadModal.OnFileUploaded), EventCallback.Factory.Create<string>(this, HandleImageUploaded) }
        });
    }

    private void HandleImageUploaded(string imageData)
    {
        profileDto.Image = imageData;
        StateHasChanged();
    }

    private async Task<ProfileDto> GetDoctorProfileByUserId(string userId) 
        => await DoctorService.GetDoctorProfileByUserIdAsync(userId) ?? new();

    private async Task<ProfileDto> GetPatientProfileByUserId(string userId) 
        => await PatientService.GetPatientProfileByUserIdAsync(userId) ?? new();

    private async Task<ProfileDto> GetNurseProfileByUserId(string userId) 
        => await NurseService.GetNurseProfileByUserIdAsync(userId) ?? new();

    private async Task UpdateProfile()
    {
        inProgress = true;
        validationComponent?.ClearErrors();

        var validator = new ProfileDtoValidator();
        var validationResult = await validator.ValidateAsync(profileDto);

        if (!validationResult.IsValid)
        {
            var errors = validationResult.GetErrorsGroupedByProperty();
            validationComponent?.DisplayErrors(errors);
            inProgress = false;
            return;
        }

        ServiceResponse? response = null;

        switch (userRole)
        {
            case UserRole.Doctor:
                var doctorForUpdate = profileDto.MapToDoctorForUpdateDto();
                response = await DoctorService.UpdateDoctorAsync(doctorForUpdate);
                break;
            case UserRole.Nurse:
                var nurseUpdate = profileDto.MapToNurseForUpdateDto();
                response = await NurseService.UpdateNurseAsync(nurseUpdate);
                break;
            case UserRole.Patient:
                var patientUpdate = profileDto.MapToPatientForUpdateDto();
                response = await PatientService.UpdatePatientAsync(patientUpdate);
                break;
            case UserRole.Admin:
                var userUpdate = profileDto.MapToUserForUpdateDto(user!);
                response = await UserService.UpdateUserAsync(userUpdate);
                break;
        }

        inProgress = false;

        if (response is null || !response.Success)
        {
            var errorMessage = response?.ErrorMessage ?? Resource.SomethingWentWrong;
            await ToastService.EnqueueToastAsync(errorMessage, "error");
            return;
        }

        await ToastService.EnqueueToastAsync(Resource.Success, "success");
        NavigationManager.Refresh(true);
    }
}
