@page "/profile"
@using BeHealthy.Application.Dtos.User
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject UserManager<ApplicationUser> UserManager
@inject IDoctorService DoctorService
@inject INurseService NurseService
@inject IPatientService PatientServic
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@Resource.Profile</PageTitle>

<div id="profile-container" class="container-fluid p-5 border rounded shadow">
    <EditForm id="profileForm" Model="profileDto" OnValidSubmit="UpdateProfile">
        <div>
            <button type="submit" class="btn btn-success px-5">@Resource.Save</button>
        </div>
        <div class="row">
            <ImagePreview ImageUrl="@profileDto.Image" />
            <ImageUpload OnImageChanged="image => profileDto.Image = image" />
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="profileDto.FirstName" class="form-control" aria-required="true" id="firstName" placeholder="First Name" />
                    <label for="firstName">@Resource.FirstName</label>
                </div>
            </div>
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="profileDto.LastName" class="form-control" autocomplete="username" aria-required="true" id="lastName" placeholder="Last Name" />
                    <label for="lastName">@Resource.LastName</label>
                </div>
            </div>
        </div>
    </EditForm>
</div>

@code {
    private ProfileDto profileDto { get; set; } = new();
    private UserRole? userRole;
    private string? userId;

    protected override void OnInitialized()
    {
        SetBreadcrumbs();
    }

    protected override async Task OnInitializedAsync()
    {
        LoaderService.SetLoader(true);

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.GetUserId() ?? string.Empty;

        var user = await UserManager.FindByIdAsync(userId);

        if (user is null)
            NavigationManager.NavigateTo(RoutingEndpoints.HOME_PAGE);

        userRole = authState.User.GetUserRoleEnum();

        switch (userRole)
        {
            case UserRole.Doctor when userId is not null:
                profileDto = await GetDoctorProfileByUserId(userId);
                break;
            case UserRole.Nurse when userId is not null:
                break;
            case UserRole.Patient when userId is not null:
                break;
            default:
                break;
        }

        LoaderService.SetLoader(false);
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        {
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Profile, Link = string.Empty, Active = true },
        });
    }

    private async Task<ProfileDto> GetDoctorProfileByUserId(string userId) => await DoctorService.GetDoctorProfileByUserIdAsync(userId) ?? new();

    private async Task UpdateProfile()
    {
        var user = await UserManager.FindByIdAsync(userId ?? string.Empty);

        if (user != null)
        {
            user.FirstName = profileDto.FirstName;
            user.LastName = profileDto.LastName;
            user.PhoneNumber = profileDto.PhoneNumber;

            var result = await UserManager.UpdateAsync(user);

            if (!result.Succeeded)
            {
                //inProgress = false;
                //alert.ShowSuccess(Resource.SomethingWentWrong);
            }
            else
            {
                switch (userRole)
                {
                    case UserRole.Doctor:
                        var doctorForUpdate = profileDto.MapToDoctorForUpdateDto();
                        await DoctorService.UpdateDoctorAsync(doctorForUpdate);
                        break;
                    case UserRole.Nurse:
                        AlertModalStateService.Show(null, "Not implemented yet", false);
                        break;
                    case UserRole.Patient:
                        AlertModalStateService.Show(null, "Not implemented yet", false);
                        break;
                    default:
                        AlertModalStateService.Show(null, "Not implemented yet", false);
                        break;
                }
            }
        }
    }
}
