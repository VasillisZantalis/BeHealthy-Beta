@page "/settings"
@using BeHealthy.Components.Layout
@using BeHealthy.Components.Pages.Settings.Components
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

<PageTitle>@Resource.Settings</PageTitle>

@if (_settingsGroupedByArea is not null)
{
    foreach (var areaGroup in _settingsGroupedByArea)
    {
        <div class="mb-3">
            <h4>@areaGroup.Key</h4>
            @foreach (var setting in areaGroup)
            {
                <SettingInput Setting="setting" OnSettingChanged="UpdateSettingValue" SelectItems="_doctorsSelect"/>                
            }
        </div>
    }
}

