@page "/settings"
@using BeHealthy.Components.Layout
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

<PageTitle>@Resource.Settings</PageTitle>

@if (_settingsGroupedByArea is not null)
{
    foreach (var areaGroup in _settingsGroupedByArea)
    {
        <div class="mb-3">
            <h4>@areaGroup.Key</h4>
            @foreach (var setting in areaGroup)
            {
                <div class="form-group w-100 p-3 border rounded-3 mb-2">
                    <div class="d-flex flex-row justify-content-between">
                        <div>
                            <span title="@setting.Description">
                                <Icon IconClass="@FAIcon.CircleInfo"
                                        TextClass="text-info"/>
                            </span>
                            <span>@setting.Caption</span>
                        </div>
                        @switch (setting.Type)
                        {
                            case SettingType.TextField:
                                <input type="text" value="@setting.Value" />
                                break;
                            case SettingType.Checkbox:
                                <input type="checkbox" checked="@Convert.ToBoolean(setting.Value)" class="form-check-input" @onchange="e => UpdateSettingValue(setting, e.Value.ToString())"/>
                                break;
                            case SettingType.SingleSelect:
                                <select class="form-select" @onchange="e => UpdateSettingValue(setting, e.Value.ToString())">
                                    @if (setting.Key == "DefaultDepartmentSupervison")
                                    {
                                        @foreach (var doctor in _doctorsSelect)
                                        {
                                            <option value="@doctor.Value"
                                                    selected="@(doctor.Value.ToString() == setting.Value)">
                                                @doctor.Text
                                            </option>
                                        }
                                    }
                                </select>
                                break;
                        }
                    </div>
                </div>
            }
        </div>
    }
}

