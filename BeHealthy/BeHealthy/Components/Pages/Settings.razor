@page "/settings"
@using BeHealthy.Components.Layout
@attribute [Authorize(Roles = "Admin")]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

<PageTitle>@Resource.Settings</PageTitle>

@if (_settingsGroupedByArea is not null)
{
    foreach (var areaGroup in _settingsGroupedByArea)
    {
        <div class="mb-3">
            <h4>@areaGroup.Key</h4>
            <div class="settings-area card p-5 border rounded-4 shadow-sm">
                @foreach (var setting in areaGroup)
                {
                    <div class="form-group w-100 p-3 border rounded-3 mb-2">
                        <div class="d-flex flex-row justify-content-between">
                            <div>
                                <span title="@setting.Description">
                                    <Icon IconClass="@FAIcon.CircleInfo"
                                          TextClass="text-info"/>
                                </span>
                                <span>@setting.Name</span>
                            </div>
                            @switch (setting.Type)
                            {
                                case SettingType.TextField:
                                    <input type="text" value="@setting.Value" />
                                    break;
                                case SettingType.Checkbox:
                                    <input type="checkbox" checked="@Convert.ToBoolean(setting.Value)" class="form-check-input" @onchange="e => UpdateSettingValue(setting, e.Value.ToString())"/>
                                    break;
                                @* case SettingType.SingleSelect:
                                    <select @onchange="e => UpdateSettingValue(setting, e.Value.ToString())">
                                        @foreach (var option in GetOptionsForSetting(setting))
                                        {
                                            <option value="@option" selected="@option == setting.Value">@option</option>
                                        }
                                    </select>
                                    break; *@
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* <div class="mb-3">
            <h4>@areaGroup.Key</h4>
            @foreach (var setting in areaGroup)
            {
                <div class="form-group w-100 p-3 border shadow-sm rounded-3 mb-2">
                    <div class="d-flex flex-row justify-content-between px-5">
                        <div>
                            <label>@setting.Name</label>
                        </div>

                        <div>
                            @switch (setting.Type)
                            {
                                case SettingType.Checkbox:
                                    <InputCheckbox @bind-Value="setting.BoolValue" class="form-check-input" />
                                    break;

                                case SettingType.SingleSelect:
                                    <InputSelect @bind-Value="setting.StringValue" class="form-select">
                                        @foreach (var option in Enum.GetValues(typeof(LanguageOptions)))
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </InputSelect>
                                    break;

                                case SettingType.MultiSelect:
                                    <!-- Implement MultiSelect logic here -->
                                    break;

                                case SettingType.TextField:
                                    <InputText @bind-Value="setting.StringValue" />
                                    break;

                                default:
                                    <p>Unknown setting type.</p>
                                    break;
                            }
                        </div>
                    </div>
                </div>
            }

        </div> *@
    }
}

