@page "/rooms"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IRoomService RoomService
@inject NavigationManager NavigationManager

<PageTitle>@Resource.Rooms</PageTitle>

<CreateButton OnClick="CreateRoom" />

<UpsertModal @ref="roomUpsertModal"
             RoomId="roomId" />

@if (rooms is null || !rooms.Any())
{
    <p>@string.Format(Resource.NoAvailable, Resource.Rooms)</p>
}
else
{
    <div class="departments-container mt-3">
        <div class="card">
            <div class="card-header d-flex flex-row justify-content-end">
                <div class="px-1">
                    <InputSelect class="form-select form-select-sm" @bind-Value="paginationState.ItemsPerPage">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </InputSelect>
                </div>
            </div>
            <div class="table-responsive">
                <div class="card-body pb-2 px-0 m-0">
                    <QuickGrid Class="table rounded"
                                Items="@rooms.AsQueryable()"
                                ItemKey="@(x => x.Id)"
                    Pagination="paginationState">
                        <PropertyColumn Title="@Resource.Name"
                                        Property="@(x => x.Name)" 
                                        Sortable="true"/>
                        <PropertyColumn Title="@Resource.Number"
                                        Property="@(x => x.Number)" />
                        <PropertyColumn Title="@Resource.Department"
                                        Property="@(x => x.Department)"
                                        Sortable="true" />
                        <TemplateColumn Title="@Resource.Actions" Align="Align.End">
                            <div class="d-flex justify-content-end">
                                <button class="btn" @onclick="() => EditRoom(context.Id)">
                                    <Icon IconClass="@FAIcon.EditSquare" TextClass="text-warning" />
                                </button>
                                <button class="btn" @onclick="async () => await DeleteRoom(context.Id)">
                                    <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />
                                </button>
                            </div>
                        </TemplateColumn>
                    </QuickGrid>

                </div>

            </div>
            <div id="paginatorDiv" class="px-3">
                <Paginator State="paginationState" />
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<RoomDto> rooms = default!;

    private PaginationState paginationState = new();
    private int? roomId;
    private UpsertModal roomUpsertModal = new();

    protected override void OnInitialized()
    {
        SetBreadcrumbs();
    }

    protected override async Task OnInitializedAsync()
    {
        LoaderService.SetLoader(true);

        rooms = await RoomService.GetAllRoomsAsync();
        paginationState.ItemsPerPage = rooms.Count();

        LoaderService.SetLoader(false);
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        {
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Rooms, Link = string.Empty, Active = true },
        });
    }

    private void CreateRoom()
    {
        roomId = null;
        roomUpsertModal.OpenModal();
    }

    private void EditRoom(int roomId)
    {
        roomId = roomId;
        roomUpsertModal.OpenModal();
    }

    public async Task DeleteRoom(int roomId)
    {
        ModalService.Show<ConfirmDeleteModal>(
           new Dictionary<string, object?>
           {
               { nameof(ConfirmDeleteModal.OnConfirm), () => OnConfirmDeleteAsync(roomId) }
           });
    }

    private async Task OnConfirmDeleteAsync(int roomId)
    {
        await RoomService.DeleteRoomAsync(roomId);
        NavigationManager.Refresh(true);
    }
}
