@page "/rooms"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@inject IRoomService RoomService

<PageTitle>@Resource.Rooms</PageTitle>

<SectionContent SectionName="page-title">@Resource.Rooms</SectionContent>

@if (_rooms == null)
{
    <Loader />
}
else if (_rooms is null)
{
    <p>@string.Format(Resource.NoAvailable, Resource.Rooms)</p>
}
else
{
    
}

@code {
    private IEnumerable<RoomDto> _rooms = default!;

    protected override async Task OnInitializedAsync()
    {
        _rooms = await RoomService.GetAllRoomsAsync();
    }
}
