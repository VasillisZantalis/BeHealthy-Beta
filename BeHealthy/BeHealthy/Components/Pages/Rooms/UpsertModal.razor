@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IRoomService RoomService
@inject IDepartmentService DepartmentService
@inject NavigationManager NavigationManager

@if (_showModal)
{
    <div class="modal fade show" tabindex="-1" style="display: block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title">@ModalTitle</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_roomDto" FormName="RoomForl" OnValidSubmit="SaveRoom">
                        <DataAnnotationsValidator />

                        <div class="d-flex flex-column gap-3">
                            <div class="form">
                                <label class="fw-bold" for="name">@Resource.Name</label>
                                <InputText id="name" class="form-control" @bind-Value="_roomDto.Name" />
                                <ValidationMessage For="@(() => _roomDto.Name)" />
                            </div>
                            <div class="form">
                                <label class="fw-bold" for="number">@Resource.Number</label>
                                <InputNumber id="number" class="form-control" @bind-Value="_roomDto.Number" />
                                <ValidationMessage For="@(() => _roomDto.Number)" />
                            </div>
                            <div class="">
                                <label class="fw-bold" for="doctorIdSelect">@Resource.Department</label>
                                <InputSelect id="doctorIdSelect" class="form-select" @bind-Value="_roomDto.DepartmentId">
                                    @foreach (var department in _departmentSelect)
                                    {
                                        <option value="@department.Value">@department.Text</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _roomDto.DepartmentId)" />
                            </div>
                        </div>
                        <div class="d-flex flex-row justify-content-end m-3 gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CloseModal">@Resource.Cancel</button>
                            <button type="submit" class="btn btn-success">@Resource.Save</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter, EditorRequired]
    public int? RoomId { get; set; }

    [SupplyParameterFromForm]
    private RoomDto _roomDto { get; set; } = new();

    private bool _showModal = false;
    private bool _isEditMode => RoomId.HasValue;
    private string ModalTitle => _isEditMode ? Resource.Edit : Resource.Create;
    private List<DepartmentDto> _departments { get; set; } = new();
    private List<SelectItem> _departmentSelect = new();

    protected override async Task OnInitializedAsync()
    {
        LoaderService.SetLoader(true);
        _departments = (await DepartmentService.GetAllDepartmentsAsync()).ToList();

        _departmentSelect = _departments.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();

        LoaderService.SetLoader(false);
    }

    protected override async Task OnParametersSetAsync()
    {
        _roomDto = new();

        if (_isEditMode && RoomId.HasValue)
        {
            _roomDto = await RoomService.GetRoomByIdAsync(RoomId.Value);
        }
    }

    public void OpenModal()
    {
        _showModal = true;
        StateHasChanged();
    }

    public void CloseModal()
    {
        _showModal = false;
        NavigationManager.Refresh(true);
        StateHasChanged();
    }

    private async Task SaveRoom()
    {
        if (_isEditMode && RoomId.HasValue)
        {
            var roomForUpdate = _roomDto.MapDtoToUpdateDto();
            await RoomService.UpdateRoomAsync(roomForUpdate.Id, roomForUpdate);
        }
        else 
        {
            var roomForCreation = _roomDto.MapDtoToCreateDto();
            await RoomService.AddRoomAsync(roomForCreation);
        }

        await ToastrStateService.ShowSuccess(Resource.Success);
    }
}
