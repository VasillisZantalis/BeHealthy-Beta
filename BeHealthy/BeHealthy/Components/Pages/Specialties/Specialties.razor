@page "/specialties"
@using BeHealthy.Application.Dtos.Specialty
@rendermode @(new InteractiveServerRenderMode(false))
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@inherits BasePage

@inject NavigationManager NavigationManager
@inject ISpecialtyService SpecialtyService

<BeHealthyCard HeaderClass="d-flex justify-content-between align-items-center flex-wrap">
    <Header>
        <CreateButton OnClick="CreateSpecialty" />
    </Header>
    
    <Body>
        <BeHealthyTable TItem="SpecialtyDto"
                        Items="@specialties"
                        IsLoading="isLoading"
                        TableClass="table table-responsive"
                        WrapperClass="table-wrapper"
                        EmptyMessage="@string.Format(Resource.NoAvailable, Resource.Specialties)">

            <BeHealthyColumn TItem="SpecialtyDto"
                             Title="#"
                             Property="@(x => specialties.IndexOf(x))" />

            <BeHealthyColumn TItem="SpecialtyDto"
                             Title="@Resource.Name"
                             Property="@(x => x.Name)" />

            <BeHealthyActionsColumn TItem="SpecialtyDto"
                                    Title="@Resource.Actions"
                                    CellClass="text-end">
                <Template>
                    <div class="d-flex justify-content-end">
                        <button class="btn"
                                title="@(Resource.Edit)"
                                @onclick="@(() => EditSpecialty(context.Id))"
                                @onclick:stopPropagation="true">
                            <Icon IconClass="@FAIcon.EditSquare" TextClass="text-warning" />
                        </button>
                        <button class="btn"
                                title="@(Resource.Delete)"
                                @onclick="async () => await ConfirmDelete(context.Id)"
                                @onclick:stopPropagation="true">
                            <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />
                        </button>
                    </div>
                </Template>
            </BeHealthyActionsColumn>
        </BeHealthyTable>
    </Body>
</BeHealthyCard>

@code {
    private List<SpecialtyDto> specialties { get; set; } = new();
    private bool isLoading = false;
    private int? specialtyId;

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs();
        await LoadSpecialties();
    }

    private async Task LoadSpecialties()
    {
        isLoading = true;
        specialties = (await SpecialtyService.GetSpecialtiesAsync()).ToList();
        isLoading = false;
        StateHasChanged();
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>
        {
            new Breadcrumb() { Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb() { Text = Resource.Specialties, Link = string.Empty, Active = true },
        });
    }

    private void CreateSpecialty()
    {
        ShowSpecialtyModal(null);
    }

    private void EditSpecialty(int specialtyId)
    {
        ShowSpecialtyModal(specialtyId);
    }

    private void ShowSpecialtyModal(int? specialtyId)
    {
        var specialty = specialties.FirstOrDefault(s => s.Id == specialtyId) ?? new();

        ModalService.Show<UpsertModal>(
           new Dictionary<string, object?>
           {
               { nameof(UpsertModal.Specialty), specialty },
               { nameof(UpsertModal.OnSpecialtySaved), EventCallback.Factory.Create<SpecialtyDto>(this, HandleResponse) }
           });
    }

    private async Task ConfirmDelete(int specialtyId)
    {
        ModalService.Show<ConfirmDeleteModal>(
           new Dictionary<string, object?>
           {
               { nameof(ConfirmDeleteModal.OnConfirm), () => OnConfirmDeleteAsync(specialtyId) }
           });
    }

    private async Task OnConfirmDeleteAsync(int specialtyId)
    {
        await SpecialtyService.DeleteSpecialtyAsync(specialtyId);
        await LoadSpecialties();
    }

    private async Task HandleResponse(SpecialtyDto specialtyDto)
    {
        isLoading = true;
        if (specialtyDto.Id > 0)
        {
            var specialtyForUpdateDto = new SpecialtyUpdateDto
            {
                Id = specialtyDto.Id,
                Name = specialtyDto.Name
            };
            await SpecialtyService.UpdateSpecialtyAsync(specialtyForUpdateDto);
        }
        else
        {
            var specialtyForCreationDto = new SpecialtyCreateDto
            {
                Name = specialtyDto.Name
            };
            await SpecialtyService.AddSpecialtyAsync(specialtyForCreationDto);
        }
        isLoading = false;
        ToastService.ShowToast(Resource.Success, "success");
        await LoadSpecialties();
    }
}