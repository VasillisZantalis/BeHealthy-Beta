@using ChartJs.Blazor.BarChart
@using ChartJs.Blazor.BarChart.Axes
@using ChartJs.Blazor.Common
@using ChartJs.Blazor.Common.Axes
@using ChartJs.Blazor.Common.Axes.Ticks
@using ChartJs.Blazor.Util
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IAppointmentService AppointmentService

@if (_config != null)
{
    <div class="card border-0 rounded shadow mt-3">
        <Chart Config="_config"></Chart>
    </div>
}

@code {
    private BarConfig? _config;
    private Dictionary<AppointmentReason, int> _appointmentsByReasonCount = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            LoaderService.SetLoader(true);

            _config = new BarConfig
            {
                Options = new BarOptions
                {
                    Responsive = true,
                    Title = new OptionsTitle
                    {
                        Display = true,
                        Text = Resource.AppointmentsByReason
                    },
                    Scales = new BarScales
                    {
                        XAxes = new List<CartesianAxis>
                        {
                            new BarCategoryAxis
                            {
                                ScaleLabel = new ScaleLabel
                                {
                                    Display = true,
                                    LabelString = Resource.ReasonOfAppoinment
                                },
                                Ticks = new CategoryTicks
                                {
                                    AutoSkip = false
                                }
                            }
                        },
                        YAxes = new List<CartesianAxis>
                        {
                            new BarLinearCartesianAxis
                            {
                                ScaleLabel = new ScaleLabel
                                {
                                    Display = true,
                                    LabelString = Resource.NumberOfAppointments
                                },
                                Ticks = new LinearCartesianTicks
                                {
                                    BeginAtZero = true
                                }
                            }
                        }
                    }
                }
            };

            
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            LoaderService.SetLoader(false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _appointmentsByReasonCount = await AppointmentService.GetAppointmentReasonCounts();

        if (firstRender && _appointmentsByReasonCount.Any())
        {
            foreach (var reason in _appointmentsByReasonCount.Keys)
            {
                _config?.Data.Labels.Add(reason.ToLocalizedString());
            }

            var dataset = new BarDataset<int>(_appointmentsByReasonCount.Values)
            {
                Label = Resource.TotalAppointments,
                BackgroundColor = new[]
                {
                    ColorUtil.ColorHexString(54, 162, 235),
                    ColorUtil.ColorHexString(75, 192, 192),
                    ColorUtil.ColorHexString(75, 192, 150),
                    ColorUtil.ColorHexString(75, 192, 110),
                    ColorUtil.ColorHexString(110, 192, 110),
                },
                BorderWidth = 1
            };

            _config?.Data.Datasets.Add(dataset);
            StateHasChanged();
        }
    }
}
