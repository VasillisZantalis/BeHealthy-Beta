@inject IPatientService patientService
@inject NavigationManager NavigationManager

<div id="totalPatientsDiv" class="clickable" @onclick="() => NavigationManager.NavigateTo(RoutingEndpoints.PATIENTS_PAGE)">
    <div class="card rounded shadow border-0 border-start border-5 border-danger my-3">
        <div class="card-body">
            <div class="d-flex flex-row flex-wrap gap-2">
                <Icon IconClass="@FAIcon.Viruses" SizeClass="fs-4"/>
                <h5 class="align-self-center">@Resource.Patients</h5>
            </div>
            <h5 class="text-muted text-center fs-2">@totalPatientsCount</h5>
        </div>
    </div>
</div>

@code {
    private int totalPatientsCount;

    protected override async Task OnInitializedAsync()
    {
        totalPatientsCount = (await patientService.GetAllPatientsAsync(new PatientSearchingParameters())).Count();
    }

}
