@inject INurseService nurseService
@inject NavigationManager NavigationManager

<div id="totalNursesDiv" class="clickable" @onclick="() => NavigationManager.NavigateTo(RoutingEndpoints.NURSES_PAGE)">
    <div class="card rounded shadow border-0 border-start border-5 border-warning my-3">
        <div class="card-body">
            <div class="d-flex flex-row flex-wrap gap-2">
                <Icon IconClass="@FAIcon.UserNurse" SizeClass="fs-4"/>
                <h5 class="align-self-center">@Resource.Nurses</h5>
            </div>
            @if (_isLoading)
            {
                <SmallLoader />
            }
            else
            {
                <h5 class="text-muted text-center fs-2">@totalNursesCount</h5>
            }
        </div>
    </div>
</div>

@code {
    private int totalNursesCount;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        totalNursesCount = await nurseService.GetNurseCountAsync();
        _isLoading = false;
    }
}
