@inject NavigationManager NavigationManager

@if (Patients.Any())
{
    <ul class="list-group">
        <Virtualize Items="Patients" Context="patient">
            <li class="list-group-item my-2 border rounded-pill clickable" @onclick="() => OnPatientClick(patient)">
                <div class="d-flex justify-content-between px-3">
                    <img class="rounded-circle" src="images/generic.jpg" alt="@patient.FullName" width="35" height="35" />
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">Name</span>
                        <h6>@patient.FullName</h6>
                    </div>
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">Email</span>
                        <h6>@patient.Email</h6>
                    </div>
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">Phone</span>
                        <h6>@(!string.IsNullOrEmpty(patient.PhoneNumber) ? patient.PhoneNumber : "-")</h6>
                    </div>
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">Created</span>
                        <h6>@DateTimeExtensions.ToFullDateTimeString(patient.CreatedAt)</h6>
                    </div>
                </div>
            </li>
        </Virtualize>
    </ul>
}
else
{
    <h6>No Patients at this department</h6>
}


@code {
    [Parameter]
    public List<PatientDto> Patients { get; set; } = new();

    private void OnPatientClick(PatientDto patient)
    {
        //NavigationManager.NavigateTo(RoutingEndpoints.PATIENTS_PAGE);
        NavigationManager.NavigateTo($"{RoutingEndpoints.PATIENTS_PAGE}/edit/{patient.Id}");
    }
}
