@inject NavigationManager NavigationManager

@if (Nurses.Any())
{
    <ul class="list-group">
        <Virtualize Items="Nurses" Context="nurse">
            <li class="list-group-item my-2 border rounded-pill clickable" @onclick="() => OnNurseClick(nurse)">
                <div class="d-flex justify-content-between px-3">
                    <img class="rounded-circle" src="images/generic.jpg" alt="@nurse.FullName" width="35" height="35" />
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">Name</span>
                        <h6>@nurse.FullName</h6>
                    </div>
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">Email</span>
                        <h6>@nurse.Email</h6>
                    </div>
                    @if (!string.IsNullOrEmpty(nurse.PhoneNumber))
                    {
                        <div class="d-flex flex-column align-items-center">
                            <span class="text-muted small-text">Phone</span>
                            <h6>@nurse.PhoneNumber</h6>

                        </div>
                    }
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">Created</span>
                        <h6>@DateTimeExtensions.ToFullDateTimeString(nurse.CreatedAt)</h6>
                    </div>
                </div>
            </li>
        </Virtualize>
    </ul>
}
else
{
    <h6>No Nurses at this department</h6>
}

@code {
    [Parameter]
    public List<NurseDto> Nurses { get; set; } = new();

    private void OnNurseClick(NurseDto nurse)
    {
        //NavigationManager.NavigateTo(RoutingEndpoints.NURSES_PAGE);
        NavigationManager.NavigateTo($"{RoutingEndpoints.NURSES_PAGE}/edit/{nurse.Id}");
    }

}
