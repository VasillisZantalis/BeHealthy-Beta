@inject NavigationManager NavigationManager

@if (Rooms.Any())
{
    <ul class="list-group">
        <Virtualize Items="Rooms" Context="room">
            <li class="list-group-item my-2 border rounded-pill clickable" @onclick="() => OnRoomClick(room)">
                <div class="d-flex justify-content-evenly px-3">
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">@Resource.Name</span>
                        <h6>@room.Name</h6>
                    </div>
                    <div class="d-flex flex-column align-items-center">
                        <span class="text-muted small-text">@Resource.Number</span>
                        <h6>@room.Number</h6>
                    </div>
                </div>
            </li>
        </Virtualize>
    </ul>
}
else
{
    <h6>@string.Format(Resource.ThereAreNo, Resource.Rooms)</h6>
}


@code {
    [Parameter]
    public List<RoomDto> Rooms { get; set; } = new();

    private void OnRoomClick(RoomDto room)
    {
        NavigationManager.NavigateTo($"{RoutingEndpoints.ROOMS_PAGE}");
    }
}
