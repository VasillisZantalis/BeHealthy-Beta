@page "/departments"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@attribute [StreamRendering]

<PageTitle>@Resource.Departments</PageTitle>

<SectionContent SectionName="page-title">@Resource.Departments</SectionContent>

<div class="">
    <button class="btn btn-outline-secondary rounded-pill px-4 mb-3" @onclick="Create">
        <Icon IconClass="@FAIcon.Plus" /> @Resource.Create
    </button>
</div>

@if (_isLoading)
{
    <Loader/>
}
else if (_departments is null || !_departments.Any())
{
    <p>@string.Format(@Resource.NoAvailable, @Resource.Departments)</p>
}
else
{
    <div class="departments-container mt-3">
        <div class="card">
            <div class="card-header d-flex flex-row justify-content-end">
                <div class="px-1">
                    <InputSelect class="form-select form-select-sm" @bind-Value="_paginationState.ItemsPerPage">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </InputSelect>
                </div>
            </div>
            <div class="table-responsive">
                <div class="card-body pb-2 px-0 m-0">
                    <QuickGrid Class="table rounded"
                               Items="@_departments.AsQueryable()"
                               ItemKey="@(x => x.Id)"
                               Pagination="_paginationState">
                        <PropertyColumn Title="@Resource.Name"
                                        Property="@(x => x.Name)" />
                        <PropertyColumn Title="@Resource.Location"
                                        Property="@(x => x.Location)" />
                        <PropertyColumn Title="@Resource.HeadΟfDepartment"
                                        Property="@(x => x.HeadOfDepartment != null ? x.HeadOfDepartment.FullName : Resource.NotAvailable)" />
                        @if (_hasActionRights)
                        {
                            <TemplateColumn>
                                <ActionsDropdown>
                                    <button class="btn w-100 text-start" @onclick="@(() => EditDepartment(context.Id))">
                                        <Icon IconClass="@FAIcon.Pencil" TextClass="text-warning" />&nbsp; @Resource.Edit
                                    </button>
                                    <button class="btn w-100 text-start" @onclick="async () => await DeleteDepartment(context.Id)">
                                        <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />&nbsp; @Resource.Delete
                                    </button>
                                </ActionsDropdown>
                            </TemplateColumn>
                        }
                    </QuickGrid>

                </div>

            </div>
            <div id="paginatorDiv" class="px-3">
                <Paginator State="_paginationState" />
            </div>
        </div>
    </div>    
}