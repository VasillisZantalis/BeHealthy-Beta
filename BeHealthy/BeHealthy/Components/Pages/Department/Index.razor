@page "/departments"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Departments</PageTitle>

<SectionContent SectionName="page-title">Departments</SectionContent>

<div class="">
    <button class="btn btn-light px-4 mb-3" @onclick="Create">
        <span class="fa-solid fa-plus" aria-hidden="true"></span> Create
    </button>
</div>

@if (_isLoading)
{
    <Loader/>
}
else if (_departments is null || !_departments.Any())
{
    <p>No Departments available.</p>
}
else
{
    <div class="appointmentsTableDiv mt-3">
        <div class="card">
            <div class="card-header d-flex flex-row justify-content-end">
                <div class="px-1">
                    <InputSelect class="form-select form-select-sm" @bind-Value="_paginationState.ItemsPerPage">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </InputSelect>
                </div>
            </div>
            <div class="table-responsive">
                <div class="card-body pb-2 px-0 m-0">
                    <QuickGrid Class="table rounded"
                               Items="@_departments.AsQueryable()"
                               ItemKey="@(x => x.Id)"
                               Pagination="_paginationState">
                        <PropertyColumn Title="Name"
                                        Property="@(x => x.Name)" />
                        @if (_hasActionRights)
                        {
                            <TemplateColumn>
                                <ActionsDropdown>
                                    <button class="btn w-100 text-start" @onclick="@(() => EditDepartment(context.Id))">
                                        <span class="fa-solid fa-pencil text-warning"></span>&nbsp; Edit
                                    </button>
                                    <button class="btn w-100 text-start" @onclick="async () => DeleteDepartment(context.Id)">
                                        <span class="fa-solid fa-trash-can text-danger"></span>&nbsp; Delete
                                    </button>
                                </ActionsDropdown>
                            </TemplateColumn>
                        }
                    </QuickGrid>

                </div>

            </div>
            <div id="paginatorDiv" class="px-3">
                <Paginator State="_paginationState" />
            </div>
        </div>
    </div>    
}