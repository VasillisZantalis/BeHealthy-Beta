@page "/departments"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

<PageTitle>@Resource.Departments</PageTitle>

<div class="">
    <CreateButton OnClick="Create" />
</div>

@if (departments is null || !departments.Any())
{
    <p>@string.Format(Resource.NoAvailable, Resource.Departments)</p>
}
else
{
    <div class="departments-container mt-3">
        <div class="card">
            <div class="card-header d-flex flex-row justify-content-end">
                <div class="px-1">
                    <InputSelect class="form-select form-select-sm" @bind-Value="paginationState.ItemsPerPage">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </InputSelect>
                </div>
            </div>
            <div class="table-responsive">
                <div class="card-body pb-2 px-0 m-0">
                    <QuickGrid Class="table rounded"
                               Items="@departments.AsQueryable()"
                               ItemKey="@(x => x.Id)"
                               Pagination="paginationState">
                        <PropertyColumn Title="@Resource.Name"
                                        Property="@(x => x.Name)" />
                        <PropertyColumn Title="@Resource.Location"
                                        Property="@(x => x.Location)" />
                        <PropertyColumn Title="@Resource.HeadΟfDepartment"
                                        Property="@(x => x.HeadOfDepartment != null ? x.HeadOfDepartment.FullName : string.Empty)" />
                        <TemplateColumn Title="@Resource.Actions" Align="Align.End">
                            <div class="d-flex justify-content-end">
                                <button class="btn" title="@(Resource.Edit)" @onclick="@(() => EditDepartment(context.Id))">
                                    <Icon IconClass="@FAIcon.EditSquare" TextClass="text-warning" />
                                </button>
                                <button class="btn" title="@(Resource.Delete)" @onclick="() => ConfirmDelete(context.Id)">
                                    <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />
                                </button>
                            </div>
                        </TemplateColumn>
                    </QuickGrid>

                </div>

            </div>
            <div id="paginatorDiv" class="px-3">
                <Paginator State="paginationState" />
            </div>
        </div>
    </div>    
}