@inherits BasePage
@using BeHealthy.Application.Helpers;

<div class="container-fluid my-3 p-3 border rounded">
    <EditForm FormName="DepartmentForm" OnValidSubmit="HandleSubmit" Model="DepartmentDto">
        <Alert @ref="_alert" />
        <ValidationComponent @ref="_validationComponent" />
        <div class="d-flex flex-column gap-3">
            <div class="form-group">
                <label class="fw-bold" for="name">@Resource.Name</label>
                <InputText id="name" class="form-control" @bind-Value="DepartmentDto.Name" />
            </div>
            <div class="form-group">
                <label class="fw-bold" for="location">@Resource.Location</label>
                <InputText id="location" class="form-control" @bind-Value="DepartmentDto.Location" />
            </div>
            <div class="form-group">
                <label class="fw-bold @(_isRequiredHeadOfDepartment ? "required" : "")" for="headOfDepartment">@Resource.HeadΟfDepartment</label>
                <InputSelect id="headOfDepartment" class="form-control" @bind-Value="DepartmentDto.HeadOfDepartmentId">
                    @foreach (var doctor in _doctorsSelect)
                    {
                        <option value="@doctor.Value">@doctor.Text</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => DepartmentDto.HeadOfDepartmentId)" />
            </div>
        </div>
        <button type="submit" class="btn btn-success mt-3 px-4 text-end">
            @if (_inProgress)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            @Resource.Save
        </button>
    </EditForm>
</div>

@code{
    [Parameter]
    public bool IsEditMode { get; set; } = false;

    [Parameter]
    public List<DoctorDto> Doctors { get; set; } = new();

    [Parameter]
    public DepartmentDto DepartmentDto { get; set; } = new();

    [Inject]
    private IDepartmentService _departmentService { get; set; } = default!;

    [Inject]
    private IAppSettingsService _appSettingsService { get; set; } = default!;

    [Inject]
    private NavigationManager _navigationManager { get; set; } = default!;

    private bool _inProgress = false;
    private Alert _alert = new();
    private bool _isRequiredHeadOfDepartment;

    private List<SelectItem> _doctorsSelect = new List<SelectItem>();

    private ValidationComponent? _validationComponent;

    protected override async Task OnParametersSetAsync()
    {
        _doctorsSelect = Doctors.Select(s => new SelectItem
            {
                Value = s.Id,
                Text = s.FullName
            }).ToList();
        _doctorsSelect.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });

        await GetSettings();
    }

    private async Task GetSettings()
    {
        var keys = new[] { "DepartmentRequiresSupervisor", "DefaultDepartmentSupervison" }.ToList();
        var settings = await _appSettingsService.GetMassAppSettingsAsync(keys);

        var requiredSupervisorSetting = settings.FirstOrDefault(s => s.Key == "DepartmentRequiresSupervisor");
        var defaultSupervisorSetting = settings.FirstOrDefault(s => s.Key == "DefaultDepartmentSupervison");

        _isRequiredHeadOfDepartment = requiredSupervisorSetting?.GetBooleanValue() ?? false;
        var defaultSupervisor = defaultSupervisorSetting?.GetIntValue();

        if (!IsEditMode && defaultSupervisor.HasValue && (DepartmentDto.HeadOfDepartmentId == null || DepartmentDto.HeadOfDepartmentId == 0))
        {
            if (_doctorsSelect.Any(d => d.Value == defaultSupervisor.Value))
            {
                DepartmentDto.HeadOfDepartmentId = defaultSupervisor.Value;
            }
        }
    }

    private async Task HandleSubmit()
    {
        _inProgress = true;

        _validationComponent?.ClearErrors();
        var errors = new Dictionary<string, List<string>>();

        if (_isRequiredHeadOfDepartment && DepartmentDto.HeadOfDepartmentId is null)
        {
            errors.Add(nameof(DepartmentDto.HeadOfDepartmentId),
                new() { string.Format(Resource.TheFieldIsRequired, Resource.HeadΟfDepartment) });
        }

        if (errors.Any())
        {
            _validationComponent?.DisplayErrors(errors);
        }
        else 
        {
            if (IsEditMode)
            {
                var roomForUpdateDto = new DepartmentForUpdateDto
                    {
                        Id = DepartmentDto.Id,
                        Name = DepartmentDto.Name,
                        Location = DepartmentDto.Location,
                        HeadOfDepartmentId = DepartmentDto.HeadOfDepartmentId,
                        Doctors = DepartmentDto.Doctors,
                        Nurses = DepartmentDto.Nurses,
                        Patients = DepartmentDto.Patients,
                        Rooms = DepartmentDto.Rooms
                    };
                await _departmentService.UpdateDepartmentAsync(roomForUpdateDto);
            }
            else
            {
                var roomForCreateDto = new DepartmentForCreationDto
                    {
                        Name = DepartmentDto.Name,
                        Location = DepartmentDto.Location,
                        HeadOfDepartmentId = DepartmentDto.HeadOfDepartmentId,
                        Doctors = DepartmentDto.Doctors,
                        Nurses = DepartmentDto.Nurses,
                        Patients = DepartmentDto.Patients,
                        Rooms = DepartmentDto.Rooms
                    };
                await _departmentService.AddDepartmentAsync(roomForCreateDto);
            }
            _navigationManager.NavigateTo(RoutingEndpoints.DEPARTMENTS_PAGE);
        }
        _inProgress = false;
    }
}