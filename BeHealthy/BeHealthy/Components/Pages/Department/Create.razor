@page "/departments/create"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Create</PageTitle>

<SectionContent SectionName="page-title">Create</SectionContent>

<div class="container-fluid">

    <ul class="nav nav-tabs">
        <li class="nav-item">
            <a class="nav-link text-reset @(activeTab == 0 ? "active" : "")" @onclick="() => SelectTab(0)">General Data</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-reset @(activeTab == 1 ? "active" : "")" @onclick="() => SelectTab(1)">Doctors</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-reset @(activeTab == 2 ? "active" : "")" @onclick="() => SelectTab(2)">Patients</a>
        </li>
    </ul>

    <div class="tab-content mt-3">
        @if (activeTab == 0)
        {
            <div>
                <h4>General Data</h4>
                <p>Here you can display general information about the department.</p>
            </div>
        }
        else if (activeTab == 1)
        {
            <h5>Doctors</h5>
        }
        else if (activeTab == 2)
        {
            <h5>Patients</h5>
        }
    </div>


</div>