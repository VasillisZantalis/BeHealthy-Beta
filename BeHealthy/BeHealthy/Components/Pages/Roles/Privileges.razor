@page "/roles/privileges"
@using BeHealthy.Application.Dtos.Privilege
@using BeHealthy.Shared.Common
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IPrivilegeService PrivilegeService
@inject NavigationManager NavigationManager

<PageTitle>@Resource.Privileges</PageTitle>

@if (_groupedPrivileges == null)
{
    <p>Loading privileges...</p>
}
else
{
    <div class="container-fluid">
        <button class="btn btn-success px-4 mb-4" @onclick="SavePrivileges">@Resource.Save</button>
        @foreach (var roleGroup in _groupedPrivileges)
        {
            <div class="card shadow border-0 rounded px-3 py-2 mt-3">
                <h4 class="">@EnumResourceConverter.ConvertToLocalizedString(roleGroup.Key)</h4>
                <div class="card-body">
                    @foreach (var privilege in roleGroup.Value)
                    {
                        <div class="form-check mb-2">
                            <InputCheckbox @bind-Value="privilege.Value" class="form-check-input" />
                            <label class="form-check-label ms-2">@EnumResourceConverter.ConvertToLocalizedString(privilege.Name)</label>
                        </div>
                        <hr>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private Dictionary<UserRole, List<PrivilegeDto>>? _groupedPrivileges;

    protected override async Task OnInitializedAsync()
    {
        LoaderService.SetLoader(true);

        SetBreadcrumbs();

        var privileges = await PrivilegeService.GetPrivilegesAsync();

        // Group privileges by role
        _groupedPrivileges = privileges
            .SelectMany(p => p.Roles, (privilege, roleName) => new { privilege, roleName }) // Flatten the data
            .GroupBy(p => p.roleName) // Parse the role name into UserRole enum
            .ToDictionary(
                group => group.Key, // Group by UserRole
                group => group.Select(p => p.privilege).ToList() // Map to the list of PrivilegeDto
            );

        LoaderService.SetLoader(false);
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        {
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Privileges, Link = string.Empty, Active = true },
        });
    }

    private async Task SavePrivileges()
    {
        LoaderService.SetLoader(true);

        if (_groupedPrivileges == null)
            return;

        // Flatten the privileges to a single list before saving
        var privilegesToSave = _groupedPrivileges
            .SelectMany(group => group.Value)
            .ToList();

        await PrivilegeService.SavePrivilegesAsync(privilegesToSave);

        LoaderService.SetLoader(false);
        NavigationManager.Refresh(forceReload: true);
    }
}
