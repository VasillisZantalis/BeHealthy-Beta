@page "/roles/privileges"
@using BeHealthy.Application.Dtos.Privilege
@using BeHealthy.Shared.Common
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IPrivilegeService PrivilegeService
@inject NavigationManager NavigationManager

<PageTitle>@Resource.Privileges</PageTitle>

@if (_rolePrivileges is null || !_rolePrivileges.Any())
{
    <Loader />
}
else
{
    <div class="container-fluid">
        @foreach (var rolePrivilege in _rolePrivileges)
        {
            <div class="card shadow border-0 rounded px-3 py-2 mt-3">
                <h4 class="">@EnumResourceConverter.ConvertToLocalizedString(rolePrivilege.Role)</h4>
                <div class="card-body">
                    @foreach (var privilege in rolePrivilege.Privileges)
                    {
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" checked="@(privilege.HasPrivilege)"
                                @onchange="() => UpdatePrivilege(rolePrivilege.Role, privilege.PrivilegeName, !privilege.HasPrivilege)" />
                            <label class="form-check-label ms-2">@EnumResourceConverter.ConvertToLocalizedString(privilege.PrivilegeName)</label>
                        </div>
                        <hr>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<RolePrivilegesDto> _rolePrivileges = new();

    protected override async Task OnInitializedAsync()
    {
        LoaderService.SetLoader(true);

        SetBreadcrumbs();

        var rolePrivileges = await PrivilegeService.GetPrivilegesAsync();
        _rolePrivileges = rolePrivileges.Where(w => w.Role != UserRole.Admin && w.Role != UserRole.Staff).ToList();

        LoaderService.SetLoader(false);
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        {
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Privileges, Link = string.Empty, Active = true },
        });
    }

    private async Task UpdatePrivilege(UserRole roleName, PrivilegeName privilegeName, bool hasPrivilege)
    {
        LoaderService.SetLoader(true);
        await PrivilegeService.UpdatePrivilegeAsync(roleName, privilegeName, hasPrivilege);
        LoaderService.SetLoader(false);
        NavigationManager.Refresh(forceReload: true);
    }
}
