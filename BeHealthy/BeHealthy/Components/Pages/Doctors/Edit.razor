@page "/doctors/edit/{DoctorId:int}"
@using BeHealthy.Application.Validations.Doctor
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IDoctorService DoctorService
@inject IDepartmentService DepartmentService
@inject ISpecialtyService SpecialtyService
@inject IAppSettingsService AppSettingsService
@inject NavigationManager NavigationManager

<PageTitle>@Resource.Edit</PageTitle>

<BeHealthyCard BodyClass="p-3">
    <Body>
        <EditForm Model="_DoctorUpdateDto" method="post" OnValidSubmit="UpdateDoctor" FormName="UpdateForm" Enhance>

            <button type="submit" class="btn btn-success px-5 d-flex flex-row" disabled="@_inProgress">
                @if (_inProgress)
                {
                    <SmallLoader />
                }
                <span>@Resource.Save</span>
            </button>

            <ValidationComponent @ref="_validationComponent"/>

            <Alert @ref="_alert" />

            <div class="d-flex flex-column gap-3 p-3">

                <ImageUploadContainer OnOpenImageUploadModal="OpenImageUploadModal">
                    <ImagePreview ImageUrl="@_DoctorUpdateDto.Image" />
                </ImageUploadContainer>

                <BeHealthyFormGroup Label="@Resource.FirstName" InputId="firstName" IsRequired="true">
                    <InputText @bind-Value="_DoctorUpdateDto.FirstName" class="form-control" aria-required="true" id="firstName" placeholder="First Name" />
                    <ValidationMessage For="() => _DoctorUpdateDto.FirstName" class="text-danger" />
                </BeHealthyFormGroup>

                <BeHealthyFormGroup Label="@Resource.LastName" InputId="lastName" IsRequired="true">
                    <InputText @bind-Value="_DoctorUpdateDto.LastName" class="form-control" autocomplete="username" aria-required="true" id="lastName" placeholder="Last Name" />
                    <ValidationMessage For="() => _DoctorUpdateDto.LastName" class="text-danger" />
                </BeHealthyFormGroup>

                <BeHealthyFormGroup Label="@Resource.PhoneNumber" InputId="phoneNumber">
                    <InputText id="phoneNumber" @bind-Value="_DoctorUpdateDto.PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
                    <ValidationMessage For="() => _DoctorUpdateDto.PhoneNumber" class="text-danger" />
                </BeHealthyFormGroup>

                @if (_specialtiesSelect is not null && _specialtiesSelect.Any())
                {
                    <BeHealthyFormGroup Label="@Resource.Department" InputId="department">
                        <InputSelect id="department" @bind-Value="_DoctorUpdateDto.DepartmentId" class="form-control">
                            @foreach (var department in _departmentsSelect!)
                            {
                                <option value="@department.Value">@department.Text</option>
                            }
                        </InputSelect>
                    </BeHealthyFormGroup>
                }

                @if (_specialtiesSelect is not null && _specialtiesSelect.Any())
                {
                    <BeHealthyFormGroup Label="@Resource.Specialty" InputId="specialty" IsRequired="_doNotAllowDoctorWithoutSpecialty">
                        <InputSelect id="specialty" @bind-Value="_DoctorUpdateDto.SpecialtyId" class="form-control">
                            @foreach (var specialty in _specialtiesSelect)
                            {
                                <option value="@specialty.Value">@specialty.Text</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _DoctorUpdateDto.SpecialtyId" class="text-danger" />
                    </BeHealthyFormGroup>
                }
            </div>
        </EditForm>
    </Body>
</BeHealthyCard>


@code {
    [Parameter]
    public int DoctorId { get; set; }

    [SupplyParameterFromForm]
    private DoctorUpdateDto _DoctorUpdateDto { get; set; } = new();

    private bool _inProgress = false;
    private bool _doNotAllowDoctorWithoutSpecialty = false;
    private Alert _alert = new();
    private ValidationComponent? _validationComponent;

    private List<SelectItem>? _departmentsSelect = new();
    private List<SelectItem>? _specialtiesSelect = new();

    protected override async Task OnInitializedAsync()
    {
        await GetSettings();

        var departments = (await DepartmentService.GetAllDepartmentsAsync()).ToList();

        _departmentsSelect = departments?.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();
        _departmentsSelect?.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });

        var specialties = await SpecialtyService.GetSpecialtiesAsync();

        _specialtiesSelect = specialties?.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();
        _specialtiesSelect?.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });
    }

    protected override async Task OnParametersSetAsync()
    {
        var doctor = await DoctorService.GetDoctorByIdAsync(DoctorId);

        _DoctorUpdateDto = doctor?.MapToUpdateDto() ?? new();

        SetBreadcrumbs();
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.ResetBreadcrumb();
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        {
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Doctors, Link = RoutingEndpoints.DOCTORS_PAGE, Active = false },
            new Breadcrumb(){ Text = Resource.Edit, Link = RoutingEndpoints.DOCTORS_PAGE, Active = true },
            new Breadcrumb(){ Text = DoctorId.ToString(), Link = string.Empty, Active = true },
        });
    }

    private async Task GetSettings()
    {
        AppSetting? setting = await AppSettingsService.GetSettingByKeyAsync("DoNotAllowDoctorWithoutSpecialty");
        _doNotAllowDoctorWithoutSpecialty = setting?.GetBooleanValue() ?? false;
    }

    private void OpenImageUploadModal()
    {
        ModalService.Show<FileUploadModal>(new Dictionary<string, object?>
        {
            { nameof(FileUploadModal.IsImage), true },
            { nameof(FileUploadModal.MaxFileSizeInKB), 1024 },
            { nameof(FileUploadModal.ResizeWidth), 200 },
            { nameof(FileUploadModal.ResizeHeight), 200 },
            { nameof(FileUploadModal.OnFileUploaded), EventCallback.Factory.Create<string>(this, HandleImageUploaded) }
        });
    }

    private void HandleImageUploaded(string imageData)
    {
        _DoctorUpdateDto.Image = imageData;
        StateHasChanged();
    }

    private async Task UpdateDoctor()
    {
        _inProgress = true;

        _validationComponent?.ClearErrors();

        var validator = new DoctorForUpdateDtoValidator(_doNotAllowDoctorWithoutSpecialty);
        var validationResult = await validator.ValidateAsync(_DoctorUpdateDto);

        if (!validationResult.IsValid)
        {
            var errors = validationResult.GetErrorsGroupedByProperty();
            _validationComponent?.DisplayErrors(errors);
            _inProgress = false;
            return;
        }

        var result = await DoctorService.UpdateDoctorAsync(_DoctorUpdateDto);
        _inProgress = false;

        if (!result.Success)
        {
            _alert.ShowSuccess(result.ErrorMessage);
        }
        else
        {
            ToastService.ShowToast(Resource.Success, "success");
            NavigationManager.Refresh(true);
        }
    }
}