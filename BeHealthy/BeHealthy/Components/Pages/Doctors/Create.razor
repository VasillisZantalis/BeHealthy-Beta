@page "/doctors/create"
@using BeHealthy.Application.Validations.Doctor
@using BeHealthy.Infrastructure.Data
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject IDoctorService DoctorService
@inject IDepartmentService DepartmentService
@inject ISpecialtyService SpecialtyService
@inject IAppSettingsService AppSettingsService
@inject NavigationManager NavigationManager
@inject ApplicationDbContext _dbContext

<PageTitle>@Resource.Create</PageTitle>

<div class="container-fluid p-5 border rounded shadow">
    <EditForm Model="_doctorForCreationDto" method="post" OnValidSubmit="RegisterDoctor" FormName="RegisterForm" Enhance>
        <ValidationComponent @ref="_validationComponent"/>

        <div class="row">
            <Alert @ref="_alert" />
            <div class="text-center mb-3">
                <img src="@(_doctorForCreationDto.Image ?? "images/generic.jpg")" class="image-fluid rounded-circle" />
            </div>
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="_doctorForCreationDto.FirstName" class="form-control" aria-required="true" id="firstName" placeholder="First Name" />
                    <label for="firstName">@Resource.FirstName</label>
                    <ValidationMessage For="() => _doctorForCreationDto.FirstName" class="text-danger" />
                </div>
            </div>
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="_doctorForCreationDto.LastName" class="form-control" autocomplete="username" aria-required="true" id="lastName" placeholder="Last Name" />
                    <label for="lastName">@Resource.LastName</label>
                    <ValidationMessage For="() => _doctorForCreationDto.LastName" class="text-danger" />
                </div>
            </div>
        </div>
        <div class="form-control mb-3">
            <InputFile class="form-control" OnChange="OnFileChange" />
        </div>
        <div class="form-floating mb-3">
            <InputText @bind-Value="_doctorForCreationDto.Email" class="form-control" autocomplete="username" aria-required="true" id="email" placeholder="name@example.com" />
            <label for="email">@Resource.Email</label>
            <ValidationMessage For="() => _doctorForCreationDto.Email" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText type="password" @bind-Value="_doctorForCreationDto.Password" class="form-control" autocomplete="new-password" aria-required="true" id="password" placeholder="Password" />
            <label for="password">@Resource.Password</label>
            <ValidationMessage For="() => _doctorForCreationDto.Password" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText type="password" @bind-Value="_doctorForCreationDto.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" id="confirmPassword" placeholder="Confirm Password" />
            <label for="confirmPassword">@Resource.ConfirmPassword</label>
            <ValidationMessage For="() => _doctorForCreationDto.ConfirmPassword" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText id="phoneNumber" @bind-Value="_doctorForCreationDto.PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
            <label for="phoneNumber">@Resource.PhoneNumber</label>
            <ValidationMessage For="() => _doctorForCreationDto.PhoneNumber" class="text-danger" />
        </div>

        @if (_departmentsSelect is not null && _departmentsSelect.Any())
        {
            <div class="form-floating mb-3">
                <InputSelect id="Department" @bind-Value="_doctorForCreationDto.DepartmentId" class="form-control">
                    @foreach (var department in _departmentsSelect)
                    {
                        <option value="@department.Value">@department.Text</option>
                    }
                </InputSelect>
                <label for="Department">@Resource.Department</label>
            </div>
        }

        @if (_specialtiesSelect is not null && _specialtiesSelect.Any())
        {
            <div class="form-floating mb-3">
                <InputSelect id="specialty" @bind-Value="_doctorForCreationDto.SpecialtyId" class="form-control">
                    @foreach (var specialty in _specialtiesSelect)
                    {
                        <option value="@specialty.Value">@specialty.Text</option>
                    }
                </InputSelect>
                <label for="specialty" class="@(_doNotAllowDoctorWithoutSpecialty ? "required" : "")">@Resource.Specialty</label>
                <ValidationMessage For="() => _doctorForCreationDto.SpecialtyId" class="text-danger" />
            </div>
        }

        <button type="submit" class="btn btn-success px-5 d-flex flex-row" disabled="@_inProgress">
            @if (_inProgress)
            {
                <SmallLoader />
            }
            <span>@Resource.Save</span>
        </button>
    </EditForm>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private DoctorForCreationDto _doctorForCreationDto { get; set; } = new();

    private ValidationComponent? _validationComponent;

    private bool _inProgress = false;
    private bool _doNotAllowDoctorWithoutSpecialty = false;
    private int? _departmentId;

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    private Alert _alert = new();

    private List<SelectItem>? _departmentsSelect = new();
    private List<SelectItem>? _specialtiesSelect = new();

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs();

        await GetSettings();

        var departments = (await DepartmentService.GetAllDepartmentsAsync()).ToList();
        _departmentsSelect = departments.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();
        _departmentsSelect.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });

        var specialties = await SpecialtyService.GetSpecialtiesAsync();

        _specialtiesSelect = specialties?.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();
        _specialtiesSelect?.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });
    }

    private async Task GetSettings()
    {
        AppSetting? setting = await AppSettingsService.GetSettingByKeyAsync("DoNotAllowDoctorWithoutSpecialty");
        _doNotAllowDoctorWithoutSpecialty = setting?.GetBooleanValue() ?? false;
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.ResetBreadcrumb();
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        {
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){Text = Resource.Doctors, Link = RoutingEndpoints.DOCTORS_PAGE, Active = false},
            new Breadcrumb(){Text = Resource.Create, Link = RoutingEndpoints.DOCTORS_PAGE, Active = true}
        });
    }

    public async Task RegisterDoctor(EditContext editContext)
    {
        _inProgress = true;

        _validationComponent?.ClearErrors();

        var validator = new DoctorForCreationDtoValidator(_doNotAllowDoctorWithoutSpecialty);
        var validationResult = await validator.ValidateAsync(_doctorForCreationDto);

        if (!validationResult.IsValid)
        {
            var errors = validationResult.GetErrorsGroupedByProperty();
            _validationComponent?.DisplayErrors(errors);
            _inProgress = false;
            return;
        }

        var user = new ApplicationUser
        {
            FirstName = _doctorForCreationDto.FirstName,
            LastName = _doctorForCreationDto.LastName,
            PhoneNumber = _doctorForCreationDto.PhoneNumber
        };

        await UserStore.SetUserNameAsync(user, _doctorForCreationDto.Email, CancellationToken.None);
        await UserManager.SetEmailAsync(user, _doctorForCreationDto.Email);

        var result = await UserManager.CreateAsync(user, _doctorForCreationDto.Password);

        if (!result.Succeeded)
        {
            _inProgress = false;
            identityErrors = result.Errors;
            var errors = identityErrors is null ? "Failed" : string.Join(Environment.NewLine, identityErrors.Select(error => error.Description));
            _alert.ShowFailed(errors);
            return;
        }

        await UserManager.AddToRoleAsync(user, nameof(UserRole.Doctor));

        await _dbContext.SaveChangesAsync();

        _doctorForCreationDto.UserId = user.Id;
        var doctorCreationResult = await DoctorService.AddDoctorAsync(_doctorForCreationDto);

        if (!doctorCreationResult.Success)
        {
            await UserManager.DeleteAsync(user);
            _alert.ShowFailed(Resource.SomethingWentWrong);
        }
        else
        {
            _alert.ShowSuccess(Resource.Success);
        }

        _inProgress = false;
    }

    private void HandleModalClose(bool success)
    {
        _inProgress = false;

        if (!success)
            return;

        NavigationManager.NavigateTo(RoutingEndpoints.DOCTORS_PAGE);
    }

    async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var format = e.File.ContentType;
        var resizeImage = await e.File.RequestImageFileAsync(format, 200, 200);
        var buffer = new byte[resizeImage.Size];
        await resizeImage.OpenReadStream().ReadAsync(buffer);
        _doctorForCreationDto.Image = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
    }
}
