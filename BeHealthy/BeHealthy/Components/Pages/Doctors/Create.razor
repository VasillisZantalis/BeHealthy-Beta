@page "/doctors/create"
@using BeHealthy.Application.Validations.Doctor
@using BeHealthy.Infrastructure.Data
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IDoctorService DoctorService
@inject IDepartmentService DepartmentService
@inject ISpecialtyService SpecialtyService
@inject IAppSettingsService AppSettingsService
@inject NavigationManager NavigationManager

<PageTitle>@Resource.Create</PageTitle>

<div class="container-fluid p-5 border rounded shadow">

    <EditForm Model="_DoctorCreateDto" method="post" OnValidSubmit="RegisterDoctor" FormName="RegisterForm" Enhance>

        <button type="submit" class="btn btn-success px-5 d-flex flex-row" disabled="@_inProgress">
            @if (_inProgress)
            {
                <SmallLoader />
            }
            <span>@Resource.Save</span>
        </button>

        <ValidationComponent @ref="_validationComponent"/>

        <div class="row">
            <Alert @ref="_alert" />
            <div class="text-center mb-3">
                <img src="@(_DoctorCreateDto.Image ?? "images/generic.jpg")" class="image-fluid rounded-circle" />
            </div>
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="_DoctorCreateDto.FirstName" class="form-control" aria-required="true" id="firstName" placeholder="First Name" />
                    <label for="firstName">@Resource.FirstName</label>
                    <ValidationMessage For="() => _DoctorCreateDto.FirstName" class="text-danger" />
                </div>
            </div>
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="_DoctorCreateDto.LastName" class="form-control" autocomplete="username" aria-required="true" id="lastName" placeholder="Last Name" />
                    <label for="lastName">@Resource.LastName</label>
                    <ValidationMessage For="() => _DoctorCreateDto.LastName" class="text-danger" />
                </div>
            </div>
        </div>
        <div class="form-control mb-3">
            <InputFile class="form-control" OnChange="OnFileChange" />
        </div>
        <div class="form-floating mb-3">
            <InputText @bind-Value="_DoctorCreateDto.Email" class="form-control" autocomplete="username" aria-required="true" id="email" placeholder="name@example.com" />
            <label for="email">@Resource.Email</label>
            <ValidationMessage For="() => _DoctorCreateDto.Email" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText type="password" @bind-Value="_DoctorCreateDto.Password" class="form-control" autocomplete="new-password" aria-required="true" id="password" placeholder="Password" />
            <label for="password">@Resource.Password</label>
            <ValidationMessage For="() => _DoctorCreateDto.Password" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText type="password" @bind-Value="_DoctorCreateDto.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" id="confirmPassword" placeholder="Confirm Password" />
            <label for="confirmPassword">@Resource.ConfirmPassword</label>
            <ValidationMessage For="() => _DoctorCreateDto.ConfirmPassword" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText id="phoneNumber" @bind-Value="_DoctorCreateDto.PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
            <label for="phoneNumber">@Resource.PhoneNumber</label>
            <ValidationMessage For="() => _DoctorCreateDto.PhoneNumber" class="text-danger" />
        </div>

        @if (_departmentsSelect is not null && _departmentsSelect.Any())
        {
            <div class="form-floating mb-3">
                <InputSelect id="Department" @bind-Value="_DoctorCreateDto.DepartmentId" class="form-control">
                    @foreach (var department in _departmentsSelect)
                    {
                        <option value="@department.Value">@department.Text</option>
                    }
                </InputSelect>
                <label for="Department">@Resource.Department</label>
            </div>
        }

        @if (_specialtiesSelect is not null && _specialtiesSelect.Any())
        {
            <div class="form-floating mb-3">
                <InputSelect id="specialty" @bind-Value="_DoctorCreateDto.SpecialtyId" class="form-control">
                    @foreach (var specialty in _specialtiesSelect)
                    {
                        <option value="@specialty.Value">@specialty.Text</option>
                    }
                </InputSelect>
                <label for="specialty" class="@(_doNotAllowDoctorWithoutSpecialty ? "required" : "")">@Resource.Specialty</label>
                <ValidationMessage For="() => _DoctorCreateDto.SpecialtyId" class="text-danger" />
            </div>
        }
    </EditForm>
</div>

@code {

    [SupplyParameterFromForm]
    private DoctorCreateDto _DoctorCreateDto { get; set; } = new();

    private ValidationComponent? _validationComponent;

    private bool _inProgress = false;
    private bool _doNotAllowDoctorWithoutSpecialty = false;

    private Alert _alert = new();

    private List<SelectItem>? _departmentsSelect = new();
    private List<SelectItem>? _specialtiesSelect = new();

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs();

        await GetSettings();

        var departments = (await DepartmentService.GetAllDepartmentsAsync()).ToList();
        _departmentsSelect = departments.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();
        _departmentsSelect.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });

        var specialties = await SpecialtyService.GetSpecialtiesAsync();

        _specialtiesSelect = specialties?.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();
        _specialtiesSelect?.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });
    }

    private async Task GetSettings()
    {
        AppSetting? setting = await AppSettingsService.GetSettingByKeyAsync("DoNotAllowDoctorWithoutSpecialty");
        _doNotAllowDoctorWithoutSpecialty = setting?.GetBooleanValue() ?? false;
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.ResetBreadcrumb();
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        {
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){Text = Resource.Doctors, Link = RoutingEndpoints.DOCTORS_PAGE, Active = false},
            new Breadcrumb(){Text = Resource.Create, Link = RoutingEndpoints.DOCTORS_PAGE, Active = true}
        });
    }

    public async Task RegisterDoctor(EditContext editContext)
    {
        _inProgress = true;

        _validationComponent?.ClearErrors();

        var validator = new DoctorCreateDtoValidator(_doNotAllowDoctorWithoutSpecialty);
        var validationResult = await validator.ValidateAsync(_DoctorCreateDto);

        if (!validationResult.IsValid)
        {
            var errors = validationResult.GetErrorsGroupedByProperty();
            _validationComponent?.DisplayErrors(errors);
            _inProgress = false;
            return;
        }

        var doctorCreationResult = await DoctorService.AddDoctorAsync(_DoctorCreateDto);
        _inProgress = false;

        if (!doctorCreationResult.Success)
        {
            _alert.ShowFailed(Resource.SomethingWentWrong);
        }
        else
        {
            ToastService.ShowToast(Resource.Success, "success");
            NavigationManager.NavigateTo(RoutingEndpoints.DOCTORS_PAGE);
        }

    }

    async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var format = e.File.ContentType;
        var resizeImage = await e.File.RequestImageFileAsync(format, 200, 200);
        var buffer = new byte[resizeImage.Size];
        await resizeImage.OpenReadStream().ReadAsync(buffer);
        _DoctorCreateDto.Image = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
    }
}
