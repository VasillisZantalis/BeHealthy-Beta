@page "/doctors/create"
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject IDoctorService DoctorService
@inject IDepartmentService DepartmentService
@inject ISpecialtyService SpecialtyService
@inject NavigationManager NavigationManager

<PageTitle>@Resource.Create</PageTitle>

<div class="container-fluid p-5 border rounded shadow">
    <EditForm Model="Input" method="post" OnValidSubmit="RegisterDoctor" FormName="RegisterForm" Enhance>
        <DataAnnotationsValidator />
        <div class="row">
            <Alert @ref="_alert" />
            <div class="text-center mb-3">
                <img src="@(Input.Image ?? "images/generic.jpg")" class="image-fluid rounded-circle" />
            </div>
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.FirstName" class="form-control" aria-required="true" id="firstName" placeholder="First Name" />
                    <label for="firstName">@Resource.FirstName</label>
                    <ValidationMessage For="() => Input.FirstName" class="text-danger" />
                </div>
            </div>
            <div class="col-12 col-sm-6">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.LastName" class="form-control" autocomplete="username" aria-required="true" id="lastName" placeholder="Last Name" />
                    <label for="lastName">@Resource.LastName</label>
                    <ValidationMessage For="() => Input.LastName" class="text-danger" />
                </div>
            </div>
        </div>
        <div class="form-control mb-3">
            <InputFile class="form-control" OnChange="OnFileChange" />
        </div>
        <div class="form-floating mb-3">
            <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" id="email" placeholder="name@example.com" />
            <label for="email">@Resource.Email</label>
            <ValidationMessage For="() => Input.Email" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" id="password" placeholder="Password" />
            <label for="password">@Resource.Password</label>
            <ValidationMessage For="() => Input.Password" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" id="confirmPassword" placeholder="Confirm Password" />
            <label for="confirmPassword">@Resource.ConfirmPassword</label>
            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
        </div>
        <div class="form-floating mb-3">
            <InputText id="phoneNumber" @bind-Value="Input.PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
            <label for="phoneNumber">@Resource.PhoneNumber</label>
            <ValidationMessage For="() => Input.PhoneNumber" class="text-danger" />
        </div>

        @if (_departmentsSelect is not null && _departmentsSelect.Any())
        {
            <div class="form-floating mb-3">
                <InputSelect id="Department" @bind-Value="_departmentId" class="form-control">
                    @foreach (var department in _departmentsSelect)
                    {
                        <option value="@department.Value">@department.Text</option>
                    }
                </InputSelect>
                <label for="Department">@Resource.Department</label>
            </div>
        }

        @if (_specialtiesSelect is not null && _specialtiesSelect.Any())
        {
            <div class="form-floating mb-3">
                <InputSelect id="specialty" @bind-Value="Input.SpecialtyId" class="form-control">
                    @foreach (var specialty in _specialtiesSelect)
                    {
                        <option value="@specialty.Value">@specialty.Text</option>
                    }
                </InputSelect>
                <label for="specialty">@Resource.Specialty</label>
            </div>
        }

        <button type="submit" class="btn btn-success px-5" disabled="@_inProgress">
            @if (_inProgress)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            @Resource.Save
        </button>
    </EditForm>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
    private bool _inProgress = false;
    private int? _departmentId;

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    private Alert _alert = new();

    private List<SelectItem>? _departmentsSelect = new();
    private List<SelectItem>? _specialtiesSelect = new();

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs();

        var departments = (await DepartmentService.GetAllDepartmentsAsync()).ToList();
        _departmentsSelect = departments.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();
        _departmentsSelect.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });

        var specialties = await SpecialtyService.GetSpecialtiesAsync();

        _specialtiesSelect = specialties?.Select(s => new SelectItem
        {
            Value = s.Id,
            Text = s.Name
        }).ToList();
        _specialtiesSelect?.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });
    }

    private void SetBreadcrumbs()
    {
        Breadcrumbs.ResetBreadcrumb();
        Breadcrumbs.SetBreadcrumbs(new List<Breadcrumb>()
        {
            new Breadcrumb(){ Text = Resource.Dashboard, Link = RoutingEndpoints.HOME_PAGE, Active = false },
            new Breadcrumb(){Text = Resource.Doctors, Link = RoutingEndpoints.DOCTORS_PAGE, Active = false},
            new Breadcrumb(){Text = Resource.Create, Link = RoutingEndpoints.DOCTORS_PAGE, Active = true}
        });
    }

    public async Task RegisterDoctor(EditContext editContext)
    {
        _inProgress = true;
        var user = new ApplicationUser
        {
            FirstName = Input.FirstName,
            LastName = Input.LastName,
            PhoneNumber = Input.PhoneNumber
        };

        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
        await UserManager.SetEmailAsync(user, Input.Email);

        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            _inProgress = false;
            identityErrors = result.Errors;
            var errors = identityErrors is null ? "Failed" : string.Join(", ", identityErrors.Select(error => error.Description));
            _alert.ShowFailed(errors);
            return;
        }

        await UserManager.AddToRoleAsync(user, EnumExtensions.GetDisplayName(UserRole.Doctor));

        var userId = await UserManager.GetUserIdAsync(user);

        var doctorForCreationDto = new DoctorForCreationDto
        {
            FirstName = Input.FirstName,
            LastName = Input.LastName,
            SpecialtyId = Input.SpecialtyId,
            UserId = userId,
            DepartmentId = _departmentId,
            Image = Input.Image
        };

        await DoctorService.AddDoctorAsync(doctorForCreationDto);

        _inProgress = false;
        _alert.ShowSuccess(Resource.Success);
    }

    private void HandleModalClose(bool success)
    {
        _inProgress = false;

        if (!success)
            return;

        NavigationManager.NavigateTo(RoutingEndpoints.DOCTORS_PAGE);
    }

    async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var format = e.File.ContentType;
        var resizeImage = await e.File.RequestImageFileAsync(format, 200, 200);
        var buffer = new byte[resizeImage.Size];
        await resizeImage.OpenReadStream().ReadAsync(buffer);
        Input.Image = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
    }

    private sealed class InputModel
    {
        [Required]
        [Display(Name = "First Name")]
        public string FirstName { get; set; } = "";

        [Required]
        [Display(Name = "Last Name")]
        public string LastName { get; set; } = "";

        [Required]
        [EmailAddress]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";

        public int? SpecialtyId { get; set; }
        public string? PhoneNumber { get; set; }
        public string? Image;
    }
}
