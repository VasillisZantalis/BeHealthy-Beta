@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IVisitService VisitService
@inject IDoctorService DoctorService
@inject IPatientService PatientService
@inject NavigationManager NavigationManager

@if (_showModal)
{
    <div class="modal fade show" tabindex="-1" style="display: block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title">@ModalTitle</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="_visitDto" FormName="VisitForm" OnValidSubmit="SaveVisit" Enhance>
                        <ValidationComponent @ref="_validationComponent" />
                        <div class="d-flex flex-column gap-2">
                            <div class="form-group">
                                <label for="reason" class="form-label fw-bold required">@Resource.Reason</label>
                                <InputText id="reason" @bind-Value="_visitDto.Reason" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label for="notes" class="form-label fw-bold">@Resource.Notes</label>
                                <InputText id="notes" @bind-Value="_visitDto.Notes" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label for="doctor" class="form-label fw-bold required">@Resource.Doctor</label>
                                <InputSelect id="doctor" class="form-select" @bind-Value="_visitDto.Doctor.Id">
                                    @foreach (var doctor in _doctorsSelect)
                                    {
                                        <option value="@doctor.Value">@doctor.Text</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="d-flex flex-row justify-content-end m-3 gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="Close">@Resource.Cancel</button>
                            <button type="submit" class="btn btn-success">@Resource.Save</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
@code {
    [CascadingParameter] 
    public int MedicalRecordId { get; set; }

    [CascadingParameter]
    public int PatientId { get; set; }

    [SupplyParameterFromForm]
    private VisitDto _visitDto { get; set; } = new();
    private ValidationComponent? _validationComponent;

    private int? _visitId { get; set; }
    private bool _showModal { get; set; }
    private bool _isEditMode => _visitId.HasValue;
    private List<SelectItem> _doctorsSelect = new();
    private List<SelectItem> _patientsSelect = new();

    private string ModalTitle => _isEditMode ? Resource.Edit : Resource.Create;

    protected override async Task OnInitializedAsync()
    {
        _doctorsSelect = (await DoctorService.GetAllDoctorsAsync())
            .Select(d => new SelectItem { Value = d.Id, Text = d.FullName })
            .ToList();

        _doctorsSelect.Insert(0, new SelectItem { Value = 0, Text = Resource.PleaseSelect });
    }

    protected override void OnParametersSet()
    {
        _visitDto.Patient.Id = PatientId;
        _visitDto.VisitDate = DateTime.UtcNow;
        _visitDto.MedicalRecordId = MedicalRecordId;
    }

    private void Close()
    {
        _showModal = false;
        _visitId = null;
        StateHasChanged();
        NavigationManager.Refresh(true);
    }

    public void Show(int? visitId = null)
    {
        _visitId = visitId;
        _showModal = true;
        StateHasChanged();
    }

    private async Task SaveVisit()
    {
        _validationComponent?.ClearErrors();

        ServiceResponse response;

        if (_isEditMode)
        {
            var visitUpdateDto = _visitDto.MapToUpdateDto();

            var validator = new VisitUpdateDtoValidator();
            var validationResult = validator.Validate(visitUpdateDto);

            if (!validationResult.IsValid)
            {
                var errors = validationResult.GetErrorsGroupedByProperty();
                HandleValidationErrors(errors);
                return;
            }

            response = await VisitService.UpdateVisitAsync(visitUpdateDto);
        }
        else
        {
            var visitCreateDto = _visitDto.MapToCreateDto();

            var validator = new VisitCreateDtoValidator();
            var validationResult = validator.Validate(visitCreateDto);

            if (!validationResult.IsValid)
            {
                var errors = validationResult.GetErrorsGroupedByProperty();
                HandleValidationErrors(errors);
                return;
            }

            response = await VisitService.AddVisitAsync(visitCreateDto);
        }

        if (HandleServiceResponse(response))
        {
            Close();
            ToastService.ShowToast(Resource.Success, "success");
        }
    }

    private void HandleValidationErrors(Dictionary<string, List<string>> errors) 
        => _validationComponent?.DisplayErrors(errors);
}
