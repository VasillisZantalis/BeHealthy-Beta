@rendermode @(new InteractiveServerRenderMode(false))
@inherits BasePage

@inject IVisitService VisitService
@inject NavigationManager NavigationManager

<div class="py-3">
    <CreateButton OnClick="CreateVisit" />

    @if (visits.Any())
    {
        <QuickGrid Items="visits.AsQueryable()"
                   ItemKey="@(x => x.Id)"
                   Class="table table-responsive">
            <PropertyColumn Title="@Resource.Date"
                            Property="@(x => x.VisitDate)"
                            Format="dd MMM yyyy"
                            IsDefaultSortColumn="true"
                            InitialSortDirection="SortDirection.Descending" />
            <PropertyColumn Title="@Resource.Reason"
                            Property="@(x => x.Reason)" />
            <PropertyColumn Title="@Resource.Doctor"
                            Property="@(x => x.Doctor.FullName)" />
            <PropertyColumn Title="@Resource.Patient"
                            Property="@(x => x.Patient.FullName)" />
            <PropertyColumn Title="@Resource.Notes"
                            Property="@(x => x.Notes)" />

            <TemplateColumn Title="@Resource.Actions" Align="Align.End">
                <div class="d-flex justify-content-end">
                    <button class="btn" title="@(Resource.Edit)" @onclick="@(() => EditVisit(context.Id))">
                        <Icon IconClass="@FAIcon.EditSquare" TextClass="text-warning" />
                    </button>
                    <button class="btn" title="@(Resource.Delete)" @onclick="() => ConfirmDelete(context.Id)">
                        <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />
                    </button>
                </div>
            </TemplateColumn>
        </QuickGrid>
    }
    else
    {
        <p>@string.Format(Resource.NoAvailable, Resource.Visits)</p>
    }

    <VisitModal @ref="visitModal" />
</div>


@code {

    [CascadingParameter] public int PatientId { get; set; }

    private VisitModal visitModal { get; set; } = new();
    
    private List<VisitDto> visits { get; set; } = new List<VisitDto>();

    protected override async Task OnInitializedAsync()
    {
        visits = (await VisitService.GetVisitsByPatientIdAsync(PatientId)).ToList();
    }

    private void CreateVisit() => visitModal.Show();

    private void EditVisit(int visitId) => NavigationManager.NavigateTo($"{RoutingEndpoints.VISITS_PAGE}/{visitId}");

    private void ConfirmDelete(int doctorId)
    {
        ModalService.Show<ConfirmDeleteModal>(
           new Dictionary<string, object?>
           {
               { nameof(ConfirmDeleteModal.OnConfirm), () => OnConfirmDeleteAsync(doctorId) }
           });
    }

    private async Task OnConfirmDeleteAsync(int doctorId)
    {
        await VisitService.DeleteVisitAsync(doctorId);
        await ToastService.EnqueueToastAsync(Resource.Success, "success");
        NavigationManager.Refresh(true);
    }
}
