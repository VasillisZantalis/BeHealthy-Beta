@inherits LayoutComponentBase

<ErrorBoundary>
    <ChildContent>
        <div class="page">
        <AuthorizeView>
            <NavMenu />
        </AuthorizeView>

        <main>
            <div class="top-row px-4">
                <NavToggleComponent />
                <Loader />
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex flex-row align-items-center ms-auto gap-3">
                            <CultureSelector />
                            <p class="m-0 p-0">@Resource.Hello, @context.User.Identity?.Name</p>
                            <div class="nav-item clickable">
                                <form action="/logout" method="post">
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn m-0 p-0">
                                        <Icon IconClass="@FAIcon.RightFromBracket"/>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>

            <article class="content px-4">
                <div class="snackbar rounded-pill p-3 mt-2 mb-4 text-white fw-bold fs-5">
                    <SectionOutlet SectionName="page-title"></SectionOutlet>
                </div>
                @Body
            </article>
        </main>
    </div>
    </ChildContent>
    <ErrorContent>
        <div class="d-flex justify-content-center align-items-center vh-100">
            <h2 class="text-danger">@Resource.SomethingWentWrong</h2>
        </div>
    </ErrorContent>
</ErrorBoundary>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
