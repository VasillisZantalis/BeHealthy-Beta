@inherits LayoutComponentBase

<ErrorBoundary>
    <ChildContent>
        <div class="page">
            <div class="top-row px-4" style="z-index: 10!important">
                @*  <NavToggleComponent /> *@
                <Loader />
                <ConfirmDeleteModal />
                <Toastr />
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex flex-row align-items-center ms-auto gap-3">
                            <CultureSelector />
                            <a class="m-0 p-0 nav-link" href="/profile" title="profile">@Resource.Hello, @context.User.Identity?.Name</a>
                            <div class="nav-item clickable">
                                <form action="/logout" method="post">
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn m-0 p-0">
                                        <Icon IconClass="@FAIcon.RightFromBracket" />
                                    </button>
                                </form>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>

            <main>
                <AuthorizeView>
                    @* <NavMenu /> *@
                    <Sidebar />
                </AuthorizeView>
                <article class="content">
                    <Breadcrumbs />
                    @Body
                </article>
            </main>
        </div>
    </ChildContent>
    <ErrorContent>
        <div class="d-flex justify-content-center align-items-center vh-100">
            <h2 class="text-danger">@Resource.SomethingWentWrong</h2>
        </div>
    </ErrorContent>
</ErrorBoundary>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
