@inherits LayoutComponentBase

<div class="page">
    <AuthorizeView>
        <div class="sidebar">
            <NavMenu />
        </div>
    </AuthorizeView>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex flex-row gap-3">
                        <div>
                            <SectionOutlet SectionName="page-title"></SectionOutlet>
                        </div>

                        <p>Hello, @context.User.Identity?.Name</p>
                        <div class="nav-item">
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <button type="submit" class="nav-link text-primary">
                                    <span class="bi bi-arrow-left-nav-menu" aria-hidden="true"></span> Log out
                                </button>
                            </form>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
