@inject IStringLocalizer<Resource> localizer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BeHealthy</a>
        <button title="Toggle" class="navbar-toggler btn-primary" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="nav-scrollable">
    <div class="@NavMenuCssClass">
        <nav class="flex-column">
            <div class="m-3 ms-2">
                <h5 class="text-white-50">@Resource.Management</h5>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="fa-solid fa-house fs-5"></span>&nbsp; @Resource.Dashboard
                </NavLink>
            </div>

            <AuthorizeView Roles="Admin, Doctor">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="doctors">
                        <span class="fa-solid fa-user-doctor fs-5"></span>&nbsp; @Resource.Doctors
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="nurses">
                        <span class="fa-solid fa-user-nurse fs-5"></span>&nbsp; @Resource.Nurses
                    </NavLink>
                </div>
            </AuthorizeView>

            <AuthorizeView Roles="Admin, Doctor, Nurse">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="patients">
                        <span class="fa-solid fa-viruses fs-5"></span>&nbsp; @Resource.Patients
                    </NavLink>
                </div>
            </AuthorizeView>

            <AuthorizeView Roles="Admin, Doctor, Patient">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="appointment">
                        <span class="fa-solid fa-calendar-days fs-5"></span>&nbsp; @Resource.Appointments
                    </NavLink>
                </div>
            </AuthorizeView>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="rooms">
                    <span class="fa-solid fa-bed-pulse fs-5"></span>&nbsp; @Resource.Rooms
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="auth">
                    <span class="fa-solid fa-user-lock fs-5"></span>&nbsp; @Resource.Authorization
                </NavLink>
            </div>

            <AuthorizeView Roles="Admin">
                <div class="mt-3">
                    <h5 class="ms-2 text-white-50">@Resource.Configuration</h5>
                    <div class="nav-item px-3 pt-0">
                        <NavLink class="nav-link" href="settings">
                            <span class="fa-solid fa-gear fs-5"></span>&nbsp; @Resource.Settings
                        </NavLink>
                    </div>
                    
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="departments">
                            <span class="fa-regular fa-hospital fs-5"></span>&nbsp; @Resource.Departments
                        </NavLink>
                    </div>
                </div>
            </AuthorizeView>
       
        </nav>
    </div>
</div>

@code {
    private bool collapseNavMenu = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

