@using BeHealthy.States

@inject NavMenuState NavMenuState

@rendermode InteractiveServer

<div class="sidebar-container" style="@(NavMenuState.IsVisible ? "display: block;" : "display: none;")">
    <div class="sidebar h-auto main-color">

        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="">BeHealthy</a>
            </div>
        </div>

        <div class="nav-scrollable">
            <div>
                <nav class="flex-column">
                    <div class="m-3 ms-2">
                        <h5 class="text-white-50">@Resource.Management</h5>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                            <Icon IconClass="@FAIcon.House" SizeClass="fs-5" />&nbsp; @Resource.Dashboard
                        </NavLink>
                    </div>

                    <AuthorizeView Roles="@(new[] { UserRole.Admin, UserRole.Doctor }.ToRoleString())">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@(RoutingEndpoints.DOCTORS_PAGE)">
                                <Icon IconClass="@FAIcon.UserDoctor" SizeClass="fs-5" />&nbsp; @Resource.Doctors
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@(RoutingEndpoints.NURSES_PAGE)">
                                <Icon IconClass="@FAIcon.UserNurse" SizeClass="fs-5" />&nbsp; @Resource.Nurses
                            </NavLink>
                        </div>
                    </AuthorizeView>

                    <AuthorizeView Roles="@(new[] { UserRole.Admin, UserRole.Doctor, UserRole.Nurse }.ToRoleString())">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@(RoutingEndpoints.PATIENTS_PAGE)">
                                <Icon IconClass="@FAIcon.Viruses" SizeClass="fs-5" />&nbsp; @Resource.Patients
                            </NavLink>
                        </div>
                    </AuthorizeView>

                    <AuthorizeView Roles="@(new[] { UserRole.Admin, UserRole.Doctor, UserRole.Patient }.ToRoleString())">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@(RoutingEndpoints.APPOINTMENTS_PAGE)">
                                <Icon IconClass="@FAIcon.CalendarDays" SizeClass="fs-5" />&nbsp; @Resource.Appointments
                            </NavLink>
                        </div>
                    </AuthorizeView>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="@(RoutingEndpoints.ROOMS_PAGE)">
                            <Icon IconClass="@FAIcon.BedPulse" SizeClass="fs-5" />&nbsp; @Resource.Rooms
                        </NavLink>
                    </div>

                    <AuthorizeView Roles="@(new[] { UserRole.Admin }.ToRoleString())">
                        <div class="mt-3">
                            <h5 class="ms-2 text-white-50">@Resource.Configuration</h5>
                            <div class="nav-item px-3 pt-0">
                                <NavLink class="nav-link" href="@(RoutingEndpoints.SETTINGS_PAGE)">
                                    <Icon IconClass="@FAIcon.Gear" SizeClass="fs-5" />&nbsp; @Resource.Settings
                                </NavLink>
                            </div>

                            <div class="nav-item px-3 pt-0">
                                <NavLink class="nav-link d-flex flex-row" @onclick="ToggleRoles">
                                    <Icon IconClass="@FAIcon.UserLock" SizeClass="fs-5" />&nbsp; @Resource.Role
                                    <Icon IconClass="@(!isRolesExpanded ? FAIcon.ChevronRight : FAIcon.ChevronDown)" TextClass="ms-auto" />
                                </NavLink>
                                <ul class="flex-column list-unstyled" style="@SubMenuStyle">
                                    <li class="">
                                        <NavLink class="nav-link ms-2 ps-5" href="@(RoutingEndpoints.ROLES_PRIVILEGES_PAGE)">
                                            <Icon IconClass="@FAIcon.Fingerprint" SizeClass="fs-5"/>&nbsp; @Resource.Privileges
                                        </NavLink>
                                    </li>
                                </ul>
                            </div>

                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="@(RoutingEndpoints.DEPARTMENTS_PAGE)">
                                    <Icon IconClass="@FAIcon.Hospital" SizeClass="fs-5" />&nbsp; @Resource.Departments
                                </NavLink>
                            </div>

                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="@(RoutingEndpoints.SPECIALTIES_PAGE)">
                                    <Icon IconClass="@FAIcon.Stethoscope" SizeClass="fs-5" />&nbsp; @Resource.Specialties
                                </NavLink>
                            </div>
                        </div>
                    </AuthorizeView>
                </nav>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        NavMenuState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        NavMenuState.OnChange -= StateHasChanged;
    }

    private bool isRolesExpanded = false;

    private string SubMenuStyle => isRolesExpanded ? "display: block;" : "display: none;";

    private void ToggleRoles()
    {
        isRolesExpanded = !isRolesExpanded;
    }
}
