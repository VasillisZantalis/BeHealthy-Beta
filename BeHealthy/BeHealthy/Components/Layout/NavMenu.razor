
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BeHealthy</a>
        <button title="Navigation menu" class="navbar-toggler btn-primary" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <div class="@NavMenuCssClass">
        <nav class="flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill" aria-hidden="true"></span> Dashboard
                </NavLink>
            </div>

            <AuthorizeView Roles="Admin, Doctor">
                <div class="nav-item px-3">
                    <NavLink class="nav-link px-1" href="doctors">
                        <span class="bi bi-activity" aria-hidden="true"></span> Doctors
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link px-1" href="nurses">
                        <span class="bi bi-shield-fill-plus" aria-hidden="true"></span> Nurses
                    </NavLink>
                </div>
            </AuthorizeView>

            <AuthorizeView Roles="Admin, Doctor, Nurse">
                <div class="nav-item px-3">
                    <NavLink class="nav-link px-1" href="patients">
                        <span class="bi bi-bandaid-fill" aria-hidden="true"></span> Patients
                    </NavLink>
                </div>
            </AuthorizeView>

            <AuthorizeView Roles="Admin, Doctor, Patient">
                <div class="nav-item px-3">
                    <NavLink class="nav-link px-1" href="appointment">
                        <span class="bi bi-calendar2-plus-fill" aria-hidden="true"></span> Appointments
                    </NavLink>
                </div>
            </AuthorizeView>

            <div class="nav-item px-3">
                <NavLink class="nav-link px-1" href="rooms">
                    <span class="bi bi-house-heart-fill" aria-hidden="true"></span> Rooms
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link px-1" href="auth">
                    <span class="bi bi-person-fill-lock" aria-hidden="true"></span> Auth Required
                </NavLink>
            </div>

            <AuthorizeView Roles="Admin">
                <div class="mt-3">
                    <h5 class="ms-2 text-white-50">Configuration</h5>
                    <div class="nav-item px-3 pt-0">
                        <NavLink class="nav-link px-1" href="settings">
                            <span class="bi bi-gear-fill" aria-hidden="true"></span> Settings
                        </NavLink>
                    </div>
                </div>
            </AuthorizeView>
       
        </nav>
    </div>
</div>

@code {
    private bool collapseNavMenu = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

