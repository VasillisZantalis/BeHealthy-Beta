@using BeHealthy.Models.Enums
@inherits BasePage
@typeparam TEntity

@inject IDoctorService DoctorService
@inject IPatientService PatientService
@inject IDepartmentService DepartmentService

<div class="modal" tabindex="-1" role="dialog" style="display:block;">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title">Mass Import</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                <button class="btn main-color text-white rounded-pill px-3" @onclick="Save">
                    @Resource.Save
                </button>
                <button class="btn btn-outline-secondary rounded-pill" @onclick="AddRow">
                    <Icon IconClass="@FAIcon.Plus" /> @Resource.AddRow
                </button>
                <table class="table">
                    <thead>
                        <tr>
                            @foreach (var field in FieldDefinitions)
                            {
                                <th>@field.DisplayName</th>
                            }
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Rows.Count; i++)
                        {
                            var idx = i; // Capture the current index for the lambda expression
                            <tr>
                                @foreach (var field in FieldDefinitions)
                                {
                                    <td>
                                        @RenderCell(field, Rows[idx])
                                    </td>
                                }
                                <td>
                                    <button class="btn" @onclick="@(() => RemoveRow(idx))">
                                        <Icon IconClass="@FAIcon.TrashCan" TextClass="text-danger" />
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Entity != ImportEntity.Appointment)
                {
                    <label class="form-label">
                        <InputCheckbox @bind-Value="_useValidation" class="form-check-input" id="useValidation" />
                        @Resource.UseValidation
                    </label>

                    @if (_useValidation)
                    {
                        <div class="alert alert-warning" role="alert">
                            @Resource.DisabledValidationMessage
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show"></div>

@code {
    [Parameter] public ImportEntity Entity { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(List<TEntity> Items, bool UseValidation)> OnSave { get; set; }

    private List<FieldDefinition> FieldDefinitions = [];
    private List<Dictionary<string, object>> Rows = new();

    private List<SelectItem> _doctorsSelect = new();
    private List<SelectItem> _patientsSelect = new();
    private List<SelectItem> _departmentsSelect = new();
    private bool _useValidation;

    private void Close() => OnClose.InvokeAsync();

    protected override async Task OnInitializedAsync()
    {
        LoaderService.SetLoader(true);

        var doctors = await DoctorService.GetAllDoctorsAsync();
        var patients = await PatientService.GetAllPatientsAsync(new PatientSearchingParameters());
        var departments = await DepartmentService.GetAllDepartmentsAsync();

        _doctorsSelect = doctors.Select(d => new SelectItem { Value = d.Id, Text = d.FullName }).ToList();
        _doctorsSelect.Insert(0, new SelectItem { Text = Resource.PleaseSelect, Value = 0 });

        _patientsSelect = patients.Select(p => new SelectItem { Value = p.Id, Text = p.FullName }).ToList();
        _patientsSelect.Insert(0, new SelectItem { Text = Resource.PleaseSelect, Value = 0 });

        _departmentsSelect = departments.Select(d => new SelectItem { Value = d.Id, Text = d.Name }).ToList();
        _departmentsSelect.Insert(0, new SelectItem { Text = Resource.PleaseSelect, Value = 0 });

        FieldDefinitions = FieldMapper.GetFields(Entity, _doctorsSelect, _departmentsSelect, _patientsSelect);
        AddRow();

        LoaderService.SetLoader(false);
    }

    private void AddRow()
    {
        var row = new Dictionary<string, object>();
        foreach (var field in FieldDefinitions)
        {
            row[field.Name] = field.Type switch
            {
                FieldType.Number => 0,
                FieldType.Date => DateTime.Today,
                FieldType.Time => TimeSpan.Zero,
                _ => string.Empty
            };
        }
        Rows.Add(row);
    }

    private void RemoveRow(int index)
    {
        if (!Rows.Any()) return;

        Rows.RemoveAt(index);
    }

    private async Task Save()
    {
        if (!Rows.Any()) return;

        switch (Entity)
        {
            case ImportEntity.Doctor:
                await ConvertToDoctors();
                break;
            case ImportEntity.Patient:
                await ConvertToPatients();
                break;
            case ImportEntity.Nurse:
                await ConvertToNurses();
                break;
            case ImportEntity.Appointment:
                await ConvertToAppointments();
                break;
        }
    }

    private async Task ConvertToDoctors()
    {
        var doctors = Rows.Select(row => new DoctorForCreationDto
        {
            FirstName = row.GetValueOrDefault<string>(nameof(DoctorForCreationDto.FirstName)) ?? string.Empty,
            LastName = row.GetValueOrDefault<string>(nameof(DoctorForCreationDto.LastName)) ?? string.Empty,
            Email = row.GetValueOrDefault<string>(nameof(DoctorForCreationDto.Email)) ?? string.Empty,
            Password = row.GetValueOrDefault<string>(nameof(NurseForCreationDto.Password)) ?? string.Empty,
            ConfirmPassword = row.GetValueOrDefault<string>(nameof(NurseForCreationDto.Password)) ?? string.Empty,
            DepartmentId = row.GetValueOrDefault<int?>(nameof(DoctorForCreationDto.DepartmentId))
        }).ToList();

        if (!doctors.Any() || doctors is null) return;

        await OnSave.InvokeAsync((doctors.Cast<TEntity>().ToList(), _useValidation));

        Close();
    }

    private async Task ConvertToPatients()
    {
        var patients = Rows.Select(row => new PatientForCreationDto
        {
            FirstName = row.GetValueOrDefault<string>(nameof(PatientForCreationDto.FirstName)) ?? string.Empty,
            LastName = row.GetValueOrDefault<string>(nameof(PatientForCreationDto.LastName)) ?? string.Empty,
            Email = row.GetValueOrDefault<string>(nameof(PatientForCreationDto.Email)) ?? string.Empty,
            Password = row.GetValueOrDefault<string>(nameof(NurseForCreationDto.Password)) ?? string.Empty,
            ConfirmPassword = row.GetValueOrDefault<string>(nameof(NurseForCreationDto.Password)) ?? string.Empty,
            DepartmentId = row.GetValueOrDefault<int?>(nameof(PatientForCreationDto.DepartmentId))
        }).ToList();

        if (!patients.Any() || patients is null) return;

        await OnSave.InvokeAsync((patients.Cast<TEntity>().ToList(), _useValidation));

        Close();
    }

    private async Task ConvertToNurses()
    {
        var nurses = Rows.Select(row => new NurseForCreationDto
        {
            FirstName = row.GetValueOrDefault<string>(nameof(NurseForCreationDto.FirstName)) ?? string.Empty,
            LastName = row.GetValueOrDefault<string>(nameof(NurseForCreationDto.LastName)) ?? string.Empty,
            Email = row.GetValueOrDefault<string>(nameof(NurseForCreationDto.Email)) ?? string.Empty,
            Password = row.GetValueOrDefault<string>(nameof(NurseForCreationDto.Password)) ?? string.Empty,
            ConfirmPassword = row.GetValueOrDefault<string>(nameof(NurseForCreationDto.Password)) ?? string.Empty,
            DepartmentId = row.GetValueOrDefault<int?>(nameof(NurseForCreationDto.DepartmentId))
        }).ToList();

        if (!nurses.Any() || nurses is null) return;

        await OnSave.InvokeAsync((nurses.Cast<TEntity>().ToList(), _useValidation));

        Close();
    }

    private async Task ConvertToAppointments()
    {
        var appointments = Rows.Select(row => new AppointmentForCreationDto
        {
            AppointmentDate = row.GetValueOrDefault<DateOnly>(nameof(AppointmentForCreationDto.AppointmentDate)),
            Notes = row.GetValueOrDefault<string>(nameof(AppointmentForCreationDto.Notes)) ?? string.Empty,
            PatientId = row.GetValueOrDefault<int>(nameof(AppointmentForCreationDto.PatientId)),
            DoctorId = row.GetValueOrDefault<int>(nameof(AppointmentForCreationDto.DoctorId)),
            RoomId = row.GetValueOrDefault<int?>(nameof(AppointmentForCreationDto.RoomId)),
            AppointmentStartTime = row.GetValueOrDefault<TimeOnly>(nameof(AppointmentForCreationDto.AppointmentStartTime)),
            AppointmentEndTime = row.GetValueOrDefault<TimeOnly>(nameof(AppointmentForCreationDto.AppointmentEndTime)),
            Reason = row.GetValueOrDefault<AppointmentReason>(nameof(AppointmentForCreationDto.Reason)),
        }).ToList();

        if (!appointments.Any() || appointments is null) return;

        await OnSave.InvokeAsync((appointments.Cast<TEntity>().ToList(), _useValidation));

        Close();
    }

    private RenderFragment RenderCell(FieldDefinition field, Dictionary<string, object> row) => builder =>
    {
        int seq = 0;
        switch (field.Type)
        {
            case FieldType.Text:
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "class", "form-control");
                builder.AddAttribute(seq++, "value", row[field.Name]?.ToString());
                builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => row[field.Name] = e.Value));
                builder.CloseElement();
                break;

            case FieldType.Password:
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "class", "form-control");
                builder.AddAttribute(seq++, "type", "password");
                builder.AddAttribute(seq++, "value", row[field.Name]?.ToString());
                builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => row[field.Name] = e.Value));
                builder.CloseElement();
                break;

            case FieldType.Number:
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "class", "form-control");
                builder.AddAttribute(seq++, "type", "number");
                builder.AddAttribute(seq++, "value", row[field.Name]);
                builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => row[field.Name] = Convert.ToInt32(e.Value)));
                builder.CloseElement();
                break;

            case FieldType.Date:
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "class", "form-control");
                builder.AddAttribute(seq++, "type", "date");
                builder.AddAttribute(seq++, "value", ((DateTime)row[field.Name]).ToString("yyyy-MM-dd"));
                builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => row[field.Name] = DateTime.Parse(e.Value.ToString())));
                builder.CloseElement();
                break;

            case FieldType.Time:
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "class", "form-control");
                builder.AddAttribute(seq++, "type", "time");
                builder.AddAttribute(seq++, "value", ((TimeSpan)row[field.Name]).ToString(@"hh\:mm"));
                builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => row[field.Name] = TimeSpan.Parse(e.Value.ToString())));
                builder.CloseElement();
                break;

            case FieldType.Dropdown:
                builder.OpenElement(seq++, "select");
                builder.AddAttribute(seq++, "class", "form-select");
                builder.AddAttribute(seq++, "value", row[field.Name]?.ToString());
                builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => row[field.Name] = e.Value));

                foreach (var option in field.Options)
                {
                    builder.OpenElement(seq++, "option");
                    builder.AddAttribute(seq++, "value", option.Value);
                    builder.AddContent(seq++, option.Text);
                    builder.CloseElement();
                }

                builder.CloseElement();
                break;
        }
    };
}
