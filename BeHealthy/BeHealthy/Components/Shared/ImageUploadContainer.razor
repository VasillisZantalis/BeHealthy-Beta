<div class="d-flex flex-column justify-content-center align-items-center">
    @ChildContent
    <button type="button" class="btn btn-outline-primary" @onclick="OnOpenImageUploadModal">
        <i class="fas fa-upload"></i> @Resource.UploadFile
    </button>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnOpenImageUploadModal { get; set; }
}
