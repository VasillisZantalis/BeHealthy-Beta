@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(false))

@inject LoaderServiceState LoaderService;

@if (IsLoading)
{
    <div class="overlay" style="z-index: 2000; opacity: 0.5;"></div>
    <div class="fullscreen d-flex justify-content-center align-items-center" style="z-index: 2001;">
        <div class="spinner-border h3" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {
    protected bool IsLoading { get; set; }

    protected override void OnInitialized()
    {
        LoaderService.OnChange += ChangeLoading;
    }

    public void Dispose()
    {
        LoaderService.OnChange -= ChangeLoading;
    }

    public void ChangeLoading(bool isLoading)
    {
        IsLoading = isLoading;

        StateHasChanged();
    }
}
