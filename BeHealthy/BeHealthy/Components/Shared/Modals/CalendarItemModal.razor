@rendermode InteractiveServer

@if (_showModal)
{
    <div class="modal fade show" tabindex="-1" style="display:block">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <Icon IconClass="@FAIcon.CalendarDays"/>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body text-center">
                    <div class="d-flex flex-column justify-content-center">
                        <span class="h5 fw-normal">@CalendarItem.Title</span>
                        <small>@DateTime.Parse(CalendarItem.Start).ToString("HH:mm") - @DateTime.Parse(CalendarItem.End!).ToString("HH:mm")</small>
                    </div>
                </div>
                <div class="d-flex flex-row justify-content-end m-3">
                    <button type="button" class="btn btn-lightpx-4 me-2" @onclick="CloseModal">@Resource.OK</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {

    private bool _showModal { get; set; }

    private CalendarItem CalendarItem { get; set; } = new();

    public void OpenModal(CalendarItem calendarItem)
    {
        CalendarItem = calendarItem;
        _showModal = true;
        StateHasChanged();
    }

    public void CloseModal()
    {
        _showModal = false;
    }
}
