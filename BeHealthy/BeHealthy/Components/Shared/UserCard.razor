<div class="card my-3 shadow border">
    <div class="card-body px-4">
        <div class="d-flex flex-column flex-xl-row text-truncate gap-2 gap-xl-5">
            <img class="rounded-circle" src="@(Image ?? "images/generic.jpg")" height="60" width="60" />
            <div>
                @if (!string.IsNullOrEmpty(FullName))
                {
                    <div class="form-group">
                        <span class="text-muted small-text" for="fullName">Full Name</span>
                        <h6 id="fullName" title="@FullName">@FullName</h6>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Specialty))
                {
                    <div class="form-group">
                        <span class="text-muted small-text" for="specialty">Specialty</span>
                        <h6 class="" id="specialty">@Specialty</h6>
                    </div>
                }
            </div>
        </div>
        <hr/>
        <div class="d-flex flex-column gap-2">
            <div class="form-group d-flex align-items-center gap-2">
                <span class="fa-regular fa-envelope"></span>
                <span class="fw-normal text-truncate" id="email" title="@Email">@(!string.IsNullOrEmpty(Email) ? Email : "Not provided")</span>
            </div>

            <div class="form-group d-flex align-items-center gap-2">
                <span class="fa-solid fa-mobile-screen-button"></span>
                <span class="fw-normal m-0" id="phone">@(!string.IsNullOrEmpty(Phone) ? Phone : "-")</span>
            </div>
        </div>
       
    </div>
    <div class="d-flex flex-row gap-3 justify-content-center mb-2 px-5">
        @if (CanEdit)
        {
            <button class="btn btn-outline-dark btn-sm w-100" @onclick="() => Edit.InvokeAsync(Id)">Edit</button>
        }

        @if (CanDelete)
        {
            <button class="btn btn-danger btn-sm w-100" @onclick="() => Delete.InvokeAsync(Id)">Delete</button>
        }
    </div>
</div>

@code {

    [Parameter]
    public int Id { get; set; }

    [Parameter]
    public string? FullName { get; set; }

    [Parameter]
    public string? Image { get; set; }

    [Parameter]
    public string? Email { get; set; }

    [Parameter]
    public string? Phone { get; set; }

    [Parameter]
    public string? Specialty { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    [Parameter]
    public bool CanDelete { get;set; }

    [Parameter]
    public EventCallback<int> Edit { get; set; }

    [Parameter]
    public EventCallback<int> Delete { get; set; }
}
