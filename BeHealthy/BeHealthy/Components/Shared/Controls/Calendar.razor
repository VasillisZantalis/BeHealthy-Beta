@using System.Text.Json

@inject IJSRuntime JS
@inject IAppointmentService AppointmentService
@inject IDoctorService DoctorService
@inject IPatientService PatientService
@inject AuthenticationStateProvider ASP

<div id="calendar"></div>

<CalendarItemModal @ref="calendarItemModal" />

@code {
    private List<CalendarItem> calendarItems = new();
    private static CalendarItem calendarItem = new();

    private static CalendarItemModal calendarItemModal = new();
    List<AppointmentDto> appointments = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await ASP.GetAuthenticationStateAsync();
        var userId = authState.User.GetUserId();

        switch (authState.User.GetUserRoleEnum())
        {
            case UserRole.Doctor when userId is not null:
                appointments = (await AppointmentService.GetAllAppointmentsByUserIdAsync(userId)).ToList();
                break;
            case UserRole.Patient when userId is not null:
                appointments = (await AppointmentService.GetAllAppointmentsByUserIdAsync(userId)).ToList();
                break;
            default:
                appointments = (await AppointmentService.GetAllAppointmentsAsync()).ToList();
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        calendarItems = appointments
            .Select(a => new CalendarItem
                {
                    Title = $"{a.Reason.ToLocalizedString()} - {a.Patient?.FullName ?? "Unknown Patient"}",
                    Start = a.AppointmentDate
                        .ToDateTime(a.AppointmentStartTime)
                        .ToString("yyyy-MM-ddTHH:mm:ss"),
                                End = a.AppointmentDate
                        .ToDateTime(a.AppointmentEndTime)
                        .ToString("yyyy-MM-ddTHH:mm:ss"),
                    Description = a.Notes,
                    BackgroundColor = a.Status.GetStatusColor(),
                    BorderColor = a.Status.GetStatusColor(),
                    Color = a.Status.GetStatusColor()
                }).ToList();

        await JS.InvokeVoidAsync("initializeCalendar", calendarItems);
    }

    [JSInvokable]
    public static void ConsoleEvent(string calendarEvent)
    {
        var calItem = JsonSerializer.Deserialize<CalendarItem>(calendarEvent);
        calendarItem = calItem ?? new();

        calendarItemModal.OpenModal(calendarItem);
    }
}