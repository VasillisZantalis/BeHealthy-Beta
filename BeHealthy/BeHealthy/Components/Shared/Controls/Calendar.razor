@using System.Text.Json
@rendermode @(new InteractiveServerRenderMode(false))
@implements IDisposable

@inject IJSRuntime JS
@inject IAppointmentService AppointmentService
@inject IDoctorService DoctorService
@inject IPatientService PatientService
@inject AuthenticationStateProvider ASP


<div id="calendar"></div>

<CalendarItemModal @ref="calendarItemModal" />

@code {
    private List<CalendarItem> calendarItems = new();
    private CalendarItem calendarItem = new();
    private CalendarItemModal calendarItemModal = new();
    private DotNetObjectReference<Calendar>? dotNetRef;

    List<AppointmentDto> appointments = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await ASP.GetAuthenticationStateAsync();
        var userId = authState.User.GetUserId();

        switch (authState.User.GetUserRoleEnum())
        {
            case UserRole.Doctor when userId is not null:
                appointments = (await AppointmentService.GetAllAppointmentsByUserIdAsync(userId)).ToList();
                break;
            case UserRole.Patient when userId is not null:
                appointments = (await AppointmentService.GetAllAppointmentsByUserIdAsync(userId)).ToList();
                break;
            default:
                appointments = (await AppointmentService.GetAllAppointmentsAsync()).ToList();
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            calendarItems = appointments
                .Select((a, index) => new CalendarItem
                {
                    Id = index + 1,
                    Title = $"{a.Reason.ToLocalizedString()} - {a.Patient?.FullName ?? "Unknown"}",
                    Start = a.AppointmentDate.ToDateTime(a.AppointmentStartTime).ToString("yyyy-MM-ddTHH:mm:ss"),
                    End = a.AppointmentDate.ToDateTime(a.AppointmentEndTime).ToString("yyyy-MM-ddTHH:mm:ss"),
                    Description = a.Notes,
                    BackgroundColor = a.Status.GetStatusColor(),
                    BorderColor = a.Status.GetStatusColor(),
                    Color = a.Status.GetStatusColor()
                }).ToList();

            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initializeCalendar", dotNetRef, calendarItems);
        }
    }

    [JSInvokable]
    public void ConsoleEvent(string calendarEvent)
    {
        var calItem = JsonSerializer.Deserialize<CalendarItem>(calendarEvent);
        calendarItem = calItem ?? new();

        calendarItemModal.OpenModal(calendarItem);
    }

    [JSInvokable]
    public void OpenEventModal(CalendarItem calendarItem)
    {
        calendarItemModal.OpenModal(calendarItem);
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}