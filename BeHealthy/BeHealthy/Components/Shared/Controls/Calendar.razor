@inject IJSRuntime JS
@inject IAppointmentService AppointmentService
@inject IDoctorService DoctorService
@inject IPatientService PatientService
@inject AuthenticationStateProvider ASP

<div id="calendar"></div>

@code {
    private List<CalendarItem> calendarItems = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        calendarItems = (await AppointmentService.GetAllAppointmentsAsync())
            .ToList()
            .Select(a => new CalendarItem
            {
                Id = a.Id,
                Title = $"{a.Reason} - {a.Patient?.FullName ?? "Unknown Patient"}",
                Start = a.AppointmentDate.ToFullDateTimeString(),
                End = a.AppointmentDate.AddMinutes(a.Duration).ToFullDateTimeString(),
                Description = a.Notes,
                BackgroundColor = a.Status == AppointmentStatus.Scheduled ? "" : "",
                BorderColor = a.Status == AppointmentStatus.Scheduled ? "" : "",
                Color = "red"
            }).ToList();

        await JS.InvokeVoidAsync("initializeCalendar", calendarItems);
    }
}