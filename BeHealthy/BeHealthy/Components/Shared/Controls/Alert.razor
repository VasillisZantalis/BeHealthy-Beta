@if (_showAlert)
{
    <div class="alert alert-@_severity.ToString().ToLower() alert-dismissible fade show" role="alert">
        <div class="d-flex flex-row gap-2">
            <span class="fs-5 @_icon text-@_severity.ToString().ToLower()"></span>
            <span class="fw-bold">@Message</span>
            @if (ShowCloseButton)
            {
                <button @onclick="CloseAlert" type="button" class="btn-close" aria-label="Close"></button>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    private Severity _severity { get; set; }

    private bool _showAlert = false;

    private string? _icon;

    private void CloseAlert()
    {
        _showAlert = false;
        StateHasChanged();
    }

    public void ShowFailed(string? message)
    {
        _showAlert = true;
        _severity = Severity.Danger;
        _icon = FAIcon.CircleXmark;
        Message = message ?? Resource.SomethingWentWrong;
        StateHasChanged();
    }

    public void ShowSuccess(string? message)
    {
        _showAlert = true;
        _severity = Severity.Success;
        _icon = FAIcon.CircleCheck;
        Message = message ?? Resource.Success;
        StateHasChanged();
    }

    public void ShowInfo(string message)
    {
        _showAlert = true;
        _severity = Severity.Info;
        _icon = FAIcon.CircleInfo;
        Message = message;
        StateHasChanged();
    }

    public void ShowWarning(string message)
    {
        _showAlert = true;
        _severity = Severity.Warning;
        _icon = FAIcon.TriangleExclamation;
        Message = message;
        StateHasChanged();
    }
}
