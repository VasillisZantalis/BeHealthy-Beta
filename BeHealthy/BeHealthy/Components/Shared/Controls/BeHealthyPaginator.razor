@rendermode @(new InteractiveServerRenderMode(false))

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
    <div class="text-muted small">
        @if (TotalItems > 0)
        {
            var startItem = (CurrentPage - 1) * PageSize + 1;
            var endItem = Math.Min(CurrentPage * PageSize, TotalItems);
            <span>Showing @startItem to @endItem of @TotalItems items</span>
        }
        else
        {
            <span>No items to display</span>
        }
    </div>

    <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm mb-0">
            <!-- First Page -->
            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => OnPageChanged(1)" disabled="@(CurrentPage == 1)">
                    <Icon IconClass="@FAIcon.AngleDoubleLeft" />
                </button>
            </li>

            <!-- Previous Page -->
            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => OnPageChanged(CurrentPage - 1)" disabled="@(CurrentPage == 1)">
                    <Icon IconClass="@FAIcon.AngleLeft" />
                </button>
            </li>

            <!-- Page Numbers -->
            @foreach (var pageItem in GetPageNumbers())
            {
                <li class="page-item @(pageItem == CurrentPage ? "active" : "")">
                    <button class="page-link" @onclick="() => OnPageChanged(pageItem)">
                        @pageItem
                    </button>
                </li>
            }

            <!-- Next Page -->
            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => OnPageChanged(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)">
                    <Icon IconClass="@FAIcon.AngleRight" />
                </button>
            </li>

            <!-- Last Page -->
            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => OnPageChanged(TotalPages)" disabled="@(CurrentPage == TotalPages)">
                    <Icon IconClass="@FAIcon.AngleDoubleRight" />
                </button>
            </li>
        </ul>
    </nav>

    <div class="d-flex align-items-center gap-2">
        <label class="small mb-0">Items per page:</label>
        <select class="form-select form-select-sm" style="width: auto;" @bind="PageSize" @bind:after="OnPageSizeChanged">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public int MaxVisiblePages { get; set; } = 5;

    private int TotalPages => (int)Math.Ceiling((double)TotalItems / PageSize);

    private async Task OnPageChanged(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage)
            return;

        await CurrentPageChanged.InvokeAsync(page);
    }

    private async Task OnPageSizeChanged()
    {
        // Reset to first page when page size changes
        await CurrentPageChanged.InvokeAsync(1);
        await PageSizeChanged.InvokeAsync(PageSize);
    }

    private IEnumerable<int> GetPageNumbers()
    {
        var pages = new List<int>();
        
        if (TotalPages <= MaxVisiblePages)
        {
            // Show all pages
            for (int i = 1; i <= TotalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            int start = Math.Max(1, CurrentPage - MaxVisiblePages / 2);
            int end = Math.Min(TotalPages, start + MaxVisiblePages - 1);
            
            if (end - start < MaxVisiblePages - 1)
            {
                start = Math.Max(1, end - MaxVisiblePages + 1);
            }
            
            for (int i = start; i <= end; i++)
            {
                pages.Add(i);
            }
        }
        
        return pages;
    }
}
