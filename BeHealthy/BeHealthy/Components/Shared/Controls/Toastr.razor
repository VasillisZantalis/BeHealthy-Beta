<div class="toaster-container" style="position: fixed; top: 60px; right: 20px; z-index: 9999; min-width: 300px">
    @if (_showToastr)
    {
        <div class="alert alert-@_severity.ToString().ToLower() alert-dismissible fade show">
            <span class="fs-5 @_icon text-@_severity.ToString().ToLower()"></span>
            <span class="fw-bold">@Message</span>
            <button @onclick="CloseToastr" type="button" class="btn-close" aria-label="Close"></button>
        </div>
    }
</div>

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public int Duration { get; set; } = 3000;
    private bool _showToastr { get; set; } = false;
    private Severity _severity { get; set; }
    private string? _icon;

    private void CloseToastr() => _showToastr = false;

    private async Task ShowToast(string message, Severity severity, string icon, int? duration = null)
    {
        Message = message;
        _severity = severity;
        _icon = icon;
        _showToastr = true;
        StateHasChanged();

        await Task.Delay(duration ?? Duration);
        _showToastr = false;
        StateHasChanged();
    }

    public Task ShowFailed(string message, int? duration = null) =>
        ShowToast(message, Severity.Danger, FAIcon.CircleXmark, duration);

    public Task ShowSuccess(string message, int? duration = null) =>
        ShowToast(message, Severity.Success, FAIcon.CircleCheck, duration);

    public Task ShowInfo(string message, int? duration = null) =>
        ShowToast(message, Severity.Info, FAIcon.CircleInfo, duration);

    public Task ShowWarning(string message, int? duration = null) =>
        ShowToast(message, Severity.Warning, FAIcon.TriangleExclamation, duration);

}
