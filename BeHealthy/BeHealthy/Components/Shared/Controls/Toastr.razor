@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(false))

<div class="toaster-container" style="position: fixed; top: 60px; right: 20px; z-index: 9999; min-width: 300px">
    @if (_showToastr)
    {
        <div class="alert alert-@_severity.ToString().ToLower() alert-dismissible fade show">
            <span class="fs-5 @_icon text-@_severity.ToString().ToLower()"></span>
            <span class="fw-bold">@Message</span>
            <button @onclick="CloseToastr" type="button" class="btn-close" aria-label="Close"></button>
            <div class="progress mt-2" role="progressbar" aria-label="Toastr progress bar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar bg-@_severity.ToString().ToLower()" style="width: @_progressWidth%"></div>
            </div>
        </div>
    }
</div>

@code {
    [Inject] private ToastrStateService ToastrStateService { get; set; } = default!;
    private bool _showToastr { get; set; } = false;
    private string? Message { get; set; }
    private Severity _severity { get; set; }
    private string? _icon;
    private int _progressWidth = 100;

    protected override void OnInitialized()
    {
        ToastrStateService.OnShow += ShowToastAsync;
    }

    public void Dispose()
    {
        ToastrStateService.OnShow -= ShowToastAsync;
    }

    private async Task ShowToastAsync(ToastrNotification notification)
    {
        Message = notification.Message;
        _severity = notification.Severity;
        _icon = notification.Icon;
        _showToastr = true;
        _progressWidth = 100;
        StateHasChanged();

        int duration = notification.Duration ?? 3000;
        int steps = 100;
        int delay = duration / steps;

        for (int i = 0; i < steps; i++)
        {
            _progressWidth -= 100 / steps;
            StateHasChanged();
            await Task.Delay(delay);
        }
        _showToastr = false;
        StateHasChanged();
    }

    private void CloseToastr() => _showToastr = false;
}
