@implements IDisposable

@rendermode @(new InteractiveServerRenderMode(false))
@inject ToastService ToastService

<div class="toaster-container" style="position: fixed; top: 60px; right: 20px; z-index: 9999; min-width: 300px">
    @foreach (var toast in _toasts)
    {
        <div class="alert alert-@toast.Type alert-dismissible fade show">
            <span class="fw-bold">@toast.Message</span>
        </div>
    }
</div>

@code {
    private List<(string Message, string Type)> _toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += AddToast;
    }

    public void Dispose()
    {
        ToastService.OnShow -= AddToast;
    }

    private void AddToast(string message, string type)
    {
        _toasts.Add((message, type));
        StateHasChanged();

        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            _toasts.RemoveAt(0);
            InvokeAsync(StateHasChanged);
        });
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ToastService.FlushToasts();
        }
    }
}
