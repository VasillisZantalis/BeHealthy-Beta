<div class="dropdown">
    <button class="btn btn-sm" type="button" @onclick="ToggleDropdown">
        <Icon IconClass="@FAIcon.EllipsisVertical" />
        @if (!string.IsNullOrEmpty(ButtonText))
        {
            @ButtonText
        }
    </button>
    <div class="dropdown-menu" style="@dropdownStyle">
        @ChildContent
    </div>
</div>

@code {
    private bool isDropdownOpen = false;
    private string dropdownStyle => isDropdownOpen ? "display: block; position: fixed; transform: translateX(-100%);" : "display: none;";

    [Parameter] public string? ButtonText { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }
}
