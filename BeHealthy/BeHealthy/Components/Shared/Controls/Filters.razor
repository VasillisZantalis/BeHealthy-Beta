@typeparam TFilter

<div id="filters-container" class="mt-3">
    <div class="row">
       @ChildContent
        <div class="col-12 text-end mt-3">
            <button class="btn btn-light" @onclick="OnSearchClicked">
                <Icon IconClass="@FAIcon.Search" />
                @Resource.Search
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public TFilter FilterModel { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<TFilter> OnSearch { get; set; }

    protected override void OnParametersSet()
    {
        Console.WriteLine($"TYPE: {FilterModel.GetType()}");
    }

    private async Task OnSearchClicked()
    {
        await OnSearch.InvokeAsync(FilterModel);
    }
}