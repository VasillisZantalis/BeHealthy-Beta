@typeparam TFilter

<div id="filters-container" class="mt-3">
    <div class="card border rounded p-3">
        <div class="row">
            @ChildContent
            <div class="col-4 text-end">
                <button class="btn btn-sm main-color text-white" @onclick="OnSearchClicked">
                    <Icon IconClass="@FAIcon.Search" />
                    @Resource.Search
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public TFilter FilterModel { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<TFilter> OnSearch { get; set; }

    private async Task OnSearchClicked()
    {
        await OnSearch.InvokeAsync(FilterModel);
    }
}