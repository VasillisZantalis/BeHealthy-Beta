<div id="filters-container" class="mb-3">
    <form>
        <fieldset class="border rounded px-3 py-1">
            <legend>@Resource.Filters</legend>
            <div class="row">
                <div class="col-12 col-sm-6">
                    <label for="firstNameFilter" class="form-label fs-7">@Resource.FirstName</label>
                    <input id="firstNameFilter" class="form-control" @bind="_filters.FirstName" />
                </div>
                <div class="col-12 col-sm-6">
                    <label for="lastNameFilter" class="form-label fs-7">@Resource.LastName</label>
                    <input id="lastNameFilter" class="form-control" @bind="_filters.LastName" />
                </div>
                <div class="col-12 text-end mt-3">
                    <button class="btn btn-light" @onclick="OnSearchClicked">
                        <Icon IconClass="@FAIcon.Search" />
                        @Resource.Search
                    </button>
                </div>
            </div>
        </fieldset>
    </form>
</div>

@code {
    [Parameter] 
    public EventCallback<PatientSearchingParameters>OnSearch { get; set; }

    private PatientSearchingParameters _filters = new();

    private async Task OnSearchClicked()
    {
        await OnSearch.InvokeAsync(_filters);
    }
}