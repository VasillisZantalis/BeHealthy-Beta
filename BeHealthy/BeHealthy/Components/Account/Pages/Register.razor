@page "/Account/Register"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using AutoMapper
@using BeHealthy.Services.Interfaces
@using BeHealthy.Shared.Models
@using BeHealthy.Shared.Models.Dtos.Nurse
@using BeHealthy.Shared.Models.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject IDoctorService DoctorService
@inject INurseService NurseService
@inject IPatientService PatientService
@inject SignInManager<ApplicationUser> SignInManager
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>


<div class="row d-flex justify-content-center">
    <div class="col-md-4 rounded p-4 shadow">
        @* <h3 class="alert-danger">@Message</h3> *@

        <EditForm id="RegisterForm" Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="Enhance">
            <DataAnnotationsValidator />
            <h2>Create a new account</h2>
            <hr />
            <div class="row">
                <Alert @ref="_alert" />
                @* <ValidationSummary class="text-danger" role="alert" /> *@
                <div class="col-12 col-sm-6">
                    <div class="form-floating mb-3">
                        <InputText @bind-Value="Input.FirstName" class="form-control" aria-required="true" id="firstName" placeholder="First Name" />
                        <label for="firstName">First Name</label>
                        <ValidationMessage For="() => Input.FirstName" class="text-danger" />
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="form-floating mb-3">
                        <InputText @bind-Value="Input.LastName" class="form-control" autocomplete="username" aria-required="true" id="lastName" placeholder="Last Name" />
                        <label for="lastName">Last Name</label>
                        <ValidationMessage For="() => Input.LastName" class="text-danger" />
                    </div>
                </div>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" id="email" placeholder="name@example.com" />
                <label for="email">Email</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" id="password" placeholder="Password" />
                <label for="password">Password</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" id="confirmPassword" placeholder="Confirm Password" />
                <label for="confirmPassword">Confirm Password</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            @if (Input.Role == nameof(UserRole.Doctor))
            {
                <div class="form-floating mb-3">
                    <InputText id="specialty" @bind-Value="Input.Specialty" class="form-control" aria-required="true" placeholder="Specialty" />
                    <label for="specialty">Specialty</label>
                    <ValidationMessage For="() => Input.Specialty" class="text-danger" />
                </div>

                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.PhoneNumber" class="form-control" aria-required="true" placeholder="Phone Number" />
                    <label for="@Input.PhoneNumber">Phone Number</label>
                    <ValidationMessage For="() => Input.PhoneNumber" class="text-danger" />
                </div>
            }
            <div class="form-floating mb-3">
                <InputSelect id="role" @bind-Value="Input.Role" class="form-control" disabled="@_isDisabled">
                    @foreach (var role in Enum.GetNames(typeof(UserRole)))
                    {
                        <option value="@role">@role</option>
                    }
                </InputSelect>
                <label for="role">Role</label>
                <ValidationMessage For="() => Input.Role" class="text-danger" />
            </div>
            <div class="d-flex flex-lg-row flex-column gap-2 justify-content-evenly">
                <a class="btn btn-outline-dark px-3 w-100" href="@returnUrl">Cancel</a>
                <button type="submit" class="btn btn-primary w-100" disabled="@_inProgress">
                    @if (_inProgress)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Create
                </button>
            </div>
        </EditForm>
    </div>
</div>

@* <AlertModal @ref="_alertModal"
    OnClose="HandleModalClose"
    Success="@_alertSuccess"
    Message="@_alertMessage" /> *@

@code {
    private IEnumerable<IdentityError>? identityErrors;
    //private List<string> Roles = new List<string>();

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();
    private string returnUrl = "/";
    private bool _inProgress = false;
    private bool _isDisabled = false;

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    //private string _alertMessage = string.Empty;
    //private bool _alertSuccess;
    //private AlertModal _alertModal = new();

    private Alert _alert = new();

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var roleFromQuery = QueryHelpers.ParseQuery(uri.Query).TryGetValue("role", out var role) ? role.ToString() : null;

        if (!string.IsNullOrEmpty(roleFromQuery))
        {
            Input.Role = roleFromQuery;
            _isDisabled = true;
        }

        returnUrl = QueryHelpers.ParseQuery(uri.Query).TryGetValue("redirectUrl", out var returnTo) && !string.IsNullOrEmpty(returnTo)
            ? returnTo.ToString()
            : RoutingEndpoints.HomePage;
    }

    public async Task RegisterUser(EditContext editContext)
    {
        _inProgress = true;
        var user = new ApplicationUser();
        user.FirstName = Input.FirstName;
        user.LastName = Input.LastName;

        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
        await UserManager.SetEmailAsync(user, Input.Email);
        user.EmailConfirmed = true;

        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            _inProgress = false;
            identityErrors = result.Errors;
            var errors = identityErrors is null ? "Failed" : string.Join(", ", identityErrors.Select(error => error.Description));
            _alert.ShowFailed(errors);
            return;
        }

        if (!await RoleManager.RoleExistsAsync(Input.Role))
        {
            await RoleManager.CreateAsync(new IdentityRole(Input.Role));
        }
        await UserManager.AddToRoleAsync(user, Input.Role);

        var userId = await UserManager.GetUserIdAsync(user);

        switch (Input.Role)
        {
            case nameof(UserRole.Doctor):
                var doctorDto = ToDoctor(userId);
                await DoctorService.AddDoctorAsync(doctorDto);
                break;
            case nameof(UserRole.Nurse):
                var nurseDto = ToNurse(userId);
                await NurseService.AddNurseAsync(nurseDto);
                break;
            case nameof(UserRole.Patient):
                var patientDto = ToPatient(userId);
                await PatientService.AddPatientAsync(patientDto);
                break;
        }

        _inProgress = false;
        string successMessage = "Successful";
        _alert.ShowSuccess(successMessage);
    }

    private void HandleModalClose(bool success)
    {
        _inProgress = false;

        if (!success)
            return;

        NavigationManager.NavigateTo(returnUrl);
    }

    private DoctorForCreationDto ToDoctor(string userId)
    {
        return new DoctorForCreationDto
        {
            FirstName = Input.FirstName,
            LastName = Input.LastName,
            Specialty = Input.Specialty ?? string.Empty,
            UserId = userId
        };
    }

    private NurseForCreationDto ToNurse(string userId)
    {
        return new NurseForCreationDto
        {
            FirstName = Input.FirstName,
            LastName = Input.LastName,
            UserId = userId
        };
    }

    private PatientForCreationDto ToPatient(string userId)
    {
        return new PatientForCreationDto
        {
            FirstName = Input.FirstName,
            LastName = Input.LastName,
            UserId = userId
        };
    }

    private sealed class InputModel
    {
        [Required]
        [Display(Name = "First Name")]
        public string FirstName { get; set; } = "";

        [Required]
        [Display(Name = "Last Name")]
        public string LastName { get; set; } = "";

        [Required]
        [EmailAddress]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";

        [Required]
        [Display(Name = "Role")]
        public string Role { get; set; } = "";

        // Doctor specific fields
        public string? Specialty { get; set; }
        public string? PhoneNumber { get; set; }
    }
}
