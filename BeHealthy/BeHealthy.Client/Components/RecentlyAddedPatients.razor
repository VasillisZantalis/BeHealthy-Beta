@using BeHealthy.Shared.Models.Dtos.Patient
@inject IPatientService patientService

<div id="recentlyAddedPatientsDiv" class="overflow-auto rounded shadow p-3">
    <h5>Recently Added Patients</h5>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>Given Name</th>
                    <th>Surname</th>
                    <th>Joined At</th>
                </tr>
            </thead>
            <tbody>
                @if (_patients != null)
                {
                    foreach (var patient in _patients)
                    {
                        <tr>
                            <td style="width: 50px;">
                                <img class="w-75 rounded-circle" src="images/generic.jpg" />
                            </td>
                            <td>@patient.FirstName</td>
                            <td>@patient.LastName</td>
                            <td>@DateTimeExtensions.ToShortDateString(patient.CreatedAt)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<PatientDto> _patients { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Now.Date;

        _patients = (await patientService.GetAllPatientsAsync())
            .Where(p => p.CreatedAt > today.AddDays(-10))
            .Take(10)
            .ToList();
    }
}
