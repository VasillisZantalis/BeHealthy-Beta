@inject INurseService nurseService

<div id="totalNursesDiv">
    <div class="card rounded shadow border-0 border-start border-5 border-warning my-3">
        <div class="card-body">
            <div class="d-flex flex-row flex-wrap gap-2">
                <span class="fa-solid fa-user-nurse fs-4"></span>
                <h5 class="align-self-center">Nurses</h5>
            </div>
            <h5 class="text-muted text-center fs-2">@totalNursesCount</h5>
        </div>
    </div>
</div>


@code {
    private int totalNursesCount;

    protected override async Task OnInitializedAsync()
    {
        totalNursesCount = (await nurseService.GetAllNursesAsync()).Count();
    }

}
