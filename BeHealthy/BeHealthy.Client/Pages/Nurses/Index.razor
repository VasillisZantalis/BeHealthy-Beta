@page "/nurses"
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Nurses</PageTitle>

<h3>Nurses</h3>

<CreateUserButton Href="@_createUserHref" />

@if (_nurses == null)
{
    <Loader />
}
else if (!_nurses.Any())
{
    <p>No Nurses available</p>
}
else
{
    <div class="row">
        @foreach (var nurse in _nurses)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 col-xxl-3">
                <div class="mb-3">
                    <UserCard Id="@nurse.UserId"
                              FullName="@nurse.FullName"
                              Email="@string.Empty"
                              Edit="@(() => {})"
                              Delete="@DeleteNurse" />
                </div>
            </div>
        }
    </div>
}