@page "/nurses"
@attribute [Authorize]
@rendermode InteractiveWebAssembly

<PageTitle>Nurses</PageTitle>

<SectionContent SectionName="page-title">Nurses</SectionContent>

<CreateUserButton Href="@_createUserHref" />

@if (_isLoading)
{
    <Loader />
}
else if (_nurses is null)
{
    <p>No Nurses available</p>
}
else
{
    <div class="row">
        @foreach (var nurse in _nurses)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 col-xxl-3">
                <div class="mb-3">
                    <UserCard Id="@nurse.Id"
                              FullName="@nurse.FullName"
                              Email="@string.Empty"
                              Edit="@EditNurse"
                              Delete="@DeleteNurse" />
                </div>
            </div>
        }
    </div>
}