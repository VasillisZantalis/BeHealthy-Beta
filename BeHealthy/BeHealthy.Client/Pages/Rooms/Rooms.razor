@page "/rooms"
@attribute [Authorize]
@rendermode InteractiveAuto

@inject IRoomService RoomService

<SectionContent SectionName="page-title">Rooms</SectionContent>

@if (_rooms == null)
{
    <Loader />
}
else if (_rooms is null)
{
    <p>No rooms available.</p>
}
else
{
    
}

@code {
    private IEnumerable<RoomDto> _rooms = default!;

    protected override async Task OnInitializedAsync()
    {
        _rooms = await RoomService.GetAllRoomsAsync();
    }
}
