@page "/appointment"
@attribute [Authorize]
@rendermode InteractiveWebAssembly

<SectionContent SectionName="page-title">Appointments</SectionContent>

<div class="">
    <button class="btn btn-light px-4 mb-3" @onclick="() => _appointmentModal.Open()">
        <span class="fa-solid fa-plus" aria-hidden="true"></span> Create
    </button>
</div>

@if (_isLoading)
{
    <Loader/>
}
else if (_appointments is null)
{
    <p>No Appointments available.</p>
}
else
{
    <div class="appointmentsTableDiv mt-3">
        <div class="card">
            <div class="card-header d-flex flex-row justify-content-end">
                <div class="px-1">
                    <InputSelect class="form-select form-select-sm" @bind-Value="_paginationState.ItemsPerPage">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </InputSelect>
                </div>
            </div>
            <div class="table-responsive">
                <div class="card-body pb-2 px-0 m-0">
                    <QuickGrid Class="table rounded"
                               Items="@_appointments.AsQueryable()"
                               ItemKey="@(x => x.Id)"
                               Pagination="_paginationState">
                        <PropertyColumn Title="Date"
                                        Property="@(x => x.AppointmentDate)"
                                        Format="dd MMM yyyy HH:mm"
                                        Sortable="true"
                                        IsDefaultSortColumn="true"
                                        InitialSortDirection="SortDirection.Descending" />
                        <PropertyColumn Title="Notes"
                                        Property="@(x => string.IsNullOrEmpty(x.Notes) ? "-" : x.Notes)" />
                        <PropertyColumn Title="Patient"
                                        Property="@(x => x.Patient != null ? x.Patient.FullName : "N/A")"
                                        Sortable="true" />
                        <PropertyColumn Title="Doctor"
                                        Property="@(x => x.Doctor != null ? x.Doctor.FullName : "N/A")"
                                        Sortable="true" />
                        <PropertyColumn Title="Duration"
                                        Property="@(x => x.Duration)"
                                        Sortable="true" />
                        <PropertyColumn Title="Reason"
                                        Property="@(x => EnumExtensions.GetDisplayName(x.Reason))" />
                        <TemplateColumn Title="Status"
                                        TGridItem="AppointmentDto">
                            <span class="badge @context.Status.GetBadgeClass()">
                                @EnumExtensions.GetDisplayName(@context.Status)
                            </span>
                        </TemplateColumn>

                        @if (_hasActionRights)
                        {
                            <TemplateColumn>
                                <ActionsDropdown>
                                    <button class="btn w-100 text-start" @onclick="@(() => EditAppointment(context.Id))">
                                        <span class="fa-solid fa-pencil text-warning"></span>&nbsp; Edit
                                    </button>
                                    <button class="btn w-100 text-start" @onclick="async () => await DeleteAppointment(context.Id)">
                                        <span class="fa-solid fa-trash-can text-danger"></span>&nbsp; Delete
                                    </button>
                                </ActionsDropdown>
                            </TemplateColumn>
                        }
                    </QuickGrid>

                </div>

            </div>
            <div id="paginatorDiv" class="px-3">
                <Paginator State="_paginationState" />
            </div>
        </div>
    </div>
}

<AppointmentModal @ref="_appointmentModal"
                OnFormSubmit="HandleAppointmentFormSubmission" 
                Doctors="_doctors"
                Patients="_patients"/>
