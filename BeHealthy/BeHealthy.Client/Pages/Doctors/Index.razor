@page "/doctors"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Doctors</PageTitle>

<h3>Doctors</h3>

<CreateUserButton Href="@_createUserHref" />

@if (_doctors == null)
{
    <p><em>Loading...</em></p>
}
else if (!_doctors.Any())
{
    <p>No Doctors available</p>
}
else
{
    <div class="row">
        @foreach (var doctor in _doctors)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 col-xxl-3">
                <div class="mb-3">
                    <UserCard Id="@doctor.UserId"
                              FullName="@doctor.FullName"
                              Email="@string.Empty"
                              Edit="@EditDoctor"
                              Delete="@DeleteDoctor" />
                </div>
            </div>
        }
    </div>
}
