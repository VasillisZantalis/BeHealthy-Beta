@page "/doctors"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Doctors</PageTitle>

<h3>Doctors</h3>

<CreateUserButton Href="@_createUserHref" />

@if (_doctors == null)
{
    <p><em>Loading...</em></p>
}
else
{
    foreach (var doctor in _doctors)
    {
        <p>@doctor.FirstName @doctor.LastName</p>
    }
}
