@page "/doctors"
@attribute [Authorize]
@rendermode InteractiveWebAssembly

<PageTitle>Doctors</PageTitle>

<SectionContent SectionName="page-title">Doctors</SectionContent>

<CreateUserButton Href="@_createUserHref" />

@if (_isLoading)
{
    <Loader />
}
else if (_doctors is null)
{
    <p>No Doctors available</p>
}
else
{
    <div class="row">
        @foreach (var doctor in _doctors)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 col-xxl-3">
                <div class="mb-3">
                    <UserCard Id="@doctor.Id"
                              FullName="@doctor.FullName"
                              Email="@string.Empty"
                              Specialty="@doctor.Specialty"
                              Edit="@EditDoctor"
                              Delete="@DeleteDoctor" />
                </div>
            </div>
        }
    </div>
}
