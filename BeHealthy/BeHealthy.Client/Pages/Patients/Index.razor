@page "/patients"
@attribute [Authorize]
@rendermode InteractiveWebAssembly

<PageTitle>Patients</PageTitle>

<SectionContent SectionName="page-title">Patients</SectionContent>

<CreateUserButton Href="@_createUserHref" />

@if (_isLoading)
{
    <Loader />
}
else if (_patients is null)
{
    <p>No patients available</p>
}
else
{
   @*  <div class="row">
        @foreach (var patient in _patients)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 col-xxl-3">
                <div class="mb-3">
                    <UserCard Id="@patient.Id"
                              FullName="@patient.FullName"
                              Email="@string.Empty"
                              Edit="@(() => {})"
                              Delete="@DeletePatient" />
                </div>
            </div>
        }
    </div> *@

    <div class="patientsTableDiv mt-3">
        <div class="card">
            <div class="card-header d-flex flex-row justify-content-end">
                <div class="px-1">
                    <InputSelect class="form-select form-select-sm" @bind-Value="_paginationState.ItemsPerPage">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </InputSelect>
                </div>
            </div>
            <div class="card-body pb-2 px-0 m-0">
                <QuickGrid  Class="table table-responsive"
                            Items="@_patients.AsQueryable()"
                            ItemKey="@(x => x.Id)"
                           Pagination="_paginationState">
                    <PropertyColumn Title="First Name" 
                                    Property="@(x => x.FirstName)" 
                                    Sortable="true"/>
                    <PropertyColumn Title="Last Name" 
                                    Property="@(x => x.LastName)"
                                    Sortable="true" />
                    <PropertyColumn Title="Created At" 
                                    Property="@(x => x.CreatedAt)" 
                                    Format="dd MMM yyyy HH:mm" 
                                    Sortable="true" 
                                    IsDefaultSortColumn="true" 
                                    InitialSortDirection="SortDirection.Descending"/>
                    <TemplateColumn>
                        <ActionsDropdown>
                            <button class="btn w-100 text-start" @onclick="async () => await EditPatient(context.Id)">
                                <span class="fa-solid fa-pencil text-warning"></span>&nbsp; Edit
                            </button>
                            <button class="btn w-100 text-start" @onclick="async () => await DeletePatient(context.Id)">
                                <span class="fa-solid fa-trash-can text-danger"></span>&nbsp; Delete
                            </button>
                        </ActionsDropdown>
                    </TemplateColumn>
                </QuickGrid>
            </div>
            <div id="paginatorDiv" class="px-3">
                <Paginator State="_paginationState" />
            </div>
        </div>
    </div>
}