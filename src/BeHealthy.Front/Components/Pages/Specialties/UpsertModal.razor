@inherits ModalBase

@inject FluentValidation.IValidator<SpecialtyCreateRequest> CreateValidator
@inject FluentValidation.IValidator<SpecialtyUpdateRequest> UpdateValidator

<BeHealthyModal BodyClass="">
    <Header>
        <h5 class="modal-title">@Resource.Specialty</h5>
        <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
    </Header>

    <Body>
        <EditForm Model="specialtyDto" FormName="SpecialtyForm" OnValidSubmit="SaveSpecialty">
            <ValidationComponent @ref="validationComponent" />

            <BeHealthyFormGroup Label="@Resource.Name" IsRequired="true" InputId="name">
                <InputText id="name" class="form-control" @bind-Value="specialtyDto.Name" />
                <ValidationMessage For="@(() => specialtyDto.Name)" />
            </BeHealthyFormGroup>

            <div class="d-flex flex-row justify-content-end m-3 gap-2">
                <button type="button" class="btn btn-outline-secondary" @onclick="Close">@Resource.Cancel</button>
                <button type="submit" class="btn btn-success">@Resource.Save</button>
            </div>
        </EditForm>
    </Body>
</BeHealthyModal>

@code {
    [Parameter, EditorRequired]
    public SpecialtyResponse Specialty { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<SpecialtyResponse> OnSpecialtySaved { get; set; }

    [SupplyParameterFromForm]
    private SpecialtyResponse specialtyDto { get; set; } = new();

    private ValidationComponent? validationComponent;

    protected override async Task OnParametersSetAsync()
    {
        specialtyDto = Specialty;
    }

    private async Task SaveSpecialty()
    {
        validationComponent?.ClearErrors();

        // The form edits a SpecialtyResponse; validate the request that will actually be sent.
        var validationResult = specialtyDto.Id > 0
            ? await UpdateValidator.ValidateAsync(new SpecialtyUpdateRequest { Id = specialtyDto.Id, Name = specialtyDto.Name })
            : await CreateValidator.ValidateAsync(new SpecialtyCreateRequest { Name = specialtyDto.Name });

        if (!validationResult.IsValid)
        {
            validationComponent?.DisplayErrors(validationResult.GetErrorsGroupedByProperty());
            return;
        }

        await OnSpecialtySaved.InvokeAsync(specialtyDto);
        Close();
    }
}
