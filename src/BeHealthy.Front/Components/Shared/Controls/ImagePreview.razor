<div class="text-center mb-3">
    <img src="@ImageUrlOrPlaceholder"
         class="rounded-circle"
         style="width:@SizePx; height:@SizePx; object-fit:cover;" />
</div>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public int Size { get; set; } = 150;
    [Parameter] public string Placeholder { get; set; } = "images/generic.jpg";

    private string ImageUrlOrPlaceholder => ImageUrl ?? Placeholder;
    private string SizePx => $"{Size}px";
}
