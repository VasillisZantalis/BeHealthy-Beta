@implements IDisposable

@inject ToastService ToastService

<div class="toaster-container" style="position: fixed; top: 60px; right: 20px; z-index: 9999; min-width: 300px">
    @foreach (var toast in toasts)
    {
        <div class="alert alert-@toast.Type alert-dismissible fade show">
            <span class="fw-bold">@toast.Message</span>
        </div>
    }
</div>

@code {
    private const int ToastDurationMs = 3000;

    private readonly List<Toast> toasts = new();
    private readonly CancellationTokenSource disposalCts = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += AddToast;
    }

    public void Dispose()
    {
        ToastService.OnShow -= AddToast;
        disposalCts.Cancel();
    }

    private void AddToast(string message, string type)
    {
        var toast = new Toast(message, type);
        _ = InvokeAsync(async () =>
        {
            toasts.Add(toast);
            StateHasChanged();
            await RemoveAfterDelayAsync(toast);
        });
    }

    private async Task RemoveAfterDelayAsync(Toast toast)
    {
        try
        {
            await Task.Delay(ToastDurationMs, disposalCts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        toasts.Remove(toast);
        StateHasChanged();
    }

    private sealed class Toast(string message, string type)
    {
        public string Message { get; } = message;
        public string Type { get; } = type;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ToastService.FlushToastsAsync();
        }
    }
}
