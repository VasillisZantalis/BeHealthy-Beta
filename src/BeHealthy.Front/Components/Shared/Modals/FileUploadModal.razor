@inherits ModalBase
@inject IJSRuntime JS
@implements IAsyncDisposable

<BeHealthyModal>
    <Header>
        <h5 class="modal-title">@Title</h5>
    </Header>
    <Body>
        <div @ref="dropzoneElement" 
             class="dropzone @GetDropzoneClass()"
             @ondragenter="HandleDragEnter"
             @ondragleave="HandleDragLeave"
             @ondragover:preventDefault="true">
            
            @if (string.IsNullOrEmpty(previewUrl))
            {
                <div class="dropzone-content">
                    <i class="fas fa-cloud-upload-alt fa-3x mb-3 text-muted"></i>
                    <p class="mb-2">@DropzoneText</p>
                    <p class="text-muted small">or</p>
                    <label for="@instanceId" class="btn btn-primary btn-sm">
                        Browse Files
                    </label>
                    <InputFile @ref="fileInput"
                               id="@instanceId"
                               OnChange="HandleFileSelected"
                               accept="@AcceptedFormats"
                               class="d-none" />
                </div>
            }
            else
            {
                <div class="preview-container">
                    @if (IsImage)
                    {
                        <img src="@previewUrl" alt="Preview" class="preview-image" />
                    }
                    else
                    {
                        <div class="file-info">
                            <i class="fas fa-file fa-3x text-primary mb-2"></i>
                            <p class="mb-0">@fileName</p>
                            <p class="text-muted small">@fileSizeFormatted</p>
                        </div>
                    }
                    <button type="button" class="btn btn-danger btn-sm mt-3" @onclick="ClearFile">
                        <i class="fas fa-times"></i> Remove
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">
                    @errorMessage
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success mt-3" role="alert">
                @successMessage
            </div>
        }
    </Body>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="Close">
            @Resource.Cancel
        </button>
        <button type="button" 
                class="btn btn-success" 
                @onclick="ConfirmUpload" 
                disabled="@(string.IsNullOrEmpty(previewUrl))">
            <i class="fas fa-check"></i> @Resource.Save
        </button>
    </Footer>
</BeHealthyModal>

@code {
    [Parameter] public string Title { get; set; } = Resource.UploadFile;
    [Parameter] public string DropzoneText { get; set; } = Resource.DragAndDropFile;
    [Parameter] public bool IsImage { get; set; } = true;
    [Parameter] public int MaxFileSizeInKB { get; set; } = 1024;
    [Parameter] public string[] AllowedFormats { get; set; } = new[] { "image/jpeg", "image/png", "image/jpg" };
    [Parameter] public int? ResizeWidth { get; set; } = 200;
    [Parameter] public int? ResizeHeight { get; set; } = 200;
    [Parameter] public EventCallback<string> OnFileUploaded { get; set; }

    private bool isDragging = false;
    private string? previewUrl;
    private string? errorMessage;
    private string? successMessage;
    private string? fileName;
    private string? fileSizeFormatted;
    private string instanceId = Guid.NewGuid().ToString();
    private ElementReference dropzoneElement;
    private InputFile? fileInput;
    private IJSObjectReference? jsModule;

    private string AcceptedFormats => string.Join(",", AllowedFormats.Select(f => 
        f.StartsWith(".") ? f : $".{f.Split('/').Last()}"));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                jsModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./Components/Shared/Modals/FileUploadModal.razor.js");
                
                var dotNetRef = DotNetObjectReference.Create(this);
                await jsModule.InvokeVoidAsync("initializeDropzone", dropzoneElement, dotNetRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing dropzone: {ex.Message}");
            }
        }
    }

    private string GetDropzoneClass()
    {
        var classes = new List<string>();
        if (isDragging) classes.Add("dragging");
        if (!string.IsNullOrEmpty(previewUrl)) classes.Add("has-file");
        return string.Join(" ", classes);
    }

    private void HandleDragEnter()
    {
        isDragging = true;
    }

    private void HandleDragLeave()
    {
        isDragging = false;
    }

    [JSInvokable]
    public async Task HandleDroppedFile(string fileName, string contentType, long fileSize, string base64Data)
    {
        isDragging = false;
        errorMessage = null;
        successMessage = null;

        // Validate file size
        if (fileSize > MaxFileSizeInKB * 1024)
        {
            errorMessage = $"File size cannot exceed {MaxFileSizeInKB} KB.";
            StateHasChanged();
            return;
        }

        // Validate file type
        if (!AllowedFormats.Contains(contentType))
        {
            errorMessage = $"Only {string.Join(", ", AllowedFormats.Select(f => f.Split('/')[1]))} files are allowed.";
            StateHasChanged();
            return;
        }

        try
        {
            // For images, we can resize using JS Canvas API if needed, or just use as-is
            previewUrl = base64Data;
            fileName = fileName;
            fileSizeFormatted = FormatFileSize(fileSize);
            successMessage = "File loaded successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing file: {ex.Message}";
        }

        StateHasChanged();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        await ProcessFile(e.File);
    }

    private async Task ProcessFile(IBrowserFile file)
    {
        errorMessage = null;
        successMessage = null;

        // Validate file size
        if (file.Size > MaxFileSizeInKB * 1024)
        {
            errorMessage = $"File size cannot exceed {MaxFileSizeInKB} KB.";
            return;
        }

        // Validate file type
        if (!AllowedFormats.Contains(file.ContentType))
        {
            errorMessage = $"Only {string.Join(", ", AllowedFormats.Select(f => f.Split('/')[1]))} files are allowed.";
            return;
        }

        try
        {
            IBrowserFile processedFile = file;

            // Resize if it's an image and resize dimensions are specified
            if (IsImage && ResizeWidth.HasValue && ResizeHeight.HasValue)
            {
                processedFile = await file.RequestImageFileAsync(file.ContentType, ResizeWidth.Value, ResizeHeight.Value);
            }

            var buffer = new byte[processedFile.Size];
            await processedFile.OpenReadStream(MaxFileSizeInKB * 1024).ReadAsync(buffer);

            previewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            fileName = file.Name;
            fileSizeFormatted = FormatFileSize(file.Size);
            successMessage = "File loaded successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing file: {ex.Message}";
        }

        StateHasChanged();
    }

    private void ClearFile()
    {
        previewUrl = null;
        fileName = null;
        fileSizeFormatted = null;
        errorMessage = null;
        successMessage = null;
    }

    private async Task ConfirmUpload()
    {
        if (!string.IsNullOrEmpty(previewUrl))
        {
            await OnFileUploaded.InvokeAsync(previewUrl);
            Close();
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModule is not null)
        {
            await jsModule.DisposeAsync();
        }
    }
}